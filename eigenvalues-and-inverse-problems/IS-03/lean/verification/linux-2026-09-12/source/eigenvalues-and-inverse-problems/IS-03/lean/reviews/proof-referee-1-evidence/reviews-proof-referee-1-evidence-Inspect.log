theorem NLA.IS03.root_product_and_trace : ∀ (B : NLA.IS03.RealMatrix 6),
  Matrix.charpoly B = NLA.IS03.derivativePolynomial →
    ∏ r, (Polynomial.X - Polynomial.C ↑r) = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial ∧
      ∀ (k : ℕ), ↑(Matrix.trace (B ^ k)) = ∑ r, ↑r ^ k :=
fun B hB =>
  Exists.casesOn (NLA.IS03.exists_root_eigenbasis B hB) fun b hb =>
    let M := Matrix.map B ⇑(algebraMap ℝ ℂ);
    let f := Matrix.toLin' M;
    have hdiag := fun k =>
      Matrix.ext fun i j =>
        Eq.mpr
          (id
            (congrArg (fun _a => _a = Matrix.diagonal (fun r => ↑r ^ k) i j)
              (LinearMap.toMatrix_apply b b (f ^ k) i j)))
          (Eq.mpr
            (id
              (congrArg (fun _a => (b.repr _a) i = Matrix.diagonal (fun r => ↑r ^ k) i j)
                (Module.End.HasEigenvector.pow_apply (hb j) k)))
            (if h : i = j then
              h ▸
                of_eq_true
                  (Eq.trans
                    (congr
                      (congrArg Eq
                        (Eq.trans
                          (congrFun'
                            (congrArg DFunLike.coe
                              (Eq.trans (map_smul b.repr (↑i ^ k) (b i))
                                (Eq.trans
                                  (Eq.trans (congrArg (HSMul.hSMul (↑i ^ k)) (Module.Basis.repr_self b i))
                                    (Finsupp.smul_single (↑i ^ k) i 1))
                                  (congrArg (Finsupp.single i) (mul_one (↑i ^ k))))))
                            i)
                          Finsupp.single_eq_same))
                      (Matrix.diagonal_apply_eq (fun r => ↑r ^ k) i))
                    (eq_self (↑i ^ k)))
            else
              of_eq_true
                (Eq.trans
                  (congr
                    (congrArg Eq
                      (Eq.trans
                        (congrFun'
                          (congrArg DFunLike.coe
                            (Eq.trans (map_smul b.repr (↑j ^ k) (b j))
                              (Eq.trans
                                (Eq.trans (congrArg (HSMul.hSMul (↑j ^ k)) (Module.Basis.repr_self b j))
                                  (Finsupp.smul_single (↑j ^ k) j 1))
                                (congrArg (Finsupp.single j) (mul_one (↑j ^ k))))))
                          i)
                        (Finsupp.single_eq_of_ne
                          (of_eq_true (Eq.trans (congrArg Not (eq_false h)) not_false_eq_true)))))
                    (Matrix.diagonal_apply_ne (fun r => ↑r ^ k)
                      (of_eq_true (Eq.trans (congrArg Not (eq_false h)) not_false_eq_true))))
                  (eq_self 0))));
    ⟨Trans.trans
        (Trans.trans
          (Trans.trans (Eq.symm (Matrix.charpoly_diagonal Subtype.val))
            (Eq.mpr (id (congrArg (Eq (Matrix.diagonal fun r => ↑r).charpoly) (LinearMap.charpoly_toMatrix f b)))
              (Eq.mp
                (congr
                  (congrArg Eq
                    (Matrix.charpoly.congr_simp (Matrix.diagonal fun r => ↑r ^ 1) (Matrix.diagonal fun r => ↑r)
                      (congrArg Matrix.diagonal (funext fun r => pow_one ↑r))))
                  (Eq.trans
                    (Matrix.charpoly.congr_simp ((LinearMap.toMatrix b b) (f ^ 1)) ((LinearMap.toMatrix b b) f)
                      (congrArg (⇑(LinearMap.toMatrix b b)) (pow_one f)))
                    (LinearMap.charpoly_toMatrix f b)))
                (congrArg Matrix.charpoly (Eq.symm (hdiag 1))))))
          (LinearMap.charpoly_toMatrix f b))
        (id
          (Eq.mpr
            (id
              (congrArg (fun _a => _a = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
                (Matrix.charpoly_toLin' (Matrix.map B ⇑(algebraMap ℝ ℂ)))))
            (Eq.mpr
              (id
                (congrArg (fun _a => _a = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
                  (Matrix.charpoly_map B (algebraMap ℝ ℂ))))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      Polynomial.map (algebraMap ℝ ℂ) _a =
                        Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
                    hB))
                (Eq.refl (Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)))))),
      fun k =>
      Trans.trans
        (Trans.trans
          (Trans.trans
            (id
              (Eq.mpr (id (congrArg (fun _a => _a = (M ^ k).trace) (AddMonoidHom.map_trace (algebraMap ℝ ℂ) (B ^ k))))
                (Eq.mpr (id (congrArg (fun _a => _a.trace = (M ^ k).trace) (Matrix.map_pow B (algebraMap ℝ ℂ) k)))
                  (Eq.refl (Matrix.map B ⇑(algebraMap ℝ ℂ) ^ k).trace))))
            (Eq.mpr
              (id
                (congrArg (fun _a => (M ^ k).trace = (LinearMap.trace ℂ (Fin 6 → ℂ)) _a)
                  (Eq.symm (Matrix.toLin'_pow M k))))
              (Eq.mpr (id (congrArg (fun _a => (M ^ k).trace = _a) (Matrix.trace_toLin'_eq (M ^ k))))
                (Eq.refl (M ^ k).trace))))
          (LinearMap.trace_eq_matrix_trace ℂ b (f ^ k)))
        (Eq.mpr (id (congrArg (fun _a => _a.trace = ∑ r, ↑r ^ k) (hdiag k)))
          (Eq.mpr (id (congrArg (fun _a => _a = ∑ r, ↑r ^ k) (Matrix.trace_diagonal fun r => ↑r ^ k)))
            (Eq.refl (∑ i, ↑i ^ k))))⟩
theorem NLA.IS03.powerMoments_newton.{u_1} : ∀ {ι : Type u_1} [inst : Fintype ι] (μ : ι → ℂ) (k : ℕ),
  0 < k →
    NLA.IS03.powerMoments μ k =
      (-1) ^ (k + 1) * ↑k * NLA.IS03.elementaryMoments μ k -
        ∑ a ∈ Finset.antidiagonal k with a.1 ∈ Set.Ioo 0 k,
          (-1) ^ a.1 * NLA.IS03.elementaryMoments μ a.1 * NLA.IS03.powerMoments μ a.2 :=
fun {ι} [Fintype ι] μ k hk =>
  have h := congrArg (⇑(MvPolynomial.aeval μ)) (MvPolynomial.psum_eq_mul_esymm_sub_sum ι ℂ k hk);
  id
    (Eq.mp
      (congr
        (congrArg Eq
          (Eq.trans (map_sum (MvPolynomial.aeval μ) (fun x => MvPolynomial.X x ^ k) Finset.univ)
            (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
              Eq.trans (map_pow (MvPolynomial.aeval μ) (MvPolynomial.X x) k)
                (congrFun' (congrArg HPow.hPow (MvPolynomial.aeval_X μ x)) k))))
        (Eq.trans
          (map_sub (MvPolynomial.aeval μ) ((-1) ^ (k + 1) * ↑k * MvPolynomial.esymm ι ℂ k)
            (∑ a ∈ Finset.antidiagonal k with a.1 ∈ Set.Ioo 0 k,
              (-1) ^ a.1 * MvPolynomial.esymm ι ℂ a.1 * ∑ i, MvPolynomial.X i ^ a.2))
          (congr
            (congrArg HSub.hSub
              (Eq.trans (map_mul (MvPolynomial.aeval μ) ((-1) ^ (k + 1) * ↑k) (MvPolynomial.esymm ι ℂ k))
                (congrFun'
                  (congrArg HMul.hMul
                    (Eq.trans (map_mul (MvPolynomial.aeval μ) ((-1) ^ (k + 1)) ↑k)
                      (congr
                        (congrArg HMul.hMul
                          (Eq.trans (map_pow (MvPolynomial.aeval μ) (-1) (k + 1))
                            (congrFun'
                              (congrArg HPow.hPow
                                (Eq.trans (map_neg (MvPolynomial.aeval μ) 1)
                                  (congrArg Neg.neg (map_one (MvPolynomial.aeval μ)))))
                              (k + 1))))
                        (map_natCast (MvPolynomial.aeval μ) k))))
                  ((MvPolynomial.aeval μ) (MvPolynomial.esymm ι ℂ k)))))
            (Eq.trans
              (map_sum (MvPolynomial.aeval μ)
                (fun x => (-1) ^ x.1 * MvPolynomial.esymm ι ℂ x.1 * ∑ i, MvPolynomial.X i ^ x.2)
                ({a ∈ Finset.antidiagonal k | a.1 ∈ Set.Ioo 0 k}))
              (Finset.sum_congr (Eq.refl ({a ∈ Finset.antidiagonal k | a.1 ∈ Set.Ioo 0 k})) fun x a =>
                Eq.trans
                  (map_mul (MvPolynomial.aeval μ) ((-1) ^ x.1 * MvPolynomial.esymm ι ℂ x.1)
                    (∑ i, MvPolynomial.X i ^ x.2))
                  (congr
                    (congrArg HMul.hMul
                      (Eq.trans (map_mul (MvPolynomial.aeval μ) ((-1) ^ x.1) (MvPolynomial.esymm ι ℂ x.1))
                        (congrFun'
                          (congrArg HMul.hMul
                            (Eq.trans (map_pow (MvPolynomial.aeval μ) (-1) x.1)
                              (congrFun'
                                (congrArg HPow.hPow
                                  (Eq.trans (map_neg (MvPolynomial.aeval μ) 1)
                                    (congrArg Neg.neg (map_one (MvPolynomial.aeval μ)))))
                                x.1)))
                          ((MvPolynomial.aeval μ) (MvPolynomial.esymm ι ℂ x.1)))))
                    (Eq.trans (map_sum (MvPolynomial.aeval μ) (fun x_1 => MvPolynomial.X x_1 ^ x.2) Finset.univ)
                      (Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a =>
                        Eq.trans (map_pow (MvPolynomial.aeval μ) (MvPolynomial.X x_1) x.2)
                          (congrFun' (congrArg HPow.hPow (MvPolynomial.aeval_X μ x_1)) x.2)))))))))
      h)
