theorem NLA.IS03.trace_moment_certificate_proved : ∀ (B : NLA.IS03.RealMatrix 6),
  Matrix.charpoly B = NLA.IS03.derivativePolynomial →
    ∀ (i : Fin 7), Matrix.trace (B ^ (↑i + 1)) = NLA.IS03.traceMoments i :=
fun B hB =>
  And.casesOn (motive := fun x => ∀ (i : Fin 7), Matrix.trace (B ^ (↑i + 1)) = NLA.IS03.traceMoments i)
    (NLA.IS03.root_product_and_trace B hB) fun hprod htrace =>
    have hs := NLA.IS03.power_sums_of_derivative_product (fun r => ↑r) NLA.IS03.complexRoots_card hprod;
    fun i => Complex.ofReal_injective (Eq.trans (htrace (↑i + 1)) (hs i))
theorem NLA.IS03.counterexample_proved : NLA.IS03.EntrywiseNonnegative NLA.IS03.witnessMatrix ∧
  ∀ (B : NLA.IS03.RealMatrix 6),
    NLA.IS03.EntrywiseNonnegative B →
      Matrix.charpoly B ≠ NLA.IS03.normalizedDerivative 7 (Matrix.charpoly NLA.IS03.witnessMatrix) :=
⟨NLA.IS03.witness_admissible_proved.left, fun B hB heq =>
  have hchar := Eq.trans heq NLA.IS03.witness_polynomials_proved.right.left;
  have htrace := NLA.IS03.trace_moment_certificate_proved B hchar 6;
  have hnonnegative := htrace ▸ (NLA.IS03.nonnegative_power_trace_proved B hB 7).right;
  not_lt_of_ge hnonnegative NLA.IS03.negative_moment_proved.right⟩
theorem NLA.IS03.not_derivativeRealizabilityConjecture_proved : ¬NLA.IS03.DerivativeRealizabilityConjecture :=
fun h =>
  Exists.casesOn
    (h 7 (of_decide_eq_true (id (Eq.refl true))) NLA.IS03.witnessMatrix NLA.IS03.witness_admissible_proved.left)
    fun B h => And.casesOn h fun hB heq => NLA.IS03.counterexample_proved.right B hB heq
