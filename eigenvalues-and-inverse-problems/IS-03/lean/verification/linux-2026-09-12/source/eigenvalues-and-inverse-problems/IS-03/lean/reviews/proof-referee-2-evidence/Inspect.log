theorem NLA.IS03.exists_root_eigenbasis : ∀ (B : NLA.IS03.RealMatrix 6),
  Matrix.charpoly B = NLA.IS03.derivativePolynomial →
    ∃ b,
      ∀ (r : ↑NLA.IS03.ComplexRoots),
        Module.End.HasEigenvector (Matrix.toLin' (Matrix.map B ⇑(algebraMap ℝ ℂ))) (↑r) (b r) :=
fun B hB =>
  let f := Matrix.toLin' (Matrix.map B ⇑(algebraMap ℝ ℂ));
  have hchar :=
    id
      (Eq.mpr
        (id
          (congrArg (fun _a => _a = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
            (Matrix.charpoly_toLin' (Matrix.map B ⇑(algebraMap ℝ ℂ)))))
        (Eq.mpr
          (id
            (congrArg (fun _a => _a = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
              (Matrix.charpoly_map B (algebraMap ℝ ℂ))))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  Polynomial.map (algebraMap ℝ ℂ) _a = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
                hB))
            (Eq.refl (Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)))));
  have he := fun r =>
    Eq.mpr (id (congrArg (fun _a => _a) (propext (Module.End.hasEigenvalue_iff_isRoot_charpoly f ↑r))))
      (Eq.mpr (id (congrArg (fun _a => _a.IsRoot ↑r) hchar))
        (Eq.mpr (id (congrArg (fun _a => _a) (propext Polynomial.IsRoot.def)))
          (Eq.mpr (id (congrArg (fun _a => _a = 0) (Polynomial.eval_map_algebraMap NLA.IS03.derivativePolynomial ↑r)))
            (Polynomial.aeval_eq_zero_of_mem_rootSet r.property))));
  (fun v hv =>
      have hlin := Module.End.eigenvectors_linearIndependent' f (fun r => ↑r) Subtype.coe_injective v hv;
      have hcard :=
        Eq.mpr
          (id (congrArg (fun _a => Fintype.card ↑NLA.IS03.ComplexRoots = _a) (Module.finrank_fintype_fun_eq_card ℂ)))
          (Eq.mpr (id (congrArg (fun _a => Fintype.card ↑NLA.IS03.ComplexRoots = _a) (Fintype.card_fin 6)))
            NLA.IS03.complexRoots_card);
      let b := basisOfLinearIndependentOfCardEqFinrank' v hlin hcard;
      Exists.intro b fun r =>
        id
          (Eq.mpr
            (id
              (congrArg (f.HasEigenvector ↑r) (congrFun (coe_basisOfLinearIndependentOfCardEqFinrank' v hlin hcard) r)))
            (hv r)))
    (fun r => Classical.choose ((fun r => Module.End.HasEigenvalue.exists_hasEigenvector (he r)) r)) fun r =>
    Classical.choose_spec ((fun r => Module.End.HasEigenvalue.exists_hasEigenvector (he r)) r)
theorem NLA.IS03.root_product_and_trace : ∀ (B : NLA.IS03.RealMatrix 6),
  Matrix.charpoly B = NLA.IS03.derivativePolynomial →
    ∏ r, (Polynomial.X - Polynomial.C ↑r) = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial ∧
      ∀ (k : ℕ), ↑(Matrix.trace (B ^ k)) = ∑ r, ↑r ^ k :=
fun B hB =>
  Exists.casesOn (NLA.IS03.exists_root_eigenbasis B hB) fun b hb =>
    let M := Matrix.map B ⇑(algebraMap ℝ ℂ);
    let f := Matrix.toLin' M;
    have hdiag := fun k =>
      Matrix.ext fun i j =>
        Eq.mpr
          (id
            (congrArg (fun _a => _a = Matrix.diagonal (fun r => ↑r ^ k) i j)
              (LinearMap.toMatrix_apply b b (f ^ k) i j)))
          (Eq.mpr
            (id
              (congrArg (fun _a => (b.repr _a) i = Matrix.diagonal (fun r => ↑r ^ k) i j)
                (Module.End.HasEigenvector.pow_apply (hb j) k)))
            (if h : i = j then
              h ▸
                of_eq_true
                  (Eq.trans
                    (congr
                      (congrArg Eq
                        (Eq.trans
                          (congrFun'
                            (congrArg DFunLike.coe
                              (Eq.trans (map_smul b.repr (↑i ^ k) (b i))
                                (Eq.trans
                                  (Eq.trans (congrArg (HSMul.hSMul (↑i ^ k)) (Module.Basis.repr_self b i))
                                    (Finsupp.smul_single (↑i ^ k) i 1))
                                  (congrArg (Finsupp.single i) (mul_one (↑i ^ k))))))
                            i)
                          Finsupp.single_eq_same))
                      (Matrix.diagonal_apply_eq (fun r => ↑r ^ k) i))
                    (eq_self (↑i ^ k)))
            else
              of_eq_true
                (Eq.trans
                  (congr
                    (congrArg Eq
                      (Eq.trans
                        (congrFun'
                          (congrArg DFunLike.coe
                            (Eq.trans (map_smul b.repr (↑j ^ k) (b j))
                              (Eq.trans
                                (Eq.trans (congrArg (HSMul.hSMul (↑j ^ k)) (Module.Basis.repr_self b j))
                                  (Finsupp.smul_single (↑j ^ k) j 1))
                                (congrArg (Finsupp.single j) (mul_one (↑j ^ k))))))
                          i)
                        (Finsupp.single_eq_of_ne
                          (of_eq_true (Eq.trans (congrArg Not (eq_false h)) not_false_eq_true)))))
                    (Matrix.diagonal_apply_ne (fun r => ↑r ^ k)
                      (of_eq_true (Eq.trans (congrArg Not (eq_false h)) not_false_eq_true))))
                  (eq_self 0))));
    ⟨Trans.trans
        (Trans.trans
          (Trans.trans (Eq.symm (Matrix.charpoly_diagonal Subtype.val))
            (Eq.mpr (id (congrArg (Eq (Matrix.diagonal fun r => ↑r).charpoly) (LinearMap.charpoly_toMatrix f b)))
              (Eq.mp
                (congr
                  (congrArg Eq
                    (Matrix.charpoly.congr_simp (Matrix.diagonal fun r => ↑r ^ 1) (Matrix.diagonal fun r => ↑r)
                      (congrArg Matrix.diagonal (funext fun r => pow_one ↑r))))
                  (Eq.trans
                    (Matrix.charpoly.congr_simp ((LinearMap.toMatrix b b) (f ^ 1)) ((LinearMap.toMatrix b b) f)
                      (congrArg (⇑(LinearMap.toMatrix b b)) (pow_one f)))
                    (LinearMap.charpoly_toMatrix f b)))
                (congrArg Matrix.charpoly (Eq.symm (hdiag 1))))))
          (LinearMap.charpoly_toMatrix f b))
        (id
          (Eq.mpr
            (id
              (congrArg (fun _a => _a = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
                (Matrix.charpoly_toLin' (Matrix.map B ⇑(algebraMap ℝ ℂ)))))
            (Eq.mpr
              (id
                (congrArg (fun _a => _a = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
                  (Matrix.charpoly_map B (algebraMap ℝ ℂ))))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      Polynomial.map (algebraMap ℝ ℂ) _a =
                        Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)
                    hB))
                (Eq.refl (Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial)))))),
      fun k =>
      Trans.trans
        (Trans.trans
          (Trans.trans
            (id
              (Eq.mpr (id (congrArg (fun _a => _a = (M ^ k).trace) (AddMonoidHom.map_trace (algebraMap ℝ ℂ) (B ^ k))))
                (Eq.mpr (id (congrArg (fun _a => _a.trace = (M ^ k).trace) (Matrix.map_pow B (algebraMap ℝ ℂ) k)))
                  (Eq.refl (Matrix.map B ⇑(algebraMap ℝ ℂ) ^ k).trace))))
            (Eq.mpr
              (id
                (congrArg (fun _a => (M ^ k).trace = (LinearMap.trace ℂ (Fin 6 → ℂ)) _a)
                  (Eq.symm (Matrix.toLin'_pow M k))))
              (Eq.mpr (id (congrArg (fun _a => (M ^ k).trace = _a) (Matrix.trace_toLin'_eq (M ^ k))))
                (Eq.refl (M ^ k).trace))))
          (LinearMap.trace_eq_matrix_trace ℂ b (f ^ k)))
        (Eq.mpr (id (congrArg (fun _a => _a.trace = ∑ r, ↑r ^ k) (hdiag k)))
          (Eq.mpr (id (congrArg (fun _a => _a = ∑ r, ↑r ^ k) (Matrix.trace_diagonal fun r => ↑r ^ k)))
            (Eq.refl (∑ i, ↑i ^ k))))⟩
