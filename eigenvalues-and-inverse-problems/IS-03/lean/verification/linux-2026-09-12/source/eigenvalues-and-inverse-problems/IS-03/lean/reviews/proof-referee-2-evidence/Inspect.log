NLA.IS03.exists_root_eigenbasis : ∀ (B : NLA.IS03.RealMatrix 6),
  Matrix.charpoly B = NLA.IS03.derivativePolynomial →
    ∃ b,
      ∀ (r : ↑NLA.IS03.ComplexRoots),
        Module.End.HasEigenvector (Matrix.toLin' (Matrix.map B ⇑(algebraMap ℝ ℂ))) (↑r) (b r)
NLA.IS03.root_product_and_trace : ∀ (B : NLA.IS03.RealMatrix 6),
  Matrix.charpoly B = NLA.IS03.derivativePolynomial →
    ∏ r, (Polynomial.X - Polynomial.C ↑r) = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial ∧
      ∀ (k : ℕ), ↑(Matrix.trace (B ^ k)) = ∑ r, ↑r ^ k
@NLA.IS03.power_sums_of_derivative_product : ∀ {ι : Type u_1} [inst : Fintype ι] (μ : ι → ℂ),
  Fintype.card ι = 6 →
    ∏ i, (Polynomial.X - Polynomial.C (μ i)) = Polynomial.map (algebraMap ℝ ℂ) NLA.IS03.derivativePolynomial →
      ∀ (k : Fin 7), ∑ i, μ i ^ (↑k + 1) = ↑(NLA.IS03.traceMoments k)
NLA.IS03.trace_moment_certificate : ∀ (B : NLA.IS03.RealMatrix 6),
  Matrix.charpoly B = NLA.IS03.derivativePolynomial →
    ∀ (i : Fin 7), Matrix.trace (B ^ (↑i + 1)) = NLA.IS03.traceMoments i
@Polynomial.card_rootSet_eq_natDegree : ∀ {F : Type u_1} [inst : Field F] {K : Type u_2} [inst_1 : Field K]
  [inst_2 : Algebra F K] {p : Polynomial F},
  p.Separable → (Polynomial.map (algebraMap F K) p).Splits → Fintype.card ↑(p.rootSet K) = p.natDegree
@Module.End.eigenvectors_linearIndependent' : ∀ {R : Type u_1} {M : Type u_2} [inst : CommRing R]
  [inst_1 : AddCommGroup M] [inst_2 : Module R M] {ι : Type u_3} [IsDomain R] [Module.IsTorsionFree R M]
  (f : Module.End R M) (μ : ι → R),
  Function.Injective μ → ∀ (v : ι → M), (∀ (i : ι), f.HasEigenvector (μ i) (v i)) → LinearIndependent R v
@basisOfLinearIndependentOfCardEqFinrank' : {K : Type u_1} →
  {V : Type u_2} →
    [inst : DivisionRing K] →
      [inst_1 : AddCommGroup V] →
        [inst_2 : Module K V] →
          {ι : Type u_3} →
            [inst_3 : Fintype ι] →
              [FiniteDimensional K V] →
                (b : ι → V) → LinearIndependent K b → Fintype.card ι = Module.finrank K V → Module.Basis ι K V
@Module.End.HasEigenvector.pow_apply : ∀ {R : Type u_1} {M : Type u_2} [inst : CommRing R] [inst_1 : AddCommGroup M]
  [inst_2 : Module R M] {f : Module.End R M} {μ : R} {v : M}, f.HasEigenvector μ v → ∀ (n : ℕ), (f ^ n) v = μ ^ n • v
@Matrix.toLin'_pow : ∀ {R : Type u_1} [inst : CommSemiring R] {n : Type u_2} [inst_1 : DecidableEq n]
  [inst_2 : Fintype n] (M : Matrix n n R) (k : ℕ), Matrix.toLin' (M ^ k) = Matrix.toLin' M ^ k
@Matrix.map_pow : ∀ {m : Type u_1} [inst : Fintype m] [inst_1 : DecidableEq m] {α : Type u_2} {β : Type u_3}
  [inst_2 : Semiring α] [inst_3 : Semiring β] (M : Matrix m m α) (f : α →+* β) (a : ℕ), (M ^ a).map ⇑f = M.map ⇑f ^ a
LinearMap.trace_eq_matrix_trace : ∀ (R : Type u_1) [inst : CommSemiring R] {M : Type u_2} [inst_1 : AddCommMonoid M]
  [inst_2 : Module R M] {ι : Type u_3} [inst_3 : DecidableEq ι] [inst_4 : Fintype ι] (b : Module.Basis ι R M)
  (f : M →ₗ[R] M), (LinearMap.trace R M) f = ((LinearMap.toMatrix b b) f).trace
@Multiset.prod_X_sub_C_coeff : ∀ {R : Type u_1} [inst : CommRing R] (s : Multiset R) {k : ℕ},
  k ≤ s.card →
    (Multiset.map (fun t => Polynomial.X - Polynomial.C t) s).prod.coeff k = (-1) ^ (s.card - k) * s.esymm (s.card - k)
