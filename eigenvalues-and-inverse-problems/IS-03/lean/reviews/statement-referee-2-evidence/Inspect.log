NLA.IS03.witness_admissible :
  NLA.IS03.EntrywiseNonnegative NLA.IS03.witnessMatrix ∧ Matrix.trace NLA.IS03.witnessMatrix = 1 / 2
NLA.IS03.witness_polynomials :
  Matrix.charpoly NLA.IS03.witnessMatrix = NLA.IS03.witnessPolynomial ∧
    NLA.IS03.normalizedDerivative 7 (Matrix.charpoly NLA.IS03.witnessMatrix) = NLA.IS03.derivativePolynomial ∧
      NLA.IS03.derivativePolynomial.Monic ∧ NLA.IS03.derivativePolynomial.natDegree = 6
