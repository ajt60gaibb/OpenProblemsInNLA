        Polynomial.C (2 / 7) * Polynomial.X ^ 3 -
      Polynomial.C (3 / 7) * Polynomial.X ^ 2 +
    Polynomial.C (1 / 7) * Polynomial.X +
  Polynomial.C (1 / 7)
