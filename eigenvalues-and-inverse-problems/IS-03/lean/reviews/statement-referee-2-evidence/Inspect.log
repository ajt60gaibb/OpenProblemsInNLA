@[reducible] def NLA.IS03.RealMatrix : ℕ → Type :=
fun n => Matrix (Fin n) (Fin n) ℝ
def NLA.IS03.EntrywiseNonnegative : {n : ℕ} → NLA.IS03.RealMatrix n → Prop :=
fun {n} A => ∀ (i j : Fin n), 0 ≤ A i j
def NLA.IS03.normalizedDerivative : ℕ → Polynomial ℝ → Polynomial ℝ :=
fun n p => (↑n)⁻¹ • Polynomial.derivative p
def NLA.IS03.DerivativeRealizabilityConjecture : Prop :=
∀ (n : ℕ),
  5 ≤ n →
    ∀ (A : NLA.IS03.RealMatrix n),
      NLA.IS03.EntrywiseNonnegative A →
        ∃ B, NLA.IS03.EntrywiseNonnegative B ∧ Matrix.charpoly B = NLA.IS03.normalizedDerivative n (Matrix.charpoly A)
