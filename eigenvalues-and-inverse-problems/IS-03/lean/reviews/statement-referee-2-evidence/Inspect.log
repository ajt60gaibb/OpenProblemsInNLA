Matrix.pow_eq_aeval_mod_charpoly.{u, v} {R : Type u} [CommRing R] {n : Type v} [DecidableEq n] [Fintype n]
  (M : Matrix n n R) (k : ℕ) : M ^ k = (Polynomial.aeval M) (Polynomial.X ^ k %ₘ M.charpoly)
MvPolynomial.psum_eq_mul_esymm_sub_sum.{u_1, u_2} (σ : Type u_1) [Fintype σ] (R : Type u_2) [CommRing R] (k : ℕ)
  (h : 0 < k) :
  MvPolynomial.psum σ R k =
    (-1) ^ (k + 1) * ↑k * MvPolynomial.esymm σ R k -
      ∑ a ∈ Finset.antidiagonal k with a.1 ∈ Set.Ioo 0 k,
        (-1) ^ a.1 * MvPolynomial.esymm σ R a.1 * MvPolynomial.psum σ R a.2
MvPolynomial.aeval_esymm_eq_multiset_esymm.{u_4, u_5, u_6} {S : Type u_4} (σ : Type u_5) (R : Type u_6) [CommSemiring R]
  [CommSemiring S] [Fintype σ] [Algebra R S] (n : ℕ) (f : σ → S) :
  (MvPolynomial.aeval f) (MvPolynomial.esymm σ R n) = (Multiset.map f Finset.univ.val).esymm n
Polynomial.coeff_derivative.{u} {R : Type u} [Semiring R] (p : Polynomial R) (n : ℕ) :
  (Polynomial.derivative p).coeff n = p.coeff (n + 1) * (↑n + 1)
