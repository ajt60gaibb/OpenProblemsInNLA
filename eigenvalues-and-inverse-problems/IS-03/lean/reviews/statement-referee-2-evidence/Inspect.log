  M.charpoly.Monic
Matrix.trace_eq_neg_charpoly_coeff.{u, v} {R : Type u} [CommRing R] {n : Type v} [DecidableEq n] [Fintype n]
  [Nonempty n] (M : Matrix n n R) : M.trace = -M.charpoly.coeff (Fintype.card n - 1)
