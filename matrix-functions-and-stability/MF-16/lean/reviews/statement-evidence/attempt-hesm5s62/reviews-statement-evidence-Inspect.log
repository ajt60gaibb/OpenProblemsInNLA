def NLA.MF16.WordUniquenessConjecture : Prop :=
∀ (w : List Letter),
  SymmetricWord w →
    ∀ (B P : ComplexMatrix), Matrix.PosDef B → Matrix.PosDef P → ∃! X, Matrix.PosDef X ∧ evalWord w X B = P
def NLA.MF16.SymmetricWord : List Letter → Prop :=
fun w => w = w.reverse ∧ Letter.X ∈ w
def NLA.MF16.evalWord.{u_1} : {R : Type u_1} →
  [Semiring R] → List Letter → Matrix (Fin 2) (Fin 2) R → Matrix (Fin 2) (Fin 2) R → Matrix (Fin 2) (Fin 2) R :=
fun {R} [Semiring R] w X B =>
  (List.map
      (fun letter =>
        match letter with
        | Letter.X => X
        | Letter.B => B)
      w).prod
def NLA.MF16.symmetricMatrix : (Fin 3 → ℝ) → RealMatrix :=
fun v => !![v 0, v 1; v 1, v 2]
def NLA.MF16.complexify : RealMatrix → ComplexMatrix :=
fun A => Matrix.map A Complex.ofReal
def Matrix.PosDef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} → [inst : Ring R] → [PartialOrder R] → [StarRing R] → Matrix n n R → Prop :=
fun {n} {R} [Ring R] [PartialOrder R] [StarRing R] M =>
  M.IsHermitian ∧ ∀ ⦃x : n →₀ R⦄, x ≠ 0 → 0 < x.sum fun i xi => x.sum fun j xj => star xi * M i j * xj
def NLA.MF16.linearCoefficient : ℝ → ℝ :=
fun s =>
  have t := s * s;
  s * (t * (t * (t * (t * (t - 30) + 324) - 1512) + 2835) - 1458)
def NLA.MF16.identityCoefficient : ℝ → ℝ :=
fun s =>
  have t := s * s;
  3 * (t * (t * (t * (t * (t - 27) + 252) - 945) + 1215) - 243)
def NLA.MF16.polynomialSystem : Fin 3 → Expr :=
have x := Expr.var 0;
have y := Expr.var 1;
have z := Expr.var 2;
have s := x.add z;
have u := linearCoefficientExpr s;
have v := identityCoefficientExpr s;
have a := x.add (exprScale 4 y);
have b := (exprScale 4 x).add (exprScale 17 y);
have c := y.add (exprScale 4 z);
have d := (exprScale 4 y).add (exprScale 17 z);
have aa := a.mul a;
have bb := b.mul b;
have ac := a.mul c;
have bd := b.mul d;
have cubic11 := ((x.mul aa).add (exprScale 2 (y.mul (a.mul b)))).add (z.mul bb);
have cubic12 := ((x.mul ac).add (y.mul ((a.mul d).add (b.mul c)))).add (z.mul bd);
![exprSub (exprSub (x.mul z) (y.mul y)) (Expr.const 3),
  exprSub (exprSub (u.mul cubic11) (v.mul (aa.add bb))) (Expr.const 4783113),
  exprSub (exprSub (u.mul cubic12) (v.mul (ac.add bd))) (Expr.const 6377496)]
