![17471725533 / 5000000000, -51638297 / 156250000, 2224465749 / 2500000000]
def NLA.MF16.rootBox : Fin 3 → IntervalRat :=
![{ lo := 17471725033 / 5000000000, hi := 17471726033 / 5000000000, le := rootBox._proof_1 },
  { lo := -413106501 / 1250000000, hi := -413106251 / 1250000000, le := rootBox._proof_2 },
  { lo := 2224465499 / 2500000000, hi := 2224465999 / 2500000000, le := rootBox._proof_3 }]
def NLA.MF16.rootCertificate : KrawczykCert 3 :=
{ center := rootCenter,
  preconditioner :=
    !![17591641083 / 500000000, 20183 / 10000000000, -17029 / 10000000000;
      -11575092327 / 500000000, -2477 / 2000000000, 10667 / 10000000000;
      -21469001731 / 5000000000, -2797 / 10000000000, 2319 / 10000000000] }
def LeanCert.Engine.krawczykCheck : {n : ℕ} →
  (Fin n → Expr) → (Fin n → IntervalRat) → KrawczykCert n → optParam EvalConfig { } → Bool :=
fun {n} F X cert cfg =>
  decide (∀ (i : Fin n), (F i).checkADSupported = true) && decide (centerInside X cert.center) &&
        decide (cert.preconditioner.det ≠ 0) &&
      decide (intervalMatrixBound (preconditionedJacobian cert.preconditioner (intervalJacobian F X cfg)) < 1) &&
    decide
      (∀ (i : Fin n),
        intervalStrictInside (newtonImageEnclosure F X cert.center cert.preconditioner cfg i) (X i) = true)
LeanCert.Engine.krawczykCheck_sound {n : ℕ} (F : Fin n → Expr) (X : Fin n → IntervalRat) (cert : KrawczykCert n)
  (cfg : EvalConfig) (hcheck : krawczykCheck F X cert cfg = true) : ∃! x, FinBoxMem x X ∧ SystemZero F x
LeanCert.Engine.jacobianAt_mem_intervalJacobian {n : ℕ} (F : Fin n → Expr) (h : ∀ (i : Fin n), ADSupported (F i))
  (X : Fin n → IntervalRat) (x : Fin n → ℝ) (hx : FinBoxMem x X) (cfg : EvalConfig) (i j : Fin n) :
  jacobianAt F x i j ∈ intervalJacobian F X cfg i j
