NLA.MF16.word_semantics :
  NLA.MF16.SymmetricWord NLA.MF16.witnessWord ∧
    NLA.MF16.witnessWord.length = 16 ∧
      List.count NLA.MF16.Letter.X NLA.MF16.witnessWord = 14 ∧
        List.count NLA.MF16.Letter.B NLA.MF16.witnessWord = 2 ∧
          (∀ (X B : NLA.MF16.ComplexMatrix), NLA.MF16.evalWord NLA.MF16.witnessWord X B = X * B * X ^ 12 * B * X) ∧
            ∀ (X B : NLA.MF16.RealMatrix), NLA.MF16.evalWord NLA.MF16.witnessWord X B = X * B * X ^ 12 * B * X
NLA.MF16.source_data :
  Matrix.PosDef NLA.MF16.witnessB ∧
    Matrix.PosDef NLA.MF16.witnessP ∧
      Matrix.PosDef NLA.MF16.witnessX0 ∧
        NLA.MF16.evalWord NLA.MF16.witnessWord NLA.MF16.witnessX0 NLA.MF16.witnessB = NLA.MF16.witnessP ∧
          Matrix.det NLA.MF16.realB = 1 ∧ Matrix.det NLA.MF16.realX0 = 3 ∧ Matrix.det NLA.MF16.realP = 3 ^ 14
NLA.MF16.twelfth_power_reduction (v : Fin 3 → ℝ) (hdet : Matrix.det (NLA.MF16.symmetricMatrix v) = 3) :
  NLA.MF16.symmetricMatrix v ^ 12 =
    NLA.MF16.linearCoefficient (Matrix.trace (NLA.MF16.symmetricMatrix v)) • NLA.MF16.symmetricMatrix v -
      NLA.MF16.identityCoefficient (Matrix.trace (NLA.MF16.symmetricMatrix v)) • 1
NLA.MF16.polynomial_word_equivalence (v : Fin 3 → ℝ) :
  LeanCert.Engine.SystemZero NLA.MF16.polynomialSystem v ↔
    Matrix.det (NLA.MF16.symmetricMatrix v) = 3 ∧
      NLA.MF16.evalWord NLA.MF16.witnessWord (NLA.MF16.symmetricMatrix v) NLA.MF16.realB 0 0 = NLA.MF16.realP 0 0 ∧
        NLA.MF16.evalWord NLA.MF16.witnessWord (NLA.MF16.symmetricMatrix v) NLA.MF16.realB 0 1 = NLA.MF16.realP 0 1
NLA.MF16.krawczyk_certificate :
  LeanCert.Engine.krawczykCheck NLA.MF16.polynomialSystem NLA.MF16.rootBox NLA.MF16.rootCertificate = true ∧
    NLA.MF16.rootCertificate.preconditioner.det = 790668616748253 / 62500000000000000000000000000 ∧
      LeanCert.Engine.boxRadius NLA.MF16.rootBox NLA.MF16.rootCenter = NLA.MF16.rootRadius ∧
        NLA.MF16.contractionBound < 27 / 1000
NLA.MF16.certified_root :
  ∃! v, LeanCert.Engine.FinBoxMem v NLA.MF16.rootBox ∧ LeanCert.Engine.SystemZero NLA.MF16.polynomialSystem v
NLA.MF16.root_to_matrix (v : Fin 3 → ℝ) (hv : LeanCert.Engine.FinBoxMem v NLA.MF16.rootBox)
  (hz : LeanCert.Engine.SystemZero NLA.MF16.polynomialSystem v) :
  3 < v 0 ∧
    Matrix.PosDef (NLA.MF16.complexify (NLA.MF16.symmetricMatrix v)) ∧
      NLA.MF16.evalWord NLA.MF16.witnessWord (NLA.MF16.complexify (NLA.MF16.symmetricMatrix v)) NLA.MF16.witnessB =
          NLA.MF16.witnessP ∧
        NLA.MF16.complexify (NLA.MF16.symmetricMatrix v) ≠ NLA.MF16.witnessX0
NLA.MF16.counterexample :
  NLA.MF16.SymmetricWord NLA.MF16.witnessWord ∧
    Matrix.PosDef NLA.MF16.witnessB ∧
      Matrix.PosDef NLA.MF16.witnessP ∧
        Matrix.PosDef NLA.MF16.witnessX0 ∧
          NLA.MF16.evalWord NLA.MF16.witnessWord NLA.MF16.witnessX0 NLA.MF16.witnessB = NLA.MF16.witnessP ∧
            ∃ X,
              Matrix.PosDef X ∧
                NLA.MF16.evalWord NLA.MF16.witnessWord X NLA.MF16.witnessB = NLA.MF16.witnessP ∧ X ≠ NLA.MF16.witnessX0
NLA.MF16.not_wordUniquenessConjecture : ¬NLA.MF16.WordUniquenessConjecture
def NLA.MF16.WordUniquenessConjecture : Prop :=
∀ (w : List.{0} NLA.MF16.Letter),
  NLA.MF16.SymmetricWord w →
    ∀ (B P : NLA.MF16.ComplexMatrix),
      @Matrix.PosDef.{0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex Complex.instRing
          Complex.partialOrder Complex.instStarRing B →
        @Matrix.PosDef.{0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex
            Complex.instRing Complex.partialOrder Complex.instStarRing P →
          @ExistsUnique.{1} NLA.MF16.ComplexMatrix fun (X : NLA.MF16.ComplexMatrix) =>
            And
              (@Matrix.PosDef.{0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex
                Complex.instRing Complex.partialOrder Complex.instStarRing X)
              (@Eq.{1}
                (Matrix.{0, 0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                  (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex)
                (@NLA.MF16.evalWord.{0} Complex Complex.instSemiring w X B) P)
def NLA.MF16.SymmetricWord : List NLA.MF16.Letter → Prop :=
fun w => w = w.reverse ∧ NLA.MF16.Letter.X ∈ w
def NLA.MF16.evalWord.{u_1} : {R : Type u_1} →
  [Semiring R] →
    List NLA.MF16.Letter → Matrix (Fin 2) (Fin 2) R → Matrix (Fin 2) (Fin 2) R → Matrix (Fin 2) (Fin 2) R :=
fun {R} [Semiring R] w X B =>
  (List.map
      (fun letter =>
        match letter with
        | NLA.MF16.Letter.X => X
        | NLA.MF16.Letter.B => B)
      w).prod
def Matrix.PosDef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} → [inst : Ring R] → [PartialOrder R] → [StarRing R] → Matrix n n R → Prop :=
fun {n} {R} [Ring R] [PartialOrder R] [StarRing R] M =>
  M.IsHermitian ∧ ∀ ⦃x : n →₀ R⦄, x ≠ 0 → 0 < x.sum fun i xi => x.sum fun j xj => star xi * M i j * xj
def LeanCert.Engine.SystemZero : {n : ℕ} → (Fin n → LeanCert.Core.Expr) → (Fin n → ℝ) → Prop :=
fun {n} F x => ∀ (i : Fin n), LeanCert.Engine.evalFin (F i) x = 0
def LeanCert.Engine.FinBoxMem : {n : ℕ} → (Fin n → ℝ) → (Fin n → LeanCert.Core.IntervalRat) → Prop :=
fun {n} x X => ∀ (i : Fin n), x i ∈ X i
theorem NLA.MF16.certified_root_proved : ∃! v,
  LeanCert.Engine.FinBoxMem v NLA.MF16.rootBox ∧ LeanCert.Engine.SystemZero NLA.MF16.polynomialSystem v :=
LeanCert.Engine.krawczykCheck_sound NLA.MF16.polynomialSystem NLA.MF16.rootBox NLA.MF16.rootCertificate { }
  NLA.MF16.actual_krawczyk_checked
theorem NLA.MF16.not_wordUniquenessConjecture_proved : ¬NLA.MF16.WordUniquenessConjecture :=
fun h =>
  And.casesOn NLA.MF16.counterexample_proved fun hw right =>
    And.casesOn right fun hb right =>
      And.casesOn right fun hp right =>
        And.casesOn right fun hx0 right =>
          And.casesOn right fun heq0 right =>
            Exists.casesOn right fun X h_1 =>
