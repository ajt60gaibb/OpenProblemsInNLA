theorem NLA.MF16.root_to_matrix_proved : ∀ (v : Fin 3 → ℝ),
  LeanCert.Engine.FinBoxMem v NLA.MF16.rootBox →
    LeanCert.Engine.SystemZero NLA.MF16.polynomialSystem v →
      3 < v 0 ∧
        Matrix.PosDef (NLA.MF16.complexify (NLA.MF16.symmetricMatrix v)) ∧
          NLA.MF16.evalWord NLA.MF16.witnessWord (NLA.MF16.complexify (NLA.MF16.symmetricMatrix v)) NLA.MF16.witnessB =
              NLA.MF16.witnessP ∧
            NLA.MF16.complexify (NLA.MF16.symmetricMatrix v) ≠ NLA.MF16.witnessX0 :=
fun v hv hz =>
  And.casesOn ((NLA.MF16.polynomial_word_equivalence_proved v).mp hz) fun hd right =>
    And.casesOn right fun h00 h01 => NLA.MF16.matrix_recovery_from_equations v hv hd h00 h01
theorem NLA.MF16.counterexample_proved : NLA.MF16.SymmetricWord NLA.MF16.witnessWord ∧
  Matrix.PosDef NLA.MF16.witnessB ∧
    Matrix.PosDef NLA.MF16.witnessP ∧
      Matrix.PosDef NLA.MF16.witnessX0 ∧
        NLA.MF16.evalWord NLA.MF16.witnessWord NLA.MF16.witnessX0 NLA.MF16.witnessB = NLA.MF16.witnessP ∧
          ∃ X,
            Matrix.PosDef X ∧
              NLA.MF16.evalWord NLA.MF16.witnessWord X NLA.MF16.witnessB = NLA.MF16.witnessP ∧ X ≠ NLA.MF16.witnessX0 :=
Exists.casesOn NLA.MF16.certified_root_proved fun v h =>
  And.casesOn h fun left right =>
    And.casesOn left fun hv hz =>
      And.casesOn (NLA.MF16.root_to_matrix_proved v hv hz) fun left right =>
        And.casesOn right fun hp right =>
          And.casesOn right fun heq hne =>
            ⟨NLA.MF16.word_semantics_proved.left,
              ⟨NLA.MF16.source_data_proved.left,
                ⟨NLA.MF16.source_data_proved.right.left,
                  ⟨NLA.MF16.source_data_proved.right.right.left,
                    ⟨NLA.MF16.source_data_proved.right.right.right.left,
                      Exists.intro (NLA.MF16.complexify (NLA.MF16.symmetricMatrix v)) ⟨hp, ⟨heq, hne⟩⟩⟩⟩⟩⟩⟩
theorem NLA.MF16.not_wordUniquenessConjecture_proved : ¬NLA.MF16.WordUniquenessConjecture :=
fun h =>
  And.casesOn NLA.MF16.counterexample_proved fun hw right =>
    And.casesOn right fun hb right =>
      And.casesOn right fun hp right =>
        And.casesOn right fun hx0 right =>
          And.casesOn right fun heq0 right =>
