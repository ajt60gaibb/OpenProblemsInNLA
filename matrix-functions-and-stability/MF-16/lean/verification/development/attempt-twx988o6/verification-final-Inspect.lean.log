  NLA.MF16.SymmetricWord NLA.MF16.witnessWord ∧
    NLA.MF16.witnessWord.length = 16 ∧
      List.count NLA.MF16.Letter.X NLA.MF16.witnessWord = 14 ∧
        List.count NLA.MF16.Letter.B NLA.MF16.witnessWord = 2 ∧
          (∀ (X B : NLA.MF16.ComplexMatrix), NLA.MF16.evalWord NLA.MF16.witnessWord X B = X * B * X ^ 12 * B * X) ∧
            ∀ (X B : NLA.MF16.RealMatrix), NLA.MF16.evalWord NLA.MF16.witnessWord X B = X * B * X ^ 12 * B * X
NLA.MF16.source_data :
  Matrix.PosDef NLA.MF16.witnessB ∧
    Matrix.PosDef NLA.MF16.witnessP ∧
      Matrix.PosDef NLA.MF16.witnessX0 ∧
        NLA.MF16.evalWord NLA.MF16.witnessWord NLA.MF16.witnessX0 NLA.MF16.witnessB = NLA.MF16.witnessP ∧
          Matrix.det NLA.MF16.realB = 1 ∧ Matrix.det NLA.MF16.realX0 = 3 ∧ Matrix.det NLA.MF16.realP = 3 ^ 14
NLA.MF16.twelfth_power_reduction (v : Fin 3 → ℝ) (hdet : Matrix.det (NLA.MF16.symmetricMatrix v) = 3) :
  NLA.MF16.symmetricMatrix v ^ 12 =
