def NLA.MF16.WordUniquenessConjecture : Prop :=
∀ (w : List NLA.MF16.Letter),
  NLA.MF16.SymmetricWord w →
    ∀ (B P : NLA.MF16.ComplexMatrix),
      @Matrix.PosDef (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex Complex.instRing
          Complex.partialOrder Complex.instStarRing B →
        @Matrix.PosDef (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex Complex.instRing
            Complex.partialOrder Complex.instStarRing P →
          @ExistsUnique NLA.MF16.ComplexMatrix fun (X : NLA.MF16.ComplexMatrix) =>
            And
              (@Matrix.PosDef (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex Complex.instRing
                Complex.partialOrder Complex.instStarRing X)
              (@Eq
                (Matrix (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                  (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex)
                (@NLA.MF16.evalWord Complex Complex.instSemiring w X B) P)
def NLA.MF16.SymmetricWord : List Letter → Prop :=
fun w => w = w.reverse ∧ Letter.X ∈ w
def NLA.MF16.evalWord.{u_1} : {R : Type u_1} →
  [Semiring R] →
    (w : List NLA.MF16.Letter) →
      (X B :
          Matrix (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
            (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R) →
        Matrix (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
          (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R :=
fun {R : Type u_1} [inst : Semiring R] (w : List NLA.MF16.Letter)
    (X B :
      Matrix (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
        (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R) =>
  @List.prod
    (Matrix (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
      (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R)
    (@Matrix.instMulOfFintypeOfAddCommMonoid (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R
      (Fin.fintype (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
      (@Distrib.toMul R (@instDistribOfSemiring R inst)) (@Semiring.toAddCommMonoid R inst))
    (@Matrix.one (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R
      (instDecidableEqFin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
      (@MulZeroClass.toZero R (@instMulZeroClassOfSemiring R inst))
      (@AddMonoidWithOne.toOne R
        (@AddCommMonoidWithOne.toAddMonoidWithOne R
          (@NonAssocSemiring.toAddCommMonoidWithOne R (@Semiring.toNonAssocSemiring R inst)))))
    (@List.map NLA.MF16.Letter
      (Matrix (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
        (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R)
      (fun (letter : NLA.MF16.Letter) =>
        NLA.MF16.instReprLetter.repr.match_1
          (fun (letter : NLA.MF16.Letter) =>
            Matrix (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
              (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) R)
          letter (fun (_ : Unit) => X) fun (_ : Unit) => B)
      w)
def NLA.MF16.complexify : RealMatrix → ComplexMatrix :=
fun A => Matrix.map A Complex.ofReal
def Matrix.PosDef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} → [inst : Ring R] → [PartialOrder R] → [StarRing R] → Matrix n n R → Prop :=
fun {n} {R} [Ring R] [PartialOrder R] [StarRing R] M =>
  M.IsHermitian ∧ ∀ ⦃x : n →₀ R⦄, x ≠ 0 → 0 < x.sum fun i xi => x.sum fun j xj => star xi * M i j * xj
def LeanCert.Engine.FinBoxMem : {n : ℕ} → (Fin n → ℝ) → (Fin n → IntervalRat) → Prop :=
fun {n} x X => ∀ (i : Fin n), x i ∈ X i
def LeanCert.Engine.SystemZero : {n : ℕ} → (Fin n → Expr) → (Fin n → ℝ) → Prop :=
fun {n} F x => ∀ (i : Fin n), evalFin (F i) x = 0
LeanCert.Engine.krawczykCheck_sound {n : ℕ} (F : Fin n → Expr) (X : Fin n → IntervalRat) (cert : KrawczykCert n)
  (cfg : EvalConfig) (hcheck : krawczykCheck F X cert cfg = true) : ∃! x, FinBoxMem x X ∧ SystemZero F x
LeanCert.Engine.fixedPoint_iff_systemZero {n : ℕ} (F : Fin n → Expr) (Y : Matrix (Fin n) (Fin n) ℚ) (hdet : Y.det ≠ 0)
  (x : Fin n → ℝ) : newtonMap (Y.map fun q => ↑q) F x = x ↔ SystemZero F x
Matrix.aeval_self_charpoly.{u_1, u_4} {R : Type u_1} [CommRing R] {n : Type u_4} [DecidableEq n] [Fintype n]
  (M : Matrix n n R) : (Polynomial.aeval M) M.charpoly = 0
