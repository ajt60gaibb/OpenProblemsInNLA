def NLA.MF16.WordUniquenessConjecture : Prop :=
∀ (w : List.{0} NLA.MF16.Letter),
  NLA.MF16.SymmetricWord w →
    ∀ (B P : NLA.MF16.ComplexMatrix),
      @Matrix.PosDef.{0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex Complex.instRing
          Complex.partialOrder Complex.instStarRing B →
        @Matrix.PosDef.{0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex
            Complex.instRing Complex.partialOrder Complex.instStarRing P →
          @ExistsUnique.{1} NLA.MF16.ComplexMatrix fun (X : NLA.MF16.ComplexMatrix) =>
            And
              (@Matrix.PosDef.{0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex
                Complex.instRing Complex.partialOrder Complex.instStarRing X)
              (@Eq.{1}
                (Matrix.{0, 0, 0} (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                  (Fin (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex)
                (@NLA.MF16.evalWord.{0} Complex Complex.instSemiring w X B) P)
def Matrix.PosDef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} →
    [inst : Ring.{u_3} R] →
      [PartialOrder.{u_3} R] →
        [@StarRing.{u_3} R
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{u_3} R
                (@NonAssocRing.toNonUnitalNonAssocRing.{u_3} R (@Ring.toNonAssocRing.{u_3} R inst)))] →
          (M : Matrix.{u_2, u_2, u_3} n n R) → Prop :=
fun {n : Type u_2} {R : Type u_3} [inst : Ring.{u_3} R] [inst_1 : PartialOrder.{u_3} R]
    [inst_2 :
      @StarRing.{u_3} R
        (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{u_3} R
          (@NonAssocRing.toNonUnitalNonAssocRing.{u_3} R (@Ring.toNonAssocRing.{u_3} R inst)))]
    (M : Matrix.{u_2, u_2, u_3} n n R) =>
  And
    (@Matrix.IsHermitian.{u_3, u_2} R n
      (@InvolutiveStar.toStar.{u_3} R
        (@StarAddMonoid.toInvolutiveStar.{u_3} R
          (@AddCommMonoid.toAddMonoid.{u_3} R
            (@NonUnitalNonAssocSemiring.toAddCommMonoid.{u_3} R
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{u_3} R
                (@NonAssocRing.toNonUnitalNonAssocRing.{u_3} R (@Ring.toNonAssocRing.{u_3} R inst)))))
          (@StarRing.toStarAddMonoid.{u_3} R
            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{u_3} R
              (@NonAssocRing.toNonUnitalNonAssocRing.{u_3} R (@Ring.toNonAssocRing.{u_3} R inst)))
            inst_2)))
      M)
    (∀
      ⦃x :
        @Finsupp.{u_2, u_3} n R
          (@MulZeroClass.toZero.{u_3} R (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst)))⦄,
      @Ne.{max (u_2 + 1) (u_3 + 1)}
          (@Finsupp.{u_2, u_3} n R
            (@MulZeroClass.toZero.{u_3} R (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst))))
          x
          (@OfNat.ofNat.{max u_2 u_3}
            (@Finsupp.{u_2, u_3} n R
              (@MulZeroClass.toZero.{u_3} R (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst))))
            (nat_lit 0)
            (@Zero.toOfNat0.{max u_2 u_3}
              (@Finsupp.{u_2, u_3} n R
                (@MulZeroClass.toZero.{u_3} R (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst))))
              (@Finsupp.instZero.{u_2, u_3} n R
                (@MulZeroClass.toZero.{u_3} R
                  (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst)))))) →
        @LT.lt.{u_3} R (@Preorder.toLT.{u_3} R (@PartialOrder.toPreorder.{u_3} R inst_1))
          (@OfNat.ofNat.{u_3} R (nat_lit 0)
            (@Zero.toOfNat0.{u_3} R
              (@MulZeroClass.toZero.{u_3} R (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst)))))
          (@Finsupp.sum.{u_2, u_3, u_3} n R R
            (@MulZeroClass.toZero.{u_3} R (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst)))
            (@Semiring.toAddCommMonoid.{u_3} R (@Ring.toSemiring.{u_3} R inst)) x fun (i : n) (xi : R) =>
            @Finsupp.sum.{u_2, u_3, u_3} n R R
              (@MulZeroClass.toZero.{u_3} R (@instMulZeroClassOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst)))
              (@Semiring.toAddCommMonoid.{u_3} R (@Ring.toSemiring.{u_3} R inst)) x fun (j : n) (xj : R) =>
              @HMul.hMul.{u_3, u_3, u_3} R R R
                (@instHMul.{u_3} R
                  (@Distrib.toMul.{u_3} R (@instDistribOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst))))
                (@HMul.hMul.{u_3, u_3, u_3} R R R
                  (@instHMul.{u_3} R
                    (@Distrib.toMul.{u_3} R (@instDistribOfSemiring.{u_3} R (@Ring.toSemiring.{u_3} R inst))))
                  (@Star.star.{u_3} R
                    (@InvolutiveStar.toStar.{u_3} R
                      (@StarAddMonoid.toInvolutiveStar.{u_3} R
                        (@AddCommMonoid.toAddMonoid.{u_3} R
                          (@NonUnitalNonAssocSemiring.toAddCommMonoid.{u_3} R
                            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{u_3} R
                              (@NonAssocRing.toNonUnitalNonAssocRing.{u_3} R (@Ring.toNonAssocRing.{u_3} R inst)))))
                        (@StarRing.toStarAddMonoid.{u_3} R
                          (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{u_3} R
                            (@NonAssocRing.toNonUnitalNonAssocRing.{u_3} R (@Ring.toNonAssocRing.{u_3} R inst)))
                          inst_2)))
                    xi)
                  (M i j))
                xj))
