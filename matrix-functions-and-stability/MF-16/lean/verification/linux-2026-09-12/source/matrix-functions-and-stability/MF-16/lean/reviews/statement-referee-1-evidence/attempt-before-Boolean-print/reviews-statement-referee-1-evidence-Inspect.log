def NLA.MF16.SymmetricWord : List Letter → Prop :=
fun w => w = w.reverse ∧ Letter.X ∈ w
def NLA.MF16.symmetricMatrix : (Fin 3 → ℝ) → RealMatrix :=
fun v => !![v 0, v 1; v 1, v 2]
def NLA.MF16.linearCoefficient : ℝ → ℝ :=
fun s =>
  have t := s * s;
  s * (t * (t * (t * (t * (t - 30) + 324) - 1512) + 2835) - 1458)
def NLA.MF16.identityCoefficient : ℝ → ℝ :=
fun s =>
  have t := s * s;
  3 * (t * (t * (t * (t * (t - 27) + 252) - 945) + 1215) - 243)
