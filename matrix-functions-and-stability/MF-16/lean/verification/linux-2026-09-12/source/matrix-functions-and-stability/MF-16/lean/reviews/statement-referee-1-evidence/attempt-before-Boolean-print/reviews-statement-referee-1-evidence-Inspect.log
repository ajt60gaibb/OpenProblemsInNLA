def LeanCert.Engine.SystemZero : {n : ℕ} → (Fin n → Expr) → (Fin n → ℝ) → Prop :=
fun {n} F x => ∀ (i : Fin n), evalFin (F i) x = 0
def LeanCert.Engine.FinBoxMem : {n : ℕ} → (Fin n → ℝ) → (Fin n → IntervalRat) → Prop :=
fun {n} x X => ∀ (i : Fin n), x i ∈ X i
def LeanCert.Engine.krawczykCheck : {n : ℕ} →
  (Fin n → Expr) → (Fin n → IntervalRat) → KrawczykCert n → optParam EvalConfig { } → Bool :=
fun {n} F X cert cfg =>
  decide (∀ (i : Fin n), (F i).checkADSupported = true) && decide (centerInside X cert.center) &&
        decide (cert.preconditioner.det ≠ 0) &&
      decide (intervalMatrixBound (preconditionedJacobian cert.preconditioner (intervalJacobian F X cfg)) < 1) &&
    decide
      (∀ (i : Fin n),
        intervalStrictInside (newtonImageEnclosure F X cert.center cert.preconditioner cfg i) (X i) = true)
LeanCert.Engine.krawczykCheck_sound {n : ℕ} (F : Fin n → Expr) (X : Fin n → IntervalRat) (cert : KrawczykCert n)
  (cfg : EvalConfig) (hcheck : krawczykCheck F X cert cfg = true) : ∃! x, FinBoxMem x X ∧ SystemZero F x
LeanCert.Engine.jacobianAt_mem_intervalJacobian {n : ℕ} (F : Fin n → Expr) (h : ∀ (i : Fin n), ADSupported (F i))
  (X : Fin n → IntervalRat) (x : Fin n → ℝ) (hx : FinBoxMem x X) (cfg : EvalConfig) (i j : Fin n) :
  jacobianAt F x i j ∈ intervalJacobian F X cfg i j
LeanCert.Engine.contraction_unique_fixedPoint_in_finBox {n : ℕ} (X : Fin n → IntervalRat) (m : Fin n → ℝ)
  (hm : FinBoxMem m X) (g : (Fin n → ℝ) → Fin n → ℝ) (hmap : Set.MapsTo g (finBoxSet X) (finBoxSet X)) (q : ℝ)
  (hq0 : 0 ≤ q) (hq1 : q < 1) (hdiff : ∀ x ∈ finBoxSet X, DifferentiableAt ℝ g x)
  (hderiv : ∀ x ∈ finBoxSet X, ‖fderiv ℝ g x‖ ≤ q) : ∃! x, FinBoxMem x X ∧ g x = x
Matrix.aeval_self_charpoly.{u_1, u_4} {R : Type u_1} [CommRing R] {n : Type u_4} [DecidableEq n] [Fintype n]
  (M : Matrix n n R) : (Polynomial.aeval M) M.charpoly = 0
Matrix.posDef_iff_dotProduct_mulVec.{u_2, u_3} {n : Type u_2} {R : Type u_3} [Ring R] [PartialOrder R] [StarRing R]
  [Fintype n] {M : Matrix n n R} : M.PosDef ↔ M.IsHermitian ∧ ∀ ⦃x : n → R⦄, x ≠ 0 → 0 < star x ⬝ᵥ M.mulVec x
NLA.MF16.word_semantics :
  SymmetricWord witnessWord ∧
    witnessWord.length = 16 ∧
      List.count Letter.X witnessWord = 14 ∧
        List.count Letter.B witnessWord = 2 ∧
          (∀ (X B : ComplexMatrix), evalWord witnessWord X B = X * B * X ^ 12 * B * X) ∧
            ∀ (X B : RealMatrix), evalWord witnessWord X B = X * B * X ^ 12 * B * X
NLA.MF16.source_data :
  Matrix.PosDef witnessB ∧
    Matrix.PosDef witnessP ∧
      Matrix.PosDef witnessX0 ∧
        evalWord witnessWord witnessX0 witnessB = witnessP ∧
          Matrix.det realB = 1 ∧ Matrix.det realX0 = 3 ∧ Matrix.det realP = 3 ^ 14
NLA.MF16.twelfth_power_reduction (v : Fin 3 → ℝ) (hdet : Matrix.det (symmetricMatrix v) = 3) :
  symmetricMatrix v ^ 12 =
    linearCoefficient (Matrix.trace (symmetricMatrix v)) • symmetricMatrix v -
      identityCoefficient (Matrix.trace (symmetricMatrix v)) • 1
NLA.MF16.polynomial_word_equivalence (v : Fin 3 → ℝ) :
  SystemZero polynomialSystem v ↔
    Matrix.det (symmetricMatrix v) = 3 ∧
      evalWord witnessWord (symmetricMatrix v) realB 0 0 = realP 0 0 ∧
        evalWord witnessWord (symmetricMatrix v) realB 0 1 = realP 0 1
NLA.MF16.krawczyk_certificate :
  krawczykCheck polynomialSystem rootBox rootCertificate = true ∧
    rootCertificate.preconditioner.det = 790668616748253 / 62500000000000000000000000000 ∧
      boxRadius rootBox rootCenter = rootRadius ∧ contractionBound < 27 / 1000
NLA.MF16.certified_root : ∃! v, FinBoxMem v rootBox ∧ SystemZero polynomialSystem v
NLA.MF16.root_to_matrix (v : Fin 3 → ℝ) (hv : FinBoxMem v rootBox) (hz : SystemZero polynomialSystem v) :
  3 < v 0 ∧
    Matrix.PosDef (complexify (symmetricMatrix v)) ∧
      evalWord witnessWord (complexify (symmetricMatrix v)) witnessB = witnessP ∧
        complexify (symmetricMatrix v) ≠ witnessX0
NLA.MF16.counterexample :
  SymmetricWord witnessWord ∧
    Matrix.PosDef witnessB ∧
      Matrix.PosDef witnessP ∧
        Matrix.PosDef witnessX0 ∧
          evalWord witnessWord witnessX0 witnessB = witnessP ∧
            ∃ X, Matrix.PosDef X ∧ evalWord witnessWord X witnessB = witnessP ∧ X ≠ witnessX0
NLA.MF16.not_wordUniquenessConjecture : ¬WordUniquenessConjecture
