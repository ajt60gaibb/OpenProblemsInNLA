Matrix.det_fromBlocks₁₁.{u_2, u_3, u_4} {m : Type u_2} {n : Type u_3} {α : Type u_4} [Fintype m] [Fintype n]
  [DecidableEq m] [DecidableEq n] [CommRing α] (A : Matrix m m α) (B : Matrix m n α) (C : Matrix n m α)
  (D : Matrix n n α) [Invertible A] : (Matrix.fromBlocks A B C D).det = A.det * (D - C * ⅟A * B).det
