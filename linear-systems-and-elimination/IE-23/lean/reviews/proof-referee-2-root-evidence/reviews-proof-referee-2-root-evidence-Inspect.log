      (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)) p)
def NLA.IE23.inducedNorm : {m n : Nat} → Real → NLA.IE23.Mat n m → Real :=
fun {m n} p X => @sSup Real Real.instSupSet (@NLA.IE23.ratioSet m n p X)
