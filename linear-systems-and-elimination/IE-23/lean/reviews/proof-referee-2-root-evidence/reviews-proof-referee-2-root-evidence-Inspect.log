      ((i : Fin n) → (fun x => Complex) i) y)
def NLA.IE23.lpNorm : {n : Nat} → Real → NLA.IE23.Vec n → Real :=
fun {n} p y =>
  @HPow.hPow Real Real Real (@instHPow Real Real Real.instPow)
