REACHABLE_PROJECT_DECLARATIONS 93
NLA.IE23.inducedNorm_semantics {m n : ℕ} (hm : 1 ≤ m) (p : ℝ) (hp : 2 < p) (X : NLA.IE23.Mat n m) :
  (∀ (y : NLA.IE23.Vec m), y ≠ 0 → 0 < NLA.IE23.lpNorm p y) ∧
    (NLA.IE23.ratioSet p X).Nonempty ∧
      BddAbove (NLA.IE23.ratioSet p X) ∧
        IsLUB (NLA.IE23.ratioSet p X) (NLA.IE23.inducedNorm p X) ∧
