def NLA.IE23.euclideanNorm : {n : Nat} → NLA.IE23.Vec n → Real :=
fun {n} y =>
  @norm
    (WithLp
      (@OfNat.ofNat ENNReal (nat_lit 2)
        (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
          (@AddMonoidWithOne.toNatCast ENNReal
            (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
          NLA.IE23.euclideanNorm._proof_1))
      ((i : Fin n) → (fun x => Complex) i))
    (@PiLp.instNorm
      (@OfNat.ofNat ENNReal (nat_lit 2)
        (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
          (@AddMonoidWithOne.toNatCast ENNReal
            (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
          NLA.IE23.euclideanNorm._proof_1))
      (Fin n) (fun x => Complex) (Fin.fintype n) fun i => Complex.instNorm)
    (@WithLp.toLp
      (@OfNat.ofNat ENNReal (nat_lit 2)
        (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
          (@AddMonoidWithOne.toNatCast ENNReal
            (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
          NLA.IE23.euclideanNorm._proof_1))
      ((i : Fin n) → (fun x => Complex) i) y)
def NLA.IE23.lpNorm : {n : Nat} → Real → NLA.IE23.Vec n → Real :=
fun {n} p y =>
  @HPow.hPow Real Real Real (@instHPow Real Real Real.instPow)
    (∑ i, @HPow.hPow Real Real Real (@instHPow Real Real Real.instPow) (@norm Complex Complex.instNorm (y i)) p)
    (@HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
      (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)) p)
def NLA.IE23.moorePenrose : {m n : Nat} → NLA.IE23.Mat m n → NLA.IE23.Mat n m :=
fun {m n} A =>
  @HMul.hMul (Matrix (Fin n) (Fin m) Complex) (Matrix (Fin m) (Fin m) Complex) (Matrix (Fin n) (Fin m) Complex)
    (@Matrix.instHMulOfFintypeOfMulOfAddCommMonoid (Fin n) (Fin m) (Fin m) Complex (Fin.fintype m) Complex.instMul
      Complex.instAddCommMonoid)
    (@Matrix.conjTranspose (Fin m) (Fin n) Complex
      (@InvolutiveStar.toStar Complex
        (@StarAddMonoid.toInvolutiveStar Complex
          (@AddCommMonoid.toAddMonoid Complex
            (@NonUnitalNonAssocSemiring.toAddCommMonoid Complex
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring Complex
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing Complex
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing Complex Complex.instNonUnitalCommRing)))))
          (@StarRing.toStarAddMonoid Complex
            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring Complex
              (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing Complex
                (@NonUnitalCommRing.toNonUnitalNonAssocCommRing Complex Complex.instNonUnitalCommRing)))
            Complex.instStarRing)))
      A)
    (@Inv.inv (Matrix (Fin m) (Fin m) Complex)
      (@Matrix.inv (Fin m) Complex (Fin.fintype m) (instDecidableEqFin m) Complex.commRing)
      (@HMul.hMul (NLA.IE23.Mat m n) (Matrix (Fin n) (Fin m) Complex) (Matrix (Fin m) (Fin m) Complex)
        (@Matrix.instHMulOfFintypeOfMulOfAddCommMonoid (Fin m) (Fin n) (Fin m) Complex (Fin.fintype n) Complex.instMul
          Complex.instAddCommMonoid)
        A
        (@Matrix.conjTranspose (Fin m) (Fin n) Complex
          (@InvolutiveStar.toStar Complex
            (@StarAddMonoid.toInvolutiveStar Complex
              (@AddCommMonoid.toAddMonoid Complex
                (@NonUnitalNonAssocSemiring.toAddCommMonoid Complex
                  (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring Complex
                    (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing Complex
                      (@NonUnitalCommRing.toNonUnitalNonAssocCommRing Complex Complex.instNonUnitalCommRing)))))
              (@StarRing.toStarAddMonoid Complex
                (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring Complex
                  (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing Complex
                    (@NonUnitalCommRing.toNonUnitalNonAssocCommRing Complex Complex.instNonUnitalCommRing)))
                Complex.instStarRing)))
          A)))
@[instance_reducible] def Matrix.inv.{u', v} : {n : Type u'} →
  {α : Type v} → [Fintype n] → [DecidableEq n] → [CommRing α] → Inv (Matrix n n α) :=
fun {n} {α} [Fintype n] [DecidableEq n] [CommRing α] => { inv := fun A => Ring.inverse A.det • A.adjugate }
