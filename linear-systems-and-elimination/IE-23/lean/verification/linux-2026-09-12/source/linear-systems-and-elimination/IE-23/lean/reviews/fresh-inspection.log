@[reducible] def NLA.IE23.Vec : ℕ → Type :=
fun n => Fin n → ℂ
'NLA.IE23.Vec' depends on axioms: [propext, Classical.choice, Quot.sound]
@[reducible] def NLA.IE23.Mat : ℕ → ℕ → Type :=
fun m n => Matrix (Fin m) (Fin n) ℂ
'NLA.IE23.Mat' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.euclideanNorm : {n : ℕ} → NLA.IE23.Vec n → ℝ :=
fun {n} y => ‖WithLp.toLp 2 y‖
'NLA.IE23.euclideanNorm' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.lpNorm : {n : ℕ} → ℝ → NLA.IE23.Vec n → ℝ :=
fun {n} p y => (∑ i, ‖y i‖ ^ p) ^ (1 / p)
'NLA.IE23.lpNorm' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.ratioSet : {m n : ℕ} → ℝ → NLA.IE23.Mat n m → Set ℝ :=
fun {m n} p X => {r | ∃ y, y ≠ 0 ∧ r = NLA.IE23.euclideanNorm (Matrix.mulVec X y) / NLA.IE23.lpNorm p y}
'NLA.IE23.ratioSet' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.inducedNorm : {m n : ℕ} → ℝ → NLA.IE23.Mat n m → ℝ :=
fun {m n} p X => sSup (NLA.IE23.ratioSet p X)
'NLA.IE23.inducedNorm' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.FullRowRank : {m n : ℕ} → NLA.IE23.Mat m n → Prop :=
fun {m n} A => Matrix.rank A = m
'NLA.IE23.FullRowRank' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.moorePenrose : {m n : ℕ} → NLA.IE23.Mat m n → NLA.IE23.Mat n m :=
fun {m n} A => Matrix.conjTranspose A * (A * Matrix.conjTranspose A)⁻¹
'NLA.IE23.moorePenrose' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.IsRightInverse : {m n : ℕ} → NLA.IE23.Mat m n → NLA.IE23.Mat n m → Prop :=
fun {m n} A X => A * X = 1
'NLA.IE23.IsRightInverse' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.IsNormMinimizer : {m n : ℕ} → NLA.IE23.Mat m n → ℝ → NLA.IE23.Mat n m → Prop :=
fun {m n} A p X =>
  NLA.IE23.IsRightInverse A X ∧
    ∀ (Y : NLA.IE23.Mat n m), NLA.IE23.IsRightInverse A Y → NLA.IE23.inducedNorm p X ≤ NLA.IE23.inducedNorm p Y
'NLA.IE23.IsNormMinimizer' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.rightInverseNorms : {m n : ℕ} → NLA.IE23.Mat m n → ℝ → Set ℝ :=
fun {m n} A p => {c | ∃ Y, NLA.IE23.IsRightInverse A Y ∧ c = NLA.IE23.inducedNorm p Y}
'NLA.IE23.rightInverseNorms' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE23.RightInverseUniqueConjecture : Prop :=
∀ (m n : ℕ),
  1 ≤ m →
    m < n →
      ∀ (A : NLA.IE23.Mat m n),
        NLA.IE23.FullRowRank A →
          ∀ (p : ℝ),
            2 < p →
              ∀ (X : NLA.IE23.Mat n m),
                NLA.IE23.IsRightInverse A X →
                  X ≠ NLA.IE23.moorePenrose A →
                    NLA.IE23.inducedNorm p (NLA.IE23.moorePenrose A) < NLA.IE23.inducedNorm p X
'NLA.IE23.RightInverseUniqueConjecture' depends on axioms: [propext, Classical.choice, Quot.sound]
