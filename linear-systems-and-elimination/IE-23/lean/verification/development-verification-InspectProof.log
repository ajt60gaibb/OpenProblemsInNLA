NLA.IE23.inducedNorm_semantics {m n : ℕ} (hm : 1 ≤ m) (p : ℝ) (hp : 2 < p) (X : NLA.IE23.Mat n m) :
  (∀ (y : NLA.IE23.Vec m), y ≠ 0 → 0 < NLA.IE23.lpNorm p y) ∧
    (NLA.IE23.ratioSet p X).Nonempty ∧
      BddAbove (NLA.IE23.ratioSet p X) ∧
        IsLUB (NLA.IE23.ratioSet p X) (NLA.IE23.inducedNorm p X) ∧
          0 ≤ NLA.IE23.inducedNorm p X ∧
            ∀ (y : NLA.IE23.Vec m),
              NLA.IE23.euclideanNorm (Matrix.mulVec X y) ≤ NLA.IE23.inducedNorm p X * NLA.IE23.lpNorm p y
NLA.IE23.witness_matrix_identities :
  NLA.IE23.FullRowRank NLA.IE23.witnessA ∧
    NLA.IE23.witnessA * Matrix.conjTranspose NLA.IE23.witnessA = NLA.IE23.witnessGram ∧
      IsUnit NLA.IE23.witnessGram ∧
        NLA.IE23.witnessGram⁻¹ = NLA.IE23.witnessGramInv ∧
          NLA.IE23.moorePenrose NLA.IE23.witnessA = NLA.IE23.witnessB ∧
            NLA.IE23.IsRightInverse NLA.IE23.witnessA NLA.IE23.witnessB ∧
              NLA.IE23.IsRightInverse NLA.IE23.witnessA NLA.IE23.witnessX ∧
                NLA.IE23.witnessB ≠ NLA.IE23.witnessX ∧
                  Matrix.conjTranspose NLA.IE23.witnessB * NLA.IE23.witnessB = NLA.IE23.witnessGramInv ∧
                    Matrix.conjTranspose NLA.IE23.witnessX * NLA.IE23.witnessX = 1
NLA.IE23.fourth_power_norm_control :
  2 < 4 ∧
    0 < NLA.IE23.witnessNorm ∧
      NLA.IE23.witnessNorm ^ 2 = √2 ∧
        NLA.IE23.witnessNorm ^ 4 = 2 ∧
          NLA.IE23.witnessNorm = 2 ^ (1 / 2 - 1 / 4) ∧
            (∀ (y : NLA.IE23.Vec 2), NLA.IE23.euclideanNorm y ^ 2 = ∑ i, Complex.normSq (y i)) ∧
              (∀ (y : NLA.IE23.Vec 2), NLA.IE23.lpNorm 4 y ^ 4 = ∑ i, ‖y i‖ ^ 4) ∧
                ∀ (y : NLA.IE23.Vec 2), NLA.IE23.euclideanNorm y ≤ NLA.IE23.witnessNorm * NLA.IE23.lpNorm 4 y
NLA.IE23.witness_action_identities :
  (∀ (y : NLA.IE23.Vec 2),
      NLA.IE23.euclideanNorm (Matrix.mulVec NLA.IE23.witnessB y) ^ 2 + Complex.normSq (y 0 + y 1) / 3 =
        NLA.IE23.euclideanNorm y ^ 2) ∧
    (∀ (y : NLA.IE23.Vec 2), NLA.IE23.euclideanNorm (Matrix.mulVec NLA.IE23.witnessX y) = NLA.IE23.euclideanNorm y) ∧
      ∀ (Y : NLA.IE23.Mat 3 2),
        NLA.IE23.IsRightInverse NLA.IE23.witnessA Y →
          NLA.IE23.euclideanNorm (Matrix.mulVec Y NLA.IE23.normingVector) ^ 2 =
            2 + 3 * Complex.normSq (Matrix.mulVec Y NLA.IE23.normingVector 0)
NLA.IE23.witness_attainment :
  NLA.IE23.normingVector ≠ 0 ∧
    NLA.IE23.lpNorm 4 NLA.IE23.normingVector = NLA.IE23.witnessNorm ∧
      NLA.IE23.euclideanNorm (Matrix.mulVec NLA.IE23.witnessB NLA.IE23.normingVector) = √2 ∧
        NLA.IE23.euclideanNorm (Matrix.mulVec NLA.IE23.witnessX NLA.IE23.normingVector) = √2 ∧
          NLA.IE23.euclideanNorm (Matrix.mulVec NLA.IE23.witnessB NLA.IE23.normingVector) /
                NLA.IE23.lpNorm 4 NLA.IE23.normingVector =
              NLA.IE23.witnessNorm ∧
            NLA.IE23.euclideanNorm (Matrix.mulVec NLA.IE23.witnessX NLA.IE23.normingVector) /
                NLA.IE23.lpNorm 4 NLA.IE23.normingVector =
              NLA.IE23.witnessNorm
NLA.IE23.witness_norms :
  NLA.IE23.inducedNorm 4 NLA.IE23.witnessB = NLA.IE23.witnessNorm ∧
    NLA.IE23.inducedNorm 4 NLA.IE23.witnessX = NLA.IE23.witnessNorm
NLA.IE23.witness_global_minimizers :
  NLA.IE23.IsNormMinimizer NLA.IE23.witnessA 4 NLA.IE23.witnessB ∧
    NLA.IE23.IsNormMinimizer NLA.IE23.witnessA 4 NLA.IE23.witnessX ∧
      IsLeast (NLA.IE23.rightInverseNorms NLA.IE23.witnessA 4) NLA.IE23.witnessNorm
NLA.IE23.not_rightInverseUniqueConjecture : ¬NLA.IE23.RightInverseUniqueConjecture
def NLA.IE23.euclideanNorm : {n : Nat} → NLA.IE23.Vec n → Real :=
fun {n} y =>
  @norm
    (WithLp
      (@OfNat.ofNat ENNReal (nat_lit 2)
        (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
          (@AddMonoidWithOne.toNatCast ENNReal
            (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
          NLA.IE23.euclideanNorm._proof_1))
      ((i : Fin n) → (fun x => Complex) i))
    (@PiLp.instNorm
      (@OfNat.ofNat ENNReal (nat_lit 2)
        (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
          (@AddMonoidWithOne.toNatCast ENNReal
            (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
          NLA.IE23.euclideanNorm._proof_1))
      (Fin n) (fun x => Complex) (Fin.fintype n) fun i => Complex.instNorm)
    (@WithLp.toLp
      (@OfNat.ofNat ENNReal (nat_lit 2)
        (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
          (@AddMonoidWithOne.toNatCast ENNReal
            (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
          NLA.IE23.euclideanNorm._proof_1))
      ((i : Fin n) → (fun x => Complex) i) y)
def NLA.IE23.lpNorm : {n : Nat} → Real → NLA.IE23.Vec n → Real :=
fun {n} p y =>
  @HPow.hPow Real Real Real (@instHPow Real Real Real.instPow)
    (∑ i, @HPow.hPow Real Real Real (@instHPow Real Real Real.instPow) (@norm Complex Complex.instNorm (y i)) p)
    (@HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
      (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)) p)
def NLA.IE23.ratioSet : {m n : ℕ} → ℝ → NLA.IE23.Mat n m → Set ℝ :=
fun {m n} p X => {r | ∃ y, y ≠ 0 ∧ r = NLA.IE23.euclideanNorm (Matrix.mulVec X y) / NLA.IE23.lpNorm p y}
def NLA.IE23.inducedNorm : {m n : ℕ} → ℝ → NLA.IE23.Mat n m → ℝ :=
fun {m n} p X => sSup (NLA.IE23.ratioSet p X)
def NLA.IE23.FullRowRank : {m n : ℕ} → NLA.IE23.Mat m n → Prop :=
fun {m n} A => Matrix.rank A = m
def NLA.IE23.moorePenrose : {m n : ℕ} → NLA.IE23.Mat m n → NLA.IE23.Mat n m :=
fun {m n} A => Matrix.conjTranspose A * (A * Matrix.conjTranspose A)⁻¹
def NLA.IE23.RightInverseUniqueConjecture : Prop :=
∀ (m n : ℕ),
  1 ≤ m →
    m < n →
      ∀ (A : NLA.IE23.Mat m n),
        NLA.IE23.FullRowRank A →
          ∀ (p : ℝ),
            2 < p →
              ∀ (X : NLA.IE23.Mat n m),
                NLA.IE23.IsRightInverse A X →
                  X ≠ NLA.IE23.moorePenrose A →
                    NLA.IE23.inducedNorm p (NLA.IE23.moorePenrose A) < NLA.IE23.inducedNorm p X
def NLA.IE23.IsNormMinimizer : {m n : ℕ} → NLA.IE23.Mat m n → ℝ → NLA.IE23.Mat n m → Prop :=
fun {m n} A p X =>
  NLA.IE23.IsRightInverse A X ∧
    ∀ (Y : NLA.IE23.Mat n m), NLA.IE23.IsRightInverse A Y → NLA.IE23.inducedNorm p X ≤ NLA.IE23.inducedNorm p Y
def NLA.IE23.rightInverseNorms : {m n : ℕ} → NLA.IE23.Mat m n → ℝ → Set ℝ :=
fun {m n} A p => {c | ∃ Y, NLA.IE23.IsRightInverse A Y ∧ c = NLA.IE23.inducedNorm p Y}
theorem NLA.IE23.norm_coord_le_lpNorm : ∀ {n : ℕ} {p : ℝ},
  0 < p → ∀ (y : NLA.IE23.Vec n) (i : Fin n), ‖y i‖ ≤ NLA.IE23.lpNorm p y :=
fun {n} {p} hp y i =>
  id
    (Eq.mpr (id (congrArg (fun _a => ‖y i‖ ≤ (∑ i, ‖y i‖ ^ p) ^ _a) (one_div p)))
      ((Real.le_rpow_inv_iff_of_pos (norm_nonneg (y i))
            (Finset.sum_nonneg fun x x_1 => Real.rpow_nonneg (norm_nonneg (y x)) p) hp).mpr
        (Finset.single_le_sum (fun x x_1 => Real.rpow_nonneg (norm_nonneg (y x)) p) (Finset.mem_univ i))))
theorem NLA.IE23.ratioSet_bddAbove : ∀ {m n : ℕ} {p : ℝ},
