def NLA.IV06.EntrywiseLE : {n : ℕ} → NLA.IV06.RealMatrix n → NLA.IV06.RealMatrix n → Prop :=
fun {n} L U => ∀ (i j : Fin n), LE.le.{0} (L i j) (U i j)
def NLA.IV06.InIntervalFamily : {n : ℕ} →
  NLA.IV06.RealMatrix n → NLA.IV06.RealMatrix n → NLA.IV06.RealMatrix n → Prop :=
fun {n} L U A => NLA.IV06.EntrywiseLE L A ∧ NLA.IV06.EntrywiseLE A U
def NLA.IV06.HasRealEigenvalue : {n : ℕ} → NLA.IV06.RealMatrix n → ℝ → Prop :=
fun {n} A lam => ∃ v, Ne.{1} v 0 ∧ Eq.{1} (Matrix.mulVec.{0, 0, 0} A v) (HSMul.hSMul.{0, 0, 0} lam v)
def NLA.IV06.realEigenvalueSet : {n : ℕ} → NLA.IV06.RealMatrix n → NLA.IV06.RealMatrix n → Set.{0} ℝ :=
fun {n} L U => Set.ofPred.{0} fun lam => ∃ A, NLA.IV06.InIntervalFamily L U A ∧ NLA.IV06.HasRealEigenvalue A lam
def NLA.IV06.characteristicDet : {n : ℕ} → NLA.IV06.RealMatrix n → ℝ → ℝ :=
fun {n} A lam => Matrix.det.{0, 0} (HSub.hSub.{0, 0, 0} (HSMul.hSMul.{0, 0, 0} lam 1) A)
def NLA.IV06.componentCard : Set.{0} ℝ → Cardinal.{0} :=
fun S => Cardinal.mk.{0} (ConnectedComponents.{0} ↑S)
def NLA.IV06.ComponentBoundConjecture : Prop :=
∀ (n : ℕ),
  LE.le.{0} 1 n →
    ∀ (L U : NLA.IV06.RealMatrix n),
      NLA.IV06.EntrywiseLE L U → LE.le.{1} (NLA.IV06.componentCard (NLA.IV06.realEigenvalueSet L U)) ↑n
