theorem NLA.IV06.connected_component_intervals_proved : ∀ (S : Set ℝ) (x y : ↑S),
  ConnectedComponents.mk x = ConnectedComponents.mk y → Set.Icc ↑x ↑y ⊆ S :=
fun S x y h =>
  have hx := ConnectedComponents.coe_eq_coe'.mp h;
  have hpre :=
    IsPreconnected.image isPreconnected_connectedComponent Subtype.val (Continuous.continuousOn continuous_subtype_val);
  have hleft := Exists.intro x ⟨hx, rfl⟩;
  have hright := Exists.intro y ⟨mem_connectedComponent, rfl⟩;
  fun ⦃z⦄ hz =>
  Exists.casesOn (IsPreconnected.Icc_subset hpre hleft hright hz) fun u h =>
    And.casesOn h fun left right =>
      Eq.ndrec (motive := fun ⦃z⦄ => z ∈ Set.Icc ↑x ↑y → z ∈ S) (fun hz => u.property) right hz
theorem NLA.IV06.four_components_proved : (∃ f,
    (∀ (i : Fin 4), ↑(f i) = NLA.IV06.includedValue i) ∧ Function.Injective fun i => ConnectedComponents.mk (f i)) ∧
  4 ≤ NLA.IV06.componentCard (NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper) :=
let f := fun i => ⟨NLA.IV06.includedValue i, (NLA.IV06.witness_eigenpairs_proved i).right.right.right⟩;
have hsep := fun i j hij h =>
  Exists.casesOn (NLA.IV06.ordered_pair_separator i j hij) fun k h_1 =>
    And.casesOn h_1 fun hki hkj =>
      have hbetween :=
        NLA.IV06.connected_component_intervals_proved (NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper) (f i)
          (f j) h;
      NLA.IV06.witness_separators_proved.right.right k (hbetween ⟨hki, hkj⟩);
have hinj := fun ⦃i j⦄ h =>
  Or.casesOn (lt_trichotomy i j) (fun hij => False.elim (hsep i j hij h)) fun h_1 =>
    Or.casesOn h_1 (fun heq => heq) fun hji => False.elim (hsep j i hji (Eq.symm h));
⟨Exists.intro f ⟨fun x => rfl, hinj⟩,
  id
    (Eq.mp
      (congrFun' (congrArg LE.le (Eq.trans (Cardinal.mk_fintype (Fin 4)) (congrArg Nat.cast (Fintype.card_fin 4))))
        (Cardinal.mk (ConnectedComponents ↑(NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper))))
      (Cardinal.mk_le_of_injective hinj))⟩
