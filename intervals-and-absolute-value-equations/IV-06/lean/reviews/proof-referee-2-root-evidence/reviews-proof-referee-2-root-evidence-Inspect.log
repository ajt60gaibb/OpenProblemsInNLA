def NLA.IV06.HasRealEigenvalue : {n : Nat} → NLA.IV06.RealMatrix n → Real → Prop :=
fun {n} A lam =>
  ∃ v,
    And
      (@Ne (Fin n → Real) v
        (@OfNat.ofNat (Fin n → Real) (nat_lit 0)
          (@Zero.toOfNat0 (Fin n → Real) (@Pi.instZero (Fin n) (fun a => Real) fun i => Real.instZero))))
      (@Eq (Fin n → Real)
        (@Matrix.mulVec (Fin n) (Fin n) Real
          (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring Real
            (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing Real
              (@NonUnitalCommRing.toNonUnitalNonAssocCommRing Real (@CommRing.toNonUnitalCommRing Real Real.commRing))))
          (Fin.fintype n) A v)
        (@HSMul.hSMul Real (Fin n → Real) (Fin n → Real)
          (@instHSMul Real (Fin n → Real) (@Function.hasSMul (Fin n) Real Real (@instSMulOfMul Real Real.instMul))) lam
          v))
def NLA.IV06.characteristicDet : {n : Nat} → NLA.IV06.RealMatrix n → Real → Real :=
fun {n} A lam =>
  @Matrix.det (Fin n) (instDecidableEqFin n) (Fin.fintype n) Real Real.commRing
    (@HSub.hSub (NLA.IV06.RealMatrix n) (NLA.IV06.RealMatrix n) (NLA.IV06.RealMatrix n)
      (@instHSub (NLA.IV06.RealMatrix n) (@Matrix.sub (Fin n) (Fin n) Real Real.instSub))
      (@HSMul.hSMul Real (NLA.IV06.RealMatrix n) (NLA.IV06.RealMatrix n)
        (@instHSMul Real (NLA.IV06.RealMatrix n)
          (@Matrix.smul (Fin n) (Fin n) Real Real (@instSMulOfMul Real Real.instMul)))
        lam
        (@OfNat.ofNat (NLA.IV06.RealMatrix n) (nat_lit 1)
          (@One.toOfNat1 (NLA.IV06.RealMatrix n)
            (@Matrix.one (Fin n) Real (instDecidableEqFin n) Real.instZero Real.instOne))))
      A)
def NLA.IV06.realEigenvalueSet : {n : Nat} → NLA.IV06.RealMatrix n → NLA.IV06.RealMatrix n → Set Real :=
fun {n} L U =>
  @Set.ofPred Real fun lam => ∃ A, And (@NLA.IV06.InIntervalFamily n L U A) (@NLA.IV06.HasRealEigenvalue n A lam)
def NLA.IV06.componentCard : Set Real → Cardinal.{0} :=
fun S =>
  Cardinal.mk
    (@ConnectedComponents (@Set.Elem Real S)
      (@instTopologicalSpaceSubtype Real (fun x => @Membership.mem Real (Set Real) (@Set.instMembership Real) S x)
        (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))))
def NLA.IV06.ComponentBoundConjecture : Prop :=
∀ (n : Nat),
  @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) n →
    ∀ (L U : NLA.IV06.RealMatrix n),
      @NLA.IV06.EntrywiseLE n L U →
        @LE.le Cardinal.{0} Cardinal.instLE (NLA.IV06.componentCard (@NLA.IV06.realEigenvalueSet n L U))
          (@Nat.cast Cardinal.{0} Cardinal.instNatCast n)
def ConnectedComponents.{u} : (α : Type u) → [TopologicalSpace α] → Type u :=
fun α [TopologicalSpace α] => Quotient (connectedComponentSetoid α)
@[defeq] theorem Real.dist_eq : ∀ (x y : ℝ), dist x y = |x - y| :=
fun x y => rfl
@Matrix.exists_mulVec_eq_zero_iff : ∀ {n : Type u_1} [inst : Fintype n] {A : Type u_2} [inst_1 : CommRing A]
  [IsDomain A] {M : Matrix n n A} [inst_3 : DecidableEq n], (∃ v, v ≠ 0 ∧ M.mulVec v = 0) ↔ M.det = 0
@IsPreconnected.Icc_subset : ∀ {α : Type u_1} [inst : LinearOrder α] [inst_1 : TopologicalSpace α]
  [OrderClosedTopology α] {s : Set α}, IsPreconnected s → ∀ {a b : α}, a ∈ s → b ∈ s → Set.Icc a b ⊆ s
@Cardinal.mk_le_of_injective : ∀ {α β : Type u_1} {f : α → β}, Function.Injective f → Cardinal.mk α ≤ Cardinal.mk β
NLA.IV06.eigenvalue_determinant_semantics : ∀ (n : ℕ) (A : NLA.IV06.RealMatrix n) (lam : ℝ),
  NLA.IV06.HasRealEigenvalue A lam ↔ NLA.IV06.characteristicDet A lam = 0
NLA.IV06.family_and_determinant_semantics : NLA.IV06.EntrywiseLE NLA.IV06.lower NLA.IV06.upper ∧
  (∀ (A : NLA.IV06.RealMatrix 3),
      NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper A ↔
        ∃ a b, a ∈ Set.Icc (-166) (-16) ∧ b ∈ Set.Icc 9 159 ∧ A = NLA.IV06.family a b) ∧
    ∀ (a b lam : ℝ),
      NLA.IV06.characteristicDet (NLA.IV06.family a b) lam = (lam - 25) * (lam ^ 2 - 1) - a * (lam - 1) - b * (lam + 1)
NLA.IV06.witness_eigenpairs : ∀ (i : Fin 4),
  NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper
      (NLA.IV06.family (NLA.IV06.includedA i) (NLA.IV06.includedB i)) ∧
    NLA.IV06.includedVector i ≠ 0 ∧
      Matrix.mulVec (NLA.IV06.family (NLA.IV06.includedA i) (NLA.IV06.includedB i)) (NLA.IV06.includedVector i) =
          NLA.IV06.includedValue i • NLA.IV06.includedVector i ∧
        NLA.IV06.includedValue i ∈ NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper
NLA.IV06.witness_separators : (∀ (A : NLA.IV06.RealMatrix 3),
    NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper A →
      ∀ (j : Fin 3),
        NLA.IV06.determinantLower j ≤ NLA.IV06.characteristicDet A (NLA.IV06.separator j) ∧
          NLA.IV06.characteristicDet A (NLA.IV06.separator j) ≤ NLA.IV06.determinantUpper j) ∧
  (∀ (j : Fin 3), NLA.IV06.determinantUpper j < 0) ∧
    ∀ (j : Fin 3), NLA.IV06.separator j ∉ NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper
NLA.IV06.connected_component_intervals : ∀ (S : Set ℝ) (x y : ↑S),
  ConnectedComponents.mk x = ConnectedComponents.mk y → Set.Icc ↑x ↑y ⊆ S
NLA.IV06.four_components : (∃ f,
    (∀ (i : Fin 4), ↑(f i) = NLA.IV06.includedValue i) ∧ Function.Injective fun i => ConnectedComponents.mk (f i)) ∧
  4 ≤ NLA.IV06.componentCard (NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper)
NLA.IV06.counterexample : NLA.IV06.EntrywiseLE NLA.IV06.lower NLA.IV06.upper ∧
  3 < NLA.IV06.componentCard (NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper)
NLA.IV06.not_componentBoundConjecture : ¬NLA.IV06.ComponentBoundConjecture
