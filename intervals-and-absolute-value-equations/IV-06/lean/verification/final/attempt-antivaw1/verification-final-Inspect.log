NLA.IV06.eigenvalue_determinant_semantics (n : ℕ) (A : NLA.IV06.RealMatrix n) (lam : ℝ) :
  NLA.IV06.HasRealEigenvalue A lam ↔ NLA.IV06.characteristicDet A lam = 0
NLA.IV06.family_and_determinant_semantics :
  NLA.IV06.EntrywiseLE NLA.IV06.lower NLA.IV06.upper ∧
    (∀ (A : NLA.IV06.RealMatrix 3),
        NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper A ↔
          ∃ a b, a ∈ Set.Icc (-166) (-16) ∧ b ∈ Set.Icc 9 159 ∧ A = NLA.IV06.family a b) ∧
      ∀ (a b lam : ℝ),
        NLA.IV06.characteristicDet (NLA.IV06.family a b) lam =
          (lam - 25) * (lam ^ 2 - 1) - a * (lam - 1) - b * (lam + 1)
NLA.IV06.witness_eigenpairs (i : Fin 4) :
  NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper
      (NLA.IV06.family (NLA.IV06.includedA i) (NLA.IV06.includedB i)) ∧
    NLA.IV06.includedVector i ≠ 0 ∧
      Matrix.mulVec (NLA.IV06.family (NLA.IV06.includedA i) (NLA.IV06.includedB i)) (NLA.IV06.includedVector i) =
          NLA.IV06.includedValue i • NLA.IV06.includedVector i ∧
        NLA.IV06.includedValue i ∈ NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper
NLA.IV06.witness_separators :
  (∀ (A : NLA.IV06.RealMatrix 3),
      NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper A →
        ∀ (j : Fin 3),
          NLA.IV06.determinantLower j ≤ NLA.IV06.characteristicDet A (NLA.IV06.separator j) ∧
            NLA.IV06.characteristicDet A (NLA.IV06.separator j) ≤ NLA.IV06.determinantUpper j) ∧
    (∀ (j : Fin 3), NLA.IV06.determinantUpper j < 0) ∧
      ∀ (j : Fin 3), NLA.IV06.separator j ∉ NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper
NLA.IV06.connected_component_intervals (S : Set ℝ) (x y : ↑S)
  (h : ConnectedComponents.mk x = ConnectedComponents.mk y) : Set.Icc ↑x ↑y ⊆ S
NLA.IV06.four_components :
  (∃ f, (∀ (i : Fin 4), ↑(f i) = NLA.IV06.includedValue i) ∧ Function.Injective fun i => ConnectedComponents.mk (f i)) ∧
    4 ≤ NLA.IV06.componentCard (NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper)
