theorem NLA.IV06.witness_separators_proved : (∀ (A : NLA.IV06.RealMatrix 3),
    NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper A →
      ∀ (j : Fin 3),
        NLA.IV06.determinantLower j ≤ NLA.IV06.characteristicDet A (NLA.IV06.separator j) ∧
          NLA.IV06.characteristicDet A (NLA.IV06.separator j) ≤ NLA.IV06.determinantUpper j) ∧
  (∀ (j : Fin 3), NLA.IV06.determinantUpper j < 0) ∧
    ∀ (j : Fin 3), NLA.IV06.separator j ∉ NLA.IV06.realEigenvalueSet NLA.IV06.lower NLA.IV06.upper :=
have hbounds := fun A hA j =>
  Exists.casesOn ((NLA.IV06.interval_family_iff A).mp hA) fun a h =>
    Exists.casesOn h fun b h =>
      And.casesOn h fun ha right =>
        And.casesOn right fun hb right =>
          Eq.ndrec (motive := fun A =>
            NLA.IV06.InIntervalFamily NLA.IV06.lower NLA.IV06.upper A →
              NLA.IV06.determinantLower j ≤ NLA.IV06.characteristicDet A (NLA.IV06.separator j) ∧
                NLA.IV06.characteristicDet A (NLA.IV06.separator j) ≤ NLA.IV06.determinantUpper j)
            (fun hA =>
              Eq.mpr
                (id
                  (congrArg (fun _a => NLA.IV06.determinantLower j ≤ _a ∧ _a ≤ NLA.IV06.determinantUpper j)
                    (NLA.IV06.family_characteristicDet a b (NLA.IV06.separator j))))
                (List.Mem.casesOn (motive := fun a_1 x =>
                  List.finRange 3 = a_1 →
                    Fintype.complete j ≍ x →
                      NLA.IV06.determinantLower j ≤
                          (NLA.IV06.separator j - 25) * (NLA.IV06.separator j ^ 2 - 1) -
                              a * (NLA.IV06.separator j - 1) -
                            b * (NLA.IV06.separator j + 1) ∧
                        (NLA.IV06.separator j - 25) * (NLA.IV06.separator j ^ 2 - 1) - a * (NLA.IV06.separator j - 1) -
                            b * (NLA.IV06.separator j + 1) ≤
                          NLA.IV06.determinantUpper j)
                  (Fintype.complete j)
                  (fun as h =>
                    List.cons.noConfusion h fun head_eq =>
                      Eq.ndrec (motive := fun j =>
                        ∀ (this : j ∈ Fintype.elems),
                          (fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_of_lt (Nat.le_refl 3)⟩
                                ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨2, Nat.le_refl 3⟩ []) ≍
                              as →
