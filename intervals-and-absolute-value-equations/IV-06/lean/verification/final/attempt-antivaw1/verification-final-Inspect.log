def NLA.IV06.realEigenvalueSet : {n : Nat} → (L U : NLA.IV06.RealMatrix n) → Set.{0} Real :=
fun {n : Nat} (L U : NLA.IV06.RealMatrix n) =>
  @Set.ofPred.{0} Real fun (lam : Real) =>
    @Exists.{1} (NLA.IV06.RealMatrix n) fun (A : NLA.IV06.RealMatrix n) =>
      And (@NLA.IV06.InIntervalFamily n L U A) (@NLA.IV06.HasRealEigenvalue n A lam)
