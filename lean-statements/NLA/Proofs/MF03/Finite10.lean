private theorem Q10_coeff_zero : Q10.coeff 0 = 1 := by
  classical
  norm_num [Q10, Polynomial.ofFn_coeff_eq_val_of_lt]

/-- The exact rational pair satisfies every Padé equation through degree 20. -/
theorem finite10_normalized : NormalizedPadeRepresentation 10 P10 Q10 := by
  refine ⟨P10_degree, Q10_degree, ?_, ?_⟩
  · simpa only [Polynomial.coeff_zero_eq_eval_zero] using Q10_coeff_zero
  · intro j hj
    interval_cases j <;>
      norm_num [P10, Q10, Finset.sum_range_succ,
        Polynomial.ofFn_coeff_eq_val_of_lt,
        Polynomial.ofFn_coeff_eq_zero_of_ge]

/-- The explicit rational pair satisfies the full closed-disk estimate. -/
theorem finite10_disk : ∀ z : ℂ, ‖z‖ ≤ (3 : ℝ) →
    Q10.eval z ≠ 0 ∧ ‖(1 : ℂ) - P10.eval z / Q10.eval z‖ ≤ (2 : ℝ) := by
  apply disk_bound_of_coefficient_tail P10 Q10 10
    P10_degree Q10_degree Q10_coeff_zero
  · norm_num [Q10, Finset.sum_range_succ,
      Polynomial.ofFn_coeff_eq_val_of_lt]
  · norm_num [P10, Q10, Finset.sum_range_succ,
      Polynomial.ofFn_coeff_eq_val_of_lt]

#print axioms finite10_normalized
#assert_trust kernel finite10_normalized
#print axioms finite10_disk
#assert_trust kernel finite10_disk

