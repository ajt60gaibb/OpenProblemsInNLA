import NLA.Proofs.MF03.Disk
import Mathlib.Algebra.Polynomial.OfFn

/-! Exact rational MF-03 certificate for Padé order 8. -/
set_option autoImplicit false
set_option leancert.trust "kernel"
set_option maxHeartbeats 2000000

namespace NLA.Proofs.MF03

open NLA.Statements.MF03

private noncomputable def P08 : Polynomial ℂ := by
  classical
  exact Polynomial.ofFn 9 ![
    (1 : ℂ),
    1126682407530029115789472765/2304577612359442026681336372,
    145053661043845297596963732421/4009965045505429126425525287280,
    1534672316720770887322573595/1603986018202171650570210114912,
