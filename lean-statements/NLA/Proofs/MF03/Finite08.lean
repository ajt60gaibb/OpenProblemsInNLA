    6524116556754642812271854422129/23929713422900451446378509964201096448000,
    382586638331055978467487427009/763836452458982410168402038057298998620160,
    88555612088268453352055067469523/233733954452448617511531023645533493577768960000]

private noncomputable def Q08 : Polynomial ℂ := by
