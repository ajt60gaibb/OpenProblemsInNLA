    2603898999593850290644763/1931685573987178657120091104508541269237760000])
  dsimp only [Q08]
  omega

private theorem Q08_coeff_zero : Q08.coeff 0 = 1 := by
  classical
  norm_num [Q08, Polynomial.ofFn_coeff_eq_val_of_lt]

/-- The exact rational pair satisfies every Padé equation through degree 16. -/
theorem finite08_normalized : NormalizedPadeRepresentation 8 P08 Q08 := by
  refine ⟨P08_degree, Q08_degree, ?_, ?_⟩
  · simpa only [Polynomial.coeff_zero_eq_eval_zero] using Q08_coeff_zero
  · intro j hj
    interval_cases j <;>
      norm_num [P08, Q08, Finset.sum_range_succ,
        Polynomial.ofFn_coeff_eq_val_of_lt,
        Polynomial.ofFn_coeff_eq_zero_of_ge]

/-- The explicit rational pair satisfies the full closed-disk estimate. -/
theorem finite08_disk : ∀ z : ℂ, ‖z‖ ≤ (3 : ℝ) →
    Q08.eval z ≠ 0 ∧ ‖(1 : ℂ) - P08.eval z / Q08.eval z‖ ≤ (2 : ℝ) := by
  apply disk_bound_of_coefficient_tail P08 Q08 8
    P08_degree Q08_degree Q08_coeff_zero
  · norm_num [Q08, Finset.sum_range_succ,
      Polynomial.ofFn_coeff_eq_val_of_lt]
  · norm_num [P08, Q08, Finset.sum_range_succ,
      Polynomial.ofFn_coeff_eq_val_of_lt]

#print axioms finite08_normalized
#assert_trust kernel finite08_normalized
#print axioms finite08_disk
#assert_trust kernel finite08_disk

end NLA.Proofs.MF03
