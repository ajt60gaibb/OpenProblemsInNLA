/-- The exact rational pair satisfies every Padé equation through degree 18. -/
theorem finite09_normalized : NormalizedPadeRepresentation 9 P09 Q09 := by
  refine ⟨P09_degree, Q09_degree, ?_, ?_⟩
  · simpa only [Polynomial.coeff_zero_eq_eval_zero] using Q09_coeff_zero
  · intro j hj
    interval_cases j <;>
      norm_num [P09, Q09, Finset.sum_range_succ,
        Polynomial.ofFn_coeff_eq_val_of_lt,
        Polynomial.ofFn_coeff_eq_zero_of_ge]

/-- The explicit rational pair satisfies the full closed-disk estimate. -/
theorem finite09_disk : ∀ z : ℂ, ‖z‖ ≤ (3 : ℝ) →
    Q09.eval z ≠ 0 ∧ ‖(1 : ℂ) - P09.eval z / Q09.eval z‖ ≤ (2 : ℝ) := by
  apply disk_bound_of_coefficient_tail P09 Q09 9
    P09_degree Q09_degree Q09_coeff_zero
  · norm_num [Q09, Finset.sum_range_succ,
      Polynomial.ofFn_coeff_eq_val_of_lt]
  · norm_num [P09, Q09, Finset.sum_range_succ,
      Polynomial.ofFn_coeff_eq_val_of_lt]

#print axioms finite09_normalized
#assert_trust kernel finite09_normalized
#print axioms finite09_disk
#assert_trust kernel finite09_disk

