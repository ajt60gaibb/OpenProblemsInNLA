theorem NLA.TR15.upper_negative_eigenpair_proved : NLA.TR15.IsHEigenpair NLA.TR15.witnessUpper (-1)
    NLA.TR15.witnessUpperVector ∧
  -1 < 0 :=
⟨⟨fun hz =>
    have this := congrFun hz 1;
    False.elim
      (Eq.mp
        (Eq.trans (Eq.trans (congrFun' (congrArg Eq (Matrix.cons_val_fin_one 1 ![] 0)) 0) one_ne_zero._simp_1)
          (eq_false not_false))
        this),
    fun i =>
    Eq.mpr
      (id (congrArg (fun _a => _a i = -1 * NLA.TR15.witnessUpperVector i ^ (6 - 1)) NLA.TR15.upper_contraction_proved))
      (List.Mem.casesOn (motive := fun a x =>
        List.finRange 2 = a → Fintype.complete i ≍ x → ![0, -1] i = -1 * NLA.TR15.witnessUpperVector i ^ (6 - 1))
        (Fintype.complete i)
        (fun as h =>
          List.cons.noConfusion h fun head_eq =>
            Eq.ndrec (motive := fun i =>
              ∀ (this : i ∈ Fintype.elems),
