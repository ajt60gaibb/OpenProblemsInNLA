                              [] ≍ as →
                                a ≍ List.Mem.head as → ![0, -1] i = -1 * NLA.TR15.witnessUpperVector i ^ (6 - 1))
                            (fun a tail_eq =>
                              Eq.ndrec (motive := fun as =>
