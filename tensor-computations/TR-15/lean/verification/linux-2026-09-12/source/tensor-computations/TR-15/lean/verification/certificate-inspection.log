theorem NLA.TR15.counterexample_proved : NLA.TR15.Admissible 3 2 2 ∧
  NLA.TR15.HasNoNegativeHEigenvalues NLA.TR15.witnessLower ∧
    ¬NLA.TR15.HasNoNegativeHEigenvalues NLA.TR15.witnessUpper :=
⟨⟨Exists.intro 1 rfl,
    ⟨Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 3))
        (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 3)) (Eq.refl true),
      ⟨Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 2))
          (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 2)) (Eq.refl true),
        Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 2))
          (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 2)) (Eq.refl true)⟩⟩⟩,
  ⟨fun eigenvalue x h => LT.lt.le (NLA.TR15.lower_eigenvalues_pos_proved eigenvalue x h), fun h =>
    not_le_of_gt NLA.TR15.upper_negative_eigenpair_proved.right
      (h (-1) NLA.TR15.witnessUpperVector NLA.TR15.upper_negative_eigenpair_proved.left)⟩⟩
theorem NLA.TR15.not_inheritanceConjecture_proved : ¬NLA.TR15.InheritanceConjecture :=
fun h =>
  NLA.TR15.counterexample_proved.right.right
    (h 3 2 2 NLA.TR15.counterexample_proved.left NLA.TR15.witnessGenerator NLA.TR15.counterexample_proved.right.left)
