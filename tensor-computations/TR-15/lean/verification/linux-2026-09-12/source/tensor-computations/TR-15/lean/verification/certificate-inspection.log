                  (fun h =>
                    of_eq_true
                      (Eq.trans
                        (Eq.trans
                          (congrArg (Eq 0)
                            (Eq.trans
                              (congrArg (HMul.hMul (-1))
                                (Eq.trans
                                  (congrArg (HPow.hPow 0)
                                    (Mathlib.Meta.NormNum.IsNat.to_eq
                                      (Mathlib.Meta.NormNum.isNat_natSub
                                        (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 6))
                                        (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 1)) (Eq.refl 5))
