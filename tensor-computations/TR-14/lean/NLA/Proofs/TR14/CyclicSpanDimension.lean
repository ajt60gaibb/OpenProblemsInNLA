import NLA.Statements.TR14
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.Dimension.Constructions

/-! The actual dimension of the first n terms of a cyclic linear orbit.
Saturation is proved from invariance, rather than assumed as a rank premise. -/
set_option autoImplicit false
set_option leancert.trust "kernel"

namespace NLA.Proofs.TR14

noncomputable section
variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- The first n orbit vectors with the literal finite index domain. -/
def cyclicPrefix (T : Module.End K V) (x : V) (n : ℕ) : Submodule K V :=
  Submodule.span K (Set.range (fun k : Fin n => (T ^ k.val) x))

/-- The subspace generated by the entire actual cyclic orbit. -/
def cyclicSpan (T : Module.End K V) (x : V) : Submodule K V :=
  Submodule.span K (Set.range (fun k : ℕ => (T ^ k) x))

theorem cyclicPrefix_le_span (T : Module.End K V) (x : V) (n : ℕ) :
    cyclicPrefix T x n ≤ cyclicSpan T x := by
  apply Submodule.span_mono
  rintro _ ⟨k, rfl⟩
  exact ⟨k.val, rfl⟩

theorem cyclicPrefix_mono (T : Module.End K V) (x : V) {n m : ℕ} (hnm : n ≤ m) :
    cyclicPrefix T x n ≤ cyclicPrefix T x m := by
  apply Submodule.span_mono
  rintro _ ⟨k, rfl⟩
  exact ⟨Fin.castLE hnm k, rfl⟩

theorem cyclicPrefix_succ (T : Module.End K V) (x : V) (n : ℕ) :
    cyclicPrefix T x (n + 1) = cyclicPrefix T x n ⊔ Submodule.span K {(T ^ n) x} := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨k, rfl⟩
    by_cases hk : k.val < n
    · exact Submodule.mem_sup_left (Submodule.subset_span ⟨⟨k.val, hk⟩, rfl⟩)
    · have hval : k.val = n := by have hi := k.isLt; omega
      exact Submodule.mem_sup_right (Submodule.subset_span (by simp [hval]))
  · apply sup_le (cyclicPrefix_mono T x (Nat.le_succ n))
    apply Submodule.span_le.mpr
    rintro _ rfl
    exact Submodule.subset_span ⟨Fin.last n, rfl⟩

/-- Once the next orbit vector lies in the prefix, linear invariance forces
the prefix to contain the entire orbit. -/
theorem cyclicPrefix_eq_span_of_next_mem (T : Module.End K V) (x : V) (n : ℕ)
    (hn : (T ^ n) x ∈ cyclicPrefix T x n) : cyclicPrefix T x n = cyclicSpan T x := by
  have hstable : ∀ y ∈ cyclicPrefix T x n, T y ∈ cyclicPrefix T x n := by
    intro y hy
    refine Submodule.span_induction (fun z hz => ?_) (by simp)
      (fun a b _ _ ha hb => ?_) (fun c a _ ha => ?_) hy
    · obtain ⟨k, rfl⟩ := hz
      have heq : T ((T ^ k.val) x) = (T ^ (k.val + 1)) x := by
        rw [pow_succ']
        rfl
      rw [heq]
      by_cases hk : k.val + 1 < n
      · exact Submodule.subset_span ⟨⟨k.val + 1, hk⟩, rfl⟩
      · have hval : k.val + 1 = n := by have hi := k.isLt; omega
        simpa only [hval] using hn
    · simpa only [map_add] using (cyclicPrefix T x n).add_mem ha hb
    · simpa only [map_smul] using (cyclicPrefix T x n).smul_mem c ha
  have hx : x ∈ cyclicPrefix T x n := by
    have hle : cyclicPrefix T x (n + 1) ≤ cyclicPrefix T x n := by
      rw [cyclicPrefix_succ]
      exact sup_le le_rfl (Submodule.span_le.mpr (by rintro _ rfl; exact hn))
    exact hle (Submodule.subset_span ⟨⟨0, by omega⟩, rfl⟩)
  apply le_antisymm (cyclicPrefix_le_span T x n)
  apply Submodule.span_le.mpr
  rintro _ ⟨k, rfl⟩
  change (T ^ k) x ∈ cyclicPrefix T x n
  induction k with
  | zero => simpa only [pow_zero, Module.End.one_apply] using hx
  | succ k ih =>
    rw [pow_succ']
    exact hstable _ ih

/-- A cyclic prefix has the full possible dimension until its actual
orbit span is exhausted; subsequent prefixes retain that dimension. -/
theorem cyclicPrefix_finrank [FiniteDimensional K V]
    (T : Module.End K V) (x : V) (n : ℕ) :
    Module.finrank K (cyclicPrefix T x n) = min n (Module.finrank K (cyclicSpan T x)) := by
  induction n with
  | zero =>
    have hz : cyclicPrefix T x 0 = ⊥ := by
      apply le_antisymm
      · apply Submodule.span_le.mpr
        rintro _ ⟨k, rfl⟩
        exact Fin.elim0 k
      · exact bot_le
    rw [hz]
    simp
  | succ n ih =>
    by_cases hn : cyclicPrefix T x n = cyclicSpan T x
    · have hs : cyclicPrefix T x (n + 1) = cyclicSpan T x := by
        apply le_antisymm (cyclicPrefix_le_span T x (n + 1))
        rw [← hn]
        exact cyclicPrefix_mono T x (Nat.le_succ n)
      rw [hs]
      rw [hn] at ih
      omega
    · have hnext : (T ^ n) x ∉ cyclicPrefix T x n :=
        fun h => hn (cyclicPrefix_eq_span_of_next_mem T x n h)
      have hlt : Module.finrank K (cyclicPrefix T x n) <
          Module.finrank K (cyclicSpan T x) :=
        Submodule.finrank_lt_finrank_of_lt
          (lt_of_le_of_ne (cyclicPrefix_le_span T x n) hn)
      rw [cyclicPrefix_succ, Submodule.finrank_sup_span_singleton hnext, ih]
      omega

#assert_trust kernel cyclicPrefix_eq_span_of_next_mem
#assert_trust kernel cyclicPrefix_finrank
#print axioms cyclicPrefix_finrank

end
end NLA.Proofs.TR14
