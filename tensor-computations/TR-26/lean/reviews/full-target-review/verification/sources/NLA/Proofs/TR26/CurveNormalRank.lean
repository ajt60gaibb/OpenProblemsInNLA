import NLA.Proofs.TR26.CurveEquations

/-! The actual full incidence ideal contains d−1 independent curve normals
on its first affine chart. This supplies a rank lower bound without
asserting equality with an ideal generated by selected equations. -/
set_option autoImplicit false
set_option leancert.trust "kernel"
noncomputable section
open scoped BigOperators
namespace NLA.Proofs.TR26
open NLA.Statements.TR26

def normalCurveIndex (d : ℕ) (hd : 1 ≤ d) (k : Fin (d-1)) : Index d :=
  ⟨k.val+2,by omega⟩

theorem normalCurveIndex_injective (d : ℕ) (hd : 1 ≤ d) :
    Function.Injective (normalCurveIndex d hd) := by
  intro i j hij
  apply Fin.ext
  have h := congrArg Fin.val hij
  simpa [normalCurveIndex] using h

theorem partialGradient_affineCurveEquation_tail
    (d : ℕ) (hd : 1 ≤ d) (i j : Index d) (hj : 2 ≤ j.val)
    (z : CurveVector d) (H : Parameter d) :
    partialGradient (Sum.inl : Index d → IncidenceVariable d)
      (incidenceCoordinates z H) (affineCurveEquation d hd i) j =
      if i=j then z 0 ^ (i.val-1) else 0 := by
  classical
  have hj0 : j ≠ 0 := by intro h; subst j; simp at hj
  have hj1 : j ≠ chartFirstIndex d hd := by
    intro h
    have hv := congrArg Fin.val h
    simp only [chartFirstIndex] at hv
    omega
  by_cases hij : i=j <;>
    simp [partialGradient,affineCurveEquation,MvPolynomial.pderiv_X,Pi.single_apply,
      hj0,hj1,hij,eq_comm,incidenceCoordinates]

def affineNormalVector (d : ℕ) (hd : 1 ≤ d) (z : CurveVector d) (H : Parameter d)
    (k : Fin (d-1)) : CurveVector d :=
  partialGradient (Sum.inl : Index d → IncidenceVariable d)
    (incidenceCoordinates z H) (affineCurveEquation d hd (normalCurveIndex d hd k))

theorem affineNormalVector_tail (d : ℕ) (hd : 1 ≤ d)
    (z : CurveVector d) (H : Parameter d) (k l : Fin (d-1)) :
    affineNormalVector d hd z H k (normalCurveIndex d hd l) =
      if k=l then z 0 ^ (k.val+1) else 0 := by
  rw [affineNormalVector,partialGradient_affineCurveEquation_tail d hd _ _ (by
    simp only [normalCurveIndex]; omega)]
  simp [normalCurveIndex,Fin.ext_iff]

theorem affineNormalVectors_independent (d : ℕ) (hd : 1 ≤ d)
    (z : CurveVector d) (H : Parameter d) (hz : z 0 ≠ 0) :
    LinearIndependent ℂ (affineNormalVector d hd z H) := by
  classical
  apply Fintype.linearIndependent_iff.mpr
  intro a ha k
  have hh := congrFun ha (normalCurveIndex d hd k)
  simp only [Finset.sum_apply,Pi.smul_apply,smul_eq_mul,Pi.zero_apply,
    affineNormalVector_tail] at hh
  have he : a k * z 0 ^ (k.val+1) = 0 := by
    simpa [mul_ite] using hh
  exact (mul_eq_zero.mp he).resolve_right (pow_ne_zero _ hz)

theorem affineNormalVector_mem_jacobianSpace (d : ℕ) (hd : 1 ≤ d)
    (z : CurveVector d) (H : Parameter d) (k : Fin (d-1)) :
    affineNormalVector d hd z H k ∈ JacobianSpace d z H := by
  rw [jacobianSpace_eq_conormal]
  apply gradient_mem_conormal
  exact affineCurveEquation_mem_openVanishingIdeal d hd _ (by
    simp only [normalCurveIndex]; omega)

theorem affineCurve_jacobian_rank_lower (d : ℕ) (hd : 1 ≤ d)
    (z : CurveVector d) (H : Parameter d) (hz : z 0 ≠ 0) :
    d-1 ≤ Module.finrank ℂ (JacobianSpace d z H) := by
  have hle : Submodule.span ℂ (Set.range (affineNormalVector d hd z H)) ≤
      JacobianSpace d z H := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k,rfl⟩
    exact affineNormalVector_mem_jacobianSpace d hd z H k
  have hh := Submodule.finrank_mono hle
  rw [finrank_span_eq_card (affineNormalVectors_independent d hd z H hz),
    Fintype.card_fin] at hh
  convert! hh using 1

#assert_trust kernel normalCurveIndex_injective
#assert_trust kernel partialGradient_affineCurveEquation_tail
#assert_trust kernel affineNormalVector_tail
#assert_trust kernel affineNormalVectors_independent
#assert_trust kernel affineNormalVector_mem_jacobianSpace
#assert_trust kernel affineCurve_jacobian_rank_lower
#print axioms affineNormalVectors_independent
#print axioms affineCurve_jacobian_rank_lower
end NLA.Proofs.TR26
