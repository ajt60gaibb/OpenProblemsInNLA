NLA.TR13.generic_vandermonde_upper (m n : ℕ) (hm : 5 ≤ m) (_hodd : Odd m) (hn : 2 ≤ n) :
  ∃ p,
    p ≠ 0 ∧
      ∀ (h : NLA.TR13.Moments m n),
        (MvPolynomial.eval h) p ≠ 0 → NLA.TR13.VandermondeRankAtMost (NLA.TR13.expectedRank m n) (NLA.TR13.hankel h)
'NLA.TR13.generic_vandermonde_upper' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.TR13.prony_representation' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.TR13.upperPolynomial_ne_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
