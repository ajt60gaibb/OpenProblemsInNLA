theorem NLA.FR12.not_countingConjecture_proved : ¬NLA.FR12.CountingConjecture :=
fun a =>
  Exists.casesOn a fun C h =>
    And.casesOn h fun hC hbound =>
      Exists.casesOn (NLA.FR12.counterexample_proved C hC) fun k hk =>
        have hn :=
          Nat.one_le_pow (k + 2) 2
            (Decidable.byContradiction fun a => NLA.FR12.not_countingConjecture_proved._proof_1_1 a);
        have hd :=
          Exists.intro (2 ^ k)
            (of_eq_true
              (Eq.trans (congr (congrArg Eq (pow_add 2 k 2)) (Nat.mul_comm 4 (2 ^ k))) (eq_self (2 ^ k * 4))));
        not_le_of_gt hk (hbound (2 ^ (k + 2)) hn hd)
