              (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) k
                (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))))
            (@Nat.cast Real Real.instNatCast k))
          (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd) (@Nat.cast Real Real.instNatCast k)
            (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne))))
        (@OfNat.ofNat Real (nat_lit 8) (@instOfNatAtLeastTwo Real (nat_lit 8) Real.instNatCast ⋯))))
