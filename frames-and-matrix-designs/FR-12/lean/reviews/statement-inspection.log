def NLA.FR12.IsRealHadamard : {n : Nat} → NLA.FR12.Mat n → Prop :=
fun {n} A =>
  And
    (∀ (i j : Fin n),
      Or (@Eq Real (A i j) (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)))
        (@Eq Real (A i j)
          (@Neg.neg Real Real.instNeg (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)))))
    (@Eq (Matrix (Fin n) (Fin n) Real)
      (@HMul.hMul (NLA.FR12.Mat n) (Matrix (Fin n) (Fin n) Real) (Matrix (Fin n) (Fin n) Real)
        (@Matrix.instHMulOfFintypeOfMulOfAddCommMonoid (Fin n) (Fin n) (Fin n) Real (Fin.fintype n) Real.instMul
          Real.instAddCommMonoid)
        A (@Matrix.transpose (Fin n) (Fin n) Real A))
      (@HSMul.hSMul Real (NLA.FR12.Mat n) (NLA.FR12.Mat n)
        (@instHSMul Real (NLA.FR12.Mat n) (@Matrix.smul (Fin n) (Fin n) Real Real (@instSMulOfMul Real Real.instMul)))
        (@Nat.cast Real Real.instNatCast n)
        (@OfNat.ofNat (NLA.FR12.Mat n) (nat_lit 1)
          (@One.toOfNat1 (NLA.FR12.Mat n)
            (@Matrix.one (Fin n) Real (instDecidableEqFin n) Real.instZero Real.instOne)))))
def NLA.FR12.HadamardMatrices : Nat → Type :=
fun n => @Subtype (NLA.FR12.Mat n) fun A => @NLA.FR12.IsRealHadamard n A
def NLA.FR12.hadamardCount : Nat → Nat :=
fun n => Nat.card (NLA.FR12.HadamardMatrices n)
def NLA.FR12.CountingConjecture : Prop :=
∃ C,
  And (@LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) C)
    (∀ (n : Nat),
      @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) n →
        @Dvd.dvd Nat Nat.instDvd (@OfNat.ofNat Nat (nat_lit 4) (instOfNatNat (nat_lit 4))) n →
          @LE.le Real Real.instLE (@Nat.cast Real Real.instNatCast (NLA.FR12.hadamardCount n))
            (@HPow.hPow Real Real Real (@instHPow Real Real Real.instPow)
              (@OfNat.ofNat Real (nat_lit 2)
                (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast NLA.FR12.CountingConjecture._proof_1))
              (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) C (@Nat.cast Real Real.instNatCast n))
                (@HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
                  (Real.log (@Nat.cast Real Real.instNatCast n))
                  (Real.log
                    (@OfNat.ofNat Real (nat_lit 2)
                      (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast
                        NLA.FR12.CountingConjecture._proof_1)))))))
def NLA.FR12.doublingMatrix : {m : Nat} →
  NLA.FR12.Mat m →
    NLA.FR12.Mat m → Equiv.Perm (Fin m) → NLA.FR12.Mat (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m) :=
fun {m} A B σ =>
  @DFunLike.coe
    (Equiv (Matrix (Sum (Fin m) (Fin m)) (Sum (Fin m) (Fin m)) Real)
      (Matrix (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m))
        (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m)) Real))
    (Matrix (Sum (Fin m) (Fin m)) (Sum (Fin m) (Fin m)) Real)
    (fun x =>
      Matrix (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m))
        (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m)) Real)
    (@EquivLike.toFunLike
      (Equiv (Matrix (Sum (Fin m) (Fin m)) (Sum (Fin m) (Fin m)) Real)
        (Matrix (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m))
          (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m)) Real))
      (Matrix (Sum (Fin m) (Fin m)) (Sum (Fin m) (Fin m)) Real)
      (Matrix (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m))
        (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m)) Real)
      (@Equiv.instEquivLike (Matrix (Sum (Fin m) (Fin m)) (Sum (Fin m) (Fin m)) Real)
        (Matrix (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m))
          (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m)) Real)))
    (@Matrix.reindex (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m)) (Sum (Fin m) (Fin m))
      (Sum (Fin m) (Fin m)) (Fin (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m)) Real (@finSumFinEquiv m m)
      (@finSumFinEquiv m m))
    (@Matrix.fromBlocks (Fin m) (Fin m) (Fin m) (Fin m) Real A B
      (@Matrix.submatrix (Fin m) (Fin m) (Fin m) (Fin m) Real A
        (@DFunLike.coe (Equiv.Perm (Fin m)) (Fin m) (fun x => Fin m)
          (@EquivLike.toFunLike (Equiv.Perm (Fin m)) (Fin m) (Fin m) (@Equiv.instEquivLike (Fin m) (Fin m))) σ)
        (@id (Fin m)))
      (@Neg.neg (Matrix (Fin m) (Fin m) Real) (@Matrix.neg (Fin m) (Fin m) Real Real.instNeg)
        (@Matrix.submatrix (Fin m) (Fin m) (Fin m) (Fin m) Real B
          (@DFunLike.coe (Equiv.Perm (Fin m)) (Fin m) (fun x => Fin m)
            (@EquivLike.toFunLike (Equiv.Perm (Fin m)) (Fin m) (Fin m) (@Equiv.instEquivLike (Fin m) (Fin m))) σ)
          (@id (Fin m)))))
def NLA.FR12.doublingMap : (m : Nat) →
  Prod (NLA.FR12.HadamardMatrices m) (Prod (NLA.FR12.HadamardMatrices m) (Equiv.Perm (Fin m))) →
    NLA.FR12.Mat (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) m m) :=
fun m x =>
  @NLA.FR12.doublingMatrix m
    (@Subtype.val (NLA.FR12.Mat m) (fun A => @NLA.FR12.IsRealHadamard m A)
      (@Prod.fst (NLA.FR12.HadamardMatrices m) (Prod (NLA.FR12.HadamardMatrices m) (Equiv.Perm (Fin m))) x))
    (@Subtype.val (NLA.FR12.Mat m) (fun A => @NLA.FR12.IsRealHadamard m A)
      (@Prod.fst (NLA.FR12.HadamardMatrices m) (Equiv.Perm (Fin m))
        (@Prod.snd (NLA.FR12.HadamardMatrices m) (Prod (NLA.FR12.HadamardMatrices m) (Equiv.Perm (Fin m))) x)))
    (@Prod.snd (NLA.FR12.HadamardMatrices m) (Equiv.Perm (Fin m))
      (@Prod.snd (NLA.FR12.HadamardMatrices m) (Prod (NLA.FR12.HadamardMatrices m) (Equiv.Perm (Fin m))) x))
NLA.FR12.counting_semantics (n : ℕ) :
  Finite (NLA.FR12.HadamardMatrices n) ∧
    (1 ≤ n → ∀ (A : NLA.FR12.Mat n), NLA.FR12.IsRealHadamard A ↔ Matrix.IsHadamard A)
NLA.FR12.injective_doubling (m : ℕ) (hm : 1 ≤ m) :
  (∀ (x : NLA.FR12.HadamardMatrices m × NLA.FR12.HadamardMatrices m × Equiv.Perm (Fin m)),
      NLA.FR12.IsRealHadamard (NLA.FR12.doublingMap m x)) ∧
    Function.Injective (NLA.FR12.doublingMap m)
NLA.FR12.factorial_doubling (m : ℕ) (hm : 1 ≤ m) :
  m.factorial * NLA.FR12.hadamardCount m ^ 2 ≤ NLA.FR12.hadamardCount (2 * m)
NLA.FR12.power_two_nonempty (k : ℕ) : 1 ≤ NLA.FR12.hadamardCount (2 ^ k)
NLA.FR12.power_two_lower_bound (k : ℕ) : 2 ^ (2 ^ (k + 2) * ↑k * (↑k + 1) / 8) ≤ ↑(NLA.FR12.hadamardCount (2 ^ (k + 2)))
NLA.FR12.counterexample (C : ℝ) (hC : 0 < C) :
  ∃ k, 2 ^ (C * ↑(2 ^ (k + 2)) * (Real.log ↑(2 ^ (k + 2)) / Real.log 2)) < ↑(NLA.FR12.hadamardCount (2 ^ (k + 2)))
NLA.FR12.not_countingConjecture : ¬NLA.FR12.CountingConjecture
Matrix.IsHadamard.{u_2, u_3} {n : Type u_2} {R : Type u_3} [Fintype n] [DecidableEq n] [Semiring R] [StarRing R]
  (A : Matrix n n R) : Prop
Matrix.IsHadamard.of_mul_conjTranspose.{u_2, u_3} {n : Type u_2} {R : Type u_3} [Fintype n] [DecidableEq n] [CommRing R]
  [StarRing R] {A : Matrix n n R} (hentry : ∀ (i j : n), A i j ∈ unitary R)
  (hmul : A * A.conjTranspose = ↑(Fintype.card n) • 1) (hcard : IsRegular ↑(Fintype.card n)) : A.IsHadamard
Nat.factorial_mul_pow_sub_le_factorial {n m : ℕ} (hnm : n ≤ m) : n.factorial * n ^ (m - n) ≤ m.factorial
