theorem NLA.FR12.not_countingConjecture_proved : ¬NLA.FR12.CountingConjecture :=
fun a =>
  Exists.casesOn a fun C h =>
    And.casesOn h fun hC hbound =>
      Exists.casesOn (NLA.FR12.counterexample_proved C hC) fun k hk =>
        have hn :=
          Nat.one_le_pow (k + 2) 2
            (Decidable.byContradiction fun a => NLA.FR12.not_countingConjecture_proved._proof_1_1 a);
        have hd :=
          Exists.intro (2 ^ k)
            (of_eq_true
              (Eq.trans (congr (congrArg Eq (pow_add 2 k 2)) (Nat.mul_comm 4 (2 ^ k))) (eq_self (2 ^ k * 4))));
        not_le_of_gt hk (hbound (2 ^ (k + 2)) hn hd)
Nat.card_le_card_of_injective.{u, v} {α : Type u} {β : Type v} [Finite β] (f : α → β) (hf : Function.Injective f) :
  Nat.card α ≤ Nat.card β
Fintype.card_perm.{u_1} {α : Type u_1} [DecidableEq α] [Fintype α] :
  Fintype.card (Equiv.Perm α) = (Fintype.card α).factorial
Nat.factorial_mul_pow_sub_le_factorial {n m : ℕ} (hnm : n ≤ m) : n.factorial * n ^ (m - n) ≤ m.factorial
Real.rpow_mul_natCast {x : ℝ} (hx : 0 ≤ x) (y : ℝ) (n : ℕ) : x ^ (y * ↑n) = (x ^ y) ^ n
Real.rpow_lt_rpow_of_exponent_lt {x y z : ℝ} (hx : 1 < x) (hyz : y < z) : x ^ y < x ^ z
Real.log_pow (x : ℝ) (n : ℕ) : Real.log (x ^ n) = ↑n * Real.log x
