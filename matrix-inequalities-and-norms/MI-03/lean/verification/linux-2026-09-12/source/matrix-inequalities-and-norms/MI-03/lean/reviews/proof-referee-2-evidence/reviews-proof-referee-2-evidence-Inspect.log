theorem NLA.MI03.sharp_constant_proved : ∀ (k : ℕ),
  2 ≤ k → IsLeast (NLA.MI03.admissibleConstants k) (↑k / 4) ∧ NLA.MI03.sharpConstant k = ↑k / 4 :=
fun k hk =>
  have hl := ⟨NLA.MI03.universal_upper_bound_proved k hk, fun c hc => NLA.MI03.lower_bound_proved k hk c hc⟩;
  ⟨hl, IsLeast.csInf_eq hl⟩
theorem NLA.MI03.odd_contraction_conjecture_proved : NLA.MI03.OddContractionConjecture :=
fun k hk _hodd =>
  (NLA.MI03.sharp_constant_proved k
      (Decidable.byContradiction fun a => NLA.MI03.odd_contraction_conjecture_proved._proof_1_1 k hk a)).right
