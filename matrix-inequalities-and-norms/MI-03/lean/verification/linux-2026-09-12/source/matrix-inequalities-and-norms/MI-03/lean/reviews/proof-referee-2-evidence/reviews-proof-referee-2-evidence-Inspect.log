def NLA.MI03.AdmissibleConstant : ℕ → ℝ → Prop :=
fun k c =>
  0 ≤ c ∧
    ∀ (n : ℕ),
      1 ≤ n →
        ∀ (A : Fin k → NLA.MI03.Mat n),
          (∀ (j : Fin k), NLA.MI03.operatorNorm (A j) ≤ 1) → Matrix.PosSemidef (NLA.MI03.errorGap A c)
def NLA.MI03.admissibleConstants : ℕ → Set ℝ :=
fun k => {c | NLA.MI03.AdmissibleConstant k c}
def NLA.MI03.sharpConstant : ℕ → ℝ :=
fun k => sInf (NLA.MI03.admissibleConstants k)
def NLA.MI03.OddContractionConjecture : Prop :=
∀ (k : ℕ), 3 ≤ k → Odd k → NLA.MI03.sharpConstant k = ↑k / 4
theorem NLA.MI03.positive_decomposition_proved : ∀ {n k : ℕ},
  1 ≤ n →
    2 ≤ k →
      ∀ (A : Fin k → NLA.MI03.Mat n),
        ↑k • NLA.MI03.errorGap A (↑k / 4) =
            ↑k • ∑ j, (NLA.MI03.matrixModulus (A j) - NLA.MI03.matrixModulus (A j) * NLA.MI03.matrixModulus (A j)) +
                NLA.MI03.pairVariance A +
              NLA.MI03.shiftedSquare A ∧
          Matrix.PosSemidef (NLA.MI03.pairVariance A) ∧ Matrix.PosSemidef (NLA.MI03.shiftedSquare A) :=
fun {n k} _hn _hk A =>
  ⟨Eq.mpr
      (id
        (congrArg
          (fun _a =>
            ↑k • NLA.MI03.errorGap A (↑k / 4) =
              ↑k • ∑ j, (NLA.MI03.matrixModulus (A j) - NLA.MI03.matrixModulus (A j) * NLA.MI03.matrixModulus (A j)) +
                  _a +
                NLA.MI03.shiftedSquare A)
          (NLA.MI03.pairVariance_identity A)))
      (Eq.mpr
        (id
          (congr
            (congrArg Eq
              (congrArg (HSMul.hSMul ↑k)
                (congrFun'
                  (congrArg HSub.hSub
                    (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HSMul.hSMul (Complex.ofReal_div (↑k) 4)) 1))
                      (∑ j, NLA.MI03.matrixModulus (A j))))
                  (NLA.MI03.matrixModulus (NLA.MI03.summandSum A)))))
            (congr
              (congrArg HAdd.hAdd
                (congrFun'
                  (congrArg HAdd.hAdd
                    (congrArg (HSMul.hSMul ↑k)
                      (Eq.trans
                        (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                          congrArg (HSub.hSub (NLA.MI03.matrixModulus (A x))) (NLA.MI03.modulus_square (A x)))
                        (Finset.sum_sub_distrib (fun x => NLA.MI03.matrixModulus (A x)) fun x =>
                          Matrix.conjTranspose (A x) * A x))))
                  (↑k • ∑ x, Matrix.conjTranspose (A x) * A x -
                    Matrix.conjTranspose (NLA.MI03.summandSum A) * NLA.MI03.summandSum A)))
              (Eq.trans (pow_two (NLA.MI03.matrixModulus (NLA.MI03.summandSum A) - (↑k / 2) • 1))
                (Eq.trans
                  (mul_sub (NLA.MI03.matrixModulus (NLA.MI03.summandSum A) - (↑k / 2) • 1)
