def NLA.MI03.AdmissibleConstant : ℕ → ℝ → Prop :=
fun k c =>
  0 ≤ c ∧
    ∀ (n : ℕ),
      1 ≤ n →
        ∀ (A : Fin k → NLA.MI03.Mat n),
          (∀ (j : Fin k), NLA.MI03.operatorNorm (A j) ≤ 1) → Matrix.PosSemidef (NLA.MI03.errorGap A c)
def NLA.MI03.admissibleConstants : ℕ → Set ℝ :=
fun k => {c | NLA.MI03.AdmissibleConstant k c}
def NLA.MI03.sharpConstant : ℕ → ℝ :=
fun k => sInf (NLA.MI03.admissibleConstants k)
def NLA.MI03.OddContractionConjecture : Prop :=
∀ (k : ℕ), 3 ≤ k → Odd k → NLA.MI03.sharpConstant k = ↑k / 4
theorem NLA.MI03.witness_modulus : ∀ (k : ℕ),
  2 ≤ k →
    ∀ (j : Fin k),
      NLA.MI03.matrixModulus (NLA.MI03.witness k j) =
        NLA.MI03.outerProduct (NLA.MI03.witnessVector k j) (NLA.MI03.witnessVector k j) :=
fun k hk j =>
  CFC.sqrt_unique
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = Matrix.conjTranspose (NLA.MI03.witness k j) * NLA.MI03.witness k j)
          (NLA.MI03.witnessModulus_idempotent k hk j)))
      (Eq.mpr
        (id
          (congrArg (fun _a => NLA.MI03.outerProduct (NLA.MI03.witnessVector k j) (NLA.MI03.witnessVector k j) = _a)
            (NLA.MI03.witness_gram k j)))
        (Eq.refl (NLA.MI03.outerProduct (NLA.MI03.witnessVector k j) (NLA.MI03.witnessVector k j)))))
    (Matrix.PosSemidef.nonneg (NLA.MI03.outerProduct_posSemidef (NLA.MI03.witnessVector k j)))
