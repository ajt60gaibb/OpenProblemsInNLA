  @HPow.hPow (NLA.MI03.Mat n) Nat (NLA.MI03.Mat n)
    (@instHPow (NLA.MI03.Mat n) Nat
      (@NPow.toPow (NLA.MI03.Mat n)
        (@Monoid.toNPow (NLA.MI03.Mat n)
          (@Semiring.toMonoid (NLA.MI03.Mat n)
            (@Matrix.semiring (Fin n) Complex Complex.instSemiring (Fin.fintype n) (instDecidableEqFin n))))))
    (@HSub.hSub (NLA.MI03.Mat n) (NLA.MI03.Mat n) (NLA.MI03.Mat n)
      (@instHSub (NLA.MI03.Mat n) (@Matrix.sub (Fin n) (Fin n) Complex Complex.instSub))
      (@NLA.MI03.matrixModulus n (@NLA.MI03.summandSum n k A))
      (@HSMul.hSMul Complex (NLA.MI03.Mat n) (NLA.MI03.Mat n)
        (@instHSMul Complex (NLA.MI03.Mat n)
          (@Matrix.smul (Fin n) (Fin n) Complex Complex (@instSMulOfMul Complex Complex.instMul)))
        (@HDiv.hDiv Complex Complex Complex (@instHDiv Complex (@DivInvMonoid.toDiv Complex Complex.instDivInvMonoid))
          (@Nat.cast Complex Complex.instNatCast k)
          (@OfNat.ofNat Complex (nat_lit 2)
            (@instOfNatAtLeastTwo Complex (nat_lit 2) Complex.instNatCast NLA.MI03.pairVariance._proof_1)))
        (@OfNat.ofNat (NLA.MI03.Mat n) (nat_lit 1)
          (@One.toOfNat1 (NLA.MI03.Mat n)
            (@Matrix.one (Fin n) Complex (instDecidableEqFin n) Complex.instZero Complex.instOne)))))
    (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))
def NLA.MI03.outerProduct : {n : Nat} → (Fin n → Complex) → (Fin n → Complex) → NLA.MI03.Mat n :=
fun {n} u v =>
  @Matrix.vecMulVec (Fin n) (Fin n) Complex Complex.instMul u fun i =>
    @star Complex
      (@InvolutiveStar.toStar Complex
        (@StarAddMonoid.toInvolutiveStar Complex
          (@AddCommMonoid.toAddMonoid Complex
            (@NonUnitalNonAssocSemiring.toAddCommMonoid Complex
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring Complex
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing Complex
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing Complex Complex.instNonUnitalCommRing)))))
          (@StarRing.toStarAddMonoid Complex
            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring Complex
              (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing Complex
                (@NonUnitalCommRing.toNonUnitalNonAssocCommRing Complex Complex.instNonUnitalCommRing)))
            Complex.instStarRing)))
      (v i)
def NLA.MI03.AdmissibleConstant : Nat → Real → Prop :=
fun k c =>
  And (@LE.le Real Real.instLE (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) c)
    (∀ (n : Nat),
      @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) n →
        ∀ (A : Fin k → NLA.MI03.Mat n),
          (∀ (j : Fin k),
              @LE.le Real Real.instLE (@NLA.MI03.operatorNorm n (A j))
                (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne))) →
            @Matrix.PosSemidef (Fin n) Complex Complex.instRing Complex.partialOrder Complex.instStarRing
              (@NLA.MI03.errorGap n k A c))
NLA.MI03.sharpness_witness (k : Nat)
  (hk : @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) k) :
  And
    (∀ (j : Fin k),
      @Eq Real
        (@norm
          (WithLp
            (@OfNat.ofNat ENNReal (nat_lit 2)
              (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
                (@AddMonoidWithOne.toNatCast ENNReal
                  (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
                ⋯))
            (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) → Complex))
          (@PiLp.instNorm
            (@OfNat.ofNat ENNReal (nat_lit 2)
              (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
                (@AddMonoidWithOne.toNatCast ENNReal
                  (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
                ⋯))
            (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) (fun a => Complex)
            (Fin.fintype (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) fun i => Complex.instNorm)
          (@WithLp.toLp
            (@OfNat.ofNat ENNReal (nat_lit 2)
              (@instOfNatAtLeastTwo ENNReal (nat_lit 2)
                (@AddMonoidWithOne.toNatCast ENNReal
                  (@AddCommMonoidWithOne.toAddMonoidWithOne ENNReal ENNReal.instAddCommMonoidWithOne))
                ⋯))
            (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) → Complex) (NLA.MI03.witnessVector k j)))
        (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)))
    (And
      (∀ (j : Fin k),
        @Eq Real
          (@NLA.MI03.operatorNorm (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) (NLA.MI03.witness k j))
          (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)))
      (And
        (∀ (j : Fin k),
          @Eq (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
            (@NLA.MI03.matrixModulus (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) (NLA.MI03.witness k j))
            (@NLA.MI03.outerProduct (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))
              (NLA.MI03.witnessVector k j) (NLA.MI03.witnessVector k j)))
        (And
          (@Eq (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
            (@NLA.MI03.summandSum (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) k (NLA.MI03.witness k))
            (@HSMul.hSMul Complex (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
              (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
              (@instHSMul Complex (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                (@Matrix.smul (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                  (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex Complex
                  (@instSMulOfMul Complex Complex.instMul)))
              (@HDiv.hDiv Complex Complex Complex
                (@instHDiv Complex (@DivInvMonoid.toDiv Complex Complex.instDivInvMonoid))
                (@Nat.cast Complex Complex.instNatCast k)
                (@OfNat.ofNat Complex (nat_lit 2) (@instOfNatAtLeastTwo Complex (nat_lit 2) Complex.instNatCast ⋯)))
              NLA.MI03.firstProjection))
          (And
            (@Eq (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
              (@NLA.MI03.modulusSum (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) k (NLA.MI03.witness k))
              (NLA.MI03.witnessModulusSum k))
            (@Eq (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
              (@HSub.hSub (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                (@instHSub (NLA.MI03.Mat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                  (@Matrix.sub (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                    (Fin (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) Complex Complex.instSub))
                (@NLA.MI03.matrixModulus (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))
                  (@NLA.MI03.summandSum (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) k
                    (NLA.MI03.witness k)))
                (@NLA.MI03.modulusSum (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) k (NLA.MI03.witness k)))
              (NLA.MI03.witnessDifference k))))))
def Matrix.PosSemidef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} → [inst : Ring R] → [PartialOrder R] → [StarRing R] → Matrix n n R → Prop :=
fun {n} {R} [Ring R] [PartialOrder R] [StarRing R] M =>
  M.IsHermitian ∧ ∀ (x : n →₀ R), 0 ≤ x.sum fun i xi => x.sum fun j xj => star xi * M i j * xj
def CFC.sqrt.{u_1} : {A : Type u_1} →
  [inst : PartialOrder A] →
    [inst_1 : NonUnitalRing A] →
      [inst_2 : TopologicalSpace A] →
        [inst_3 : StarRing A] →
          [inst_4 : Module ℝ A] →
            [inst_5 : SMulCommClass ℝ A A] →
              [inst_6 : IsScalarTower ℝ A A] →
                [StarOrderedRing A] →
                  [NonUnitalContinuousFunctionalCalculus ℝ A IsSelfAdjoint] → [NonnegSpectrumClass ℝ A] → A → A :=
fun {A} [PartialOrder A] [NonUnitalRing A] [TopologicalSpace A] [StarRing A] [Module ℝ A] [SMulCommClass ℝ A A]
    [IsScalarTower ℝ A A] [StarOrderedRing A] [NonUnitalContinuousFunctionalCalculus ℝ A IsSelfAdjoint]
    [NonnegSpectrumClass ℝ A] a =>
  cfcₙ (⇑NNReal.sqrt) a
Matrix.nonneg_iff_posSemidef.{u_1, u_2} {𝕜 : Type u_1} {n : Type u_2} [RCLike 𝕜] {A : Matrix n n 𝕜} :
  0 ≤ A ↔ A.PosSemidef
CFC.sqrt_mul_sqrt_self.{u_1} {A : Type u_1} [PartialOrder A] [NonUnitalRing A] [TopologicalSpace A] [StarRing A]
  [Module ℝ A] [SMulCommClass ℝ A A] [IsScalarTower ℝ A A] [StarOrderedRing A]
  [NonUnitalContinuousFunctionalCalculus ℝ A IsSelfAdjoint] [NonnegSpectrumClass ℝ A] [IsSemitopologicalRing A]
  [T2Space A] (a : A) (ha : 0 ≤ a := by cfc_tac) : CFC.sqrt a * CFC.sqrt a = a
CFC.sqrt_unique.{u_1} {A : Type u_1} [PartialOrder A] [NonUnitalRing A] [TopologicalSpace A] [StarRing A] [Module ℝ A]
  [SMulCommClass ℝ A A] [IsScalarTower ℝ A A] [StarOrderedRing A]
  [NonUnitalContinuousFunctionalCalculus ℝ A IsSelfAdjoint] [NonnegSpectrumClass ℝ A] [IsSemitopologicalRing A]
  [T2Space A] {a b : A} (h : b * b = a) (hb : 0 ≤ b := by cfc_tac) : CFC.sqrt a = b
CFC.sqrt_zero.{u_1} {A : Type u_1} [PartialOrder A] [NonUnitalRing A] [TopologicalSpace A] [StarRing A] [Module ℝ A]
  [SMulCommClass ℝ A A] [IsScalarTower ℝ A A] [StarOrderedRing A]
  [NonUnitalContinuousFunctionalCalculus ℝ A IsSelfAdjoint] [NonnegSpectrumClass ℝ A] : CFC.sqrt 0 = 0
Complex.isPrimitiveRoot_exp (n : ℕ) (h0 : n ≠ 0) : IsPrimitiveRoot (Complex.exp (2 * ↑Real.pi * Complex.I / ↑n)) n
IsPrimitiveRoot.geom_sum_eq_zero.{u_4} {R : Type u_4} {k : ℕ} [CommRing R] [IsDomain R] {ζ : R}
  (hζ : IsPrimitiveRoot ζ k) (hk : 1 < k) : ∑ i ∈ Finset.range k, ζ ^ i = 0
IsLeast.csInf_eq.{u_1} {α : Type u_1} [ConditionallyCompletePartialOrderInf α] {s : Set α} {a : α} (H : IsLeast s a) :
  sInf s = a
Matrix.toEuclideanCLM_toLp.{u_1, u_3} {𝕜 : Type u_1} {n : Type u_3} [RCLike 𝕜] [Fintype n] [DecidableEq n]
  (A : Matrix n n 𝕜) (x : n → 𝕜) : (Matrix.toEuclideanCLM A) (WithLp.toLp 2 x) = WithLp.toLp 2 (A.mulVec x)
NLA.MI03.modulus_semantics {n : ℕ} (hn : 1 ≤ n) (A : NLA.MI03.Mat n) :
  Matrix.PosSemidef (NLA.MI03.matrixModulus A) ∧
    NLA.MI03.matrixModulus A * NLA.MI03.matrixModulus A = Matrix.conjTranspose A * A ∧
      NLA.MI03.operatorNorm (NLA.MI03.matrixModulus A) = NLA.MI03.operatorNorm A
NLA.MI03.contraction_modulus {n : ℕ} (hn : 1 ≤ n) (A : NLA.MI03.Mat n) (hA : NLA.MI03.operatorNorm A ≤ 1) :
  Matrix.PosSemidef (1 - NLA.MI03.matrixModulus A) ∧
    Matrix.PosSemidef (NLA.MI03.matrixModulus A - NLA.MI03.matrixModulus A * NLA.MI03.matrixModulus A)
NLA.MI03.positive_decomposition {n k : ℕ} (hn : 1 ≤ n) (hk : 2 ≤ k) (A : Fin k → NLA.MI03.Mat n) :
  ↑k • NLA.MI03.errorGap A (↑k / 4) =
      ↑k • ∑ j, (NLA.MI03.matrixModulus (A j) - NLA.MI03.matrixModulus (A j) * NLA.MI03.matrixModulus (A j)) +
          NLA.MI03.pairVariance A +
        NLA.MI03.shiftedSquare A ∧
    Matrix.PosSemidef (NLA.MI03.pairVariance A) ∧ Matrix.PosSemidef (NLA.MI03.shiftedSquare A)
NLA.MI03.universal_upper_bound (k : ℕ) (hk : 2 ≤ k) : NLA.MI03.AdmissibleConstant k (↑k / 4)
NLA.MI03.root_of_unity_data (k : ℕ) (hk : 2 ≤ k) : ‖NLA.MI03.rootOfUnity k‖ = 1 ∧ ∑ j, NLA.MI03.rootOfUnity k ^ ↑j = 0
NLA.MI03.sharpness_witness (k : ℕ) (hk : 2 ≤ k) :
  (∀ (j : Fin k), ‖WithLp.toLp 2 (NLA.MI03.witnessVector k j)‖ = 1) ∧
    (∀ (j : Fin k), NLA.MI03.operatorNorm (NLA.MI03.witness k j) = 1) ∧
      (∀ (j : Fin k),
          NLA.MI03.matrixModulus (NLA.MI03.witness k j) =
            NLA.MI03.outerProduct (NLA.MI03.witnessVector k j) (NLA.MI03.witnessVector k j)) ∧
        NLA.MI03.summandSum (NLA.MI03.witness k) = (↑k / 2) • NLA.MI03.firstProjection ∧
          NLA.MI03.modulusSum (NLA.MI03.witness k) = NLA.MI03.witnessModulusSum k ∧
            NLA.MI03.matrixModulus (NLA.MI03.summandSum (NLA.MI03.witness k)) -
                NLA.MI03.modulusSum (NLA.MI03.witness k) =
              NLA.MI03.witnessDifference k
NLA.MI03.sharp_constant (k : ℕ) (hk : 2 ≤ k) :
  IsLeast (NLA.MI03.admissibleConstants k) (↑k / 4) ∧ NLA.MI03.sharpConstant k = ↑k / 4
NLA.MI03.odd_contraction_conjecture : NLA.MI03.OddContractionConjecture
