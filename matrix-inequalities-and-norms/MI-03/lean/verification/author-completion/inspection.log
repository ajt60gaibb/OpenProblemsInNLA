PROJECT_DECLARATIONS: 95
NLA.MI03.modulus_semantics {n : ℕ} (hn : 1 ≤ n) (A : NLA.MI03.Mat n) :
  Matrix.PosSemidef (NLA.MI03.matrixModulus A) ∧
    NLA.MI03.matrixModulus A * NLA.MI03.matrixModulus A = Matrix.conjTranspose A * A ∧
      NLA.MI03.operatorNorm (NLA.MI03.matrixModulus A) = NLA.MI03.operatorNorm A
NLA.MI03.contraction_modulus {n : ℕ} (hn : 1 ≤ n) (A : NLA.MI03.Mat n) (hA : NLA.MI03.operatorNorm A ≤ 1) :
  Matrix.PosSemidef (1 - NLA.MI03.matrixModulus A) ∧
    Matrix.PosSemidef (NLA.MI03.matrixModulus A - NLA.MI03.matrixModulus A * NLA.MI03.matrixModulus A)
NLA.MI03.positive_decomposition {n k : ℕ} (hn : 1 ≤ n) (hk : 2 ≤ k) (A : Fin k → NLA.MI03.Mat n) :
  ↑k • NLA.MI03.errorGap A (↑k / 4) =
      ↑k • ∑ j, (NLA.MI03.matrixModulus (A j) - NLA.MI03.matrixModulus (A j) * NLA.MI03.matrixModulus (A j)) +
          NLA.MI03.pairVariance A +
        NLA.MI03.shiftedSquare A ∧
    Matrix.PosSemidef (NLA.MI03.pairVariance A) ∧ Matrix.PosSemidef (NLA.MI03.shiftedSquare A)
NLA.MI03.universal_upper_bound (k : ℕ) (hk : 2 ≤ k) : NLA.MI03.AdmissibleConstant k (↑k / 4)
NLA.MI03.root_of_unity_data (k : ℕ) (hk : 2 ≤ k) : ‖NLA.MI03.rootOfUnity k‖ = 1 ∧ ∑ j, NLA.MI03.rootOfUnity k ^ ↑j = 0
NLA.MI03.sharpness_witness (k : ℕ) (hk : 2 ≤ k) :
  (∀ (j : Fin k), ‖WithLp.toLp 2 (NLA.MI03.witnessVector k j)‖ = 1) ∧
    (∀ (j : Fin k), NLA.MI03.operatorNorm (NLA.MI03.witness k j) = 1) ∧
      (∀ (j : Fin k),
          NLA.MI03.matrixModulus (NLA.MI03.witness k j) =
            NLA.MI03.outerProduct (NLA.MI03.witnessVector k j) (NLA.MI03.witnessVector k j)) ∧
        NLA.MI03.summandSum (NLA.MI03.witness k) = (↑k / 2) • NLA.MI03.firstProjection ∧
          NLA.MI03.modulusSum (NLA.MI03.witness k) = NLA.MI03.witnessModulusSum k ∧
            NLA.MI03.matrixModulus (NLA.MI03.summandSum (NLA.MI03.witness k)) -
                NLA.MI03.modulusSum (NLA.MI03.witness k) =
              NLA.MI03.witnessDifference k
NLA.MI03.sharp_constant (k : ℕ) (hk : 2 ≤ k) :
  IsLeast (NLA.MI03.admissibleConstants k) (↑k / 4) ∧ NLA.MI03.sharpConstant k = ↑k / 4
NLA.MI03.odd_contraction_conjecture : NLA.MI03.OddContractionConjecture
def NLA.MI03.matrixModulus : {n : ℕ} → NLA.MI03.Mat n → NLA.MI03.Mat n :=
fun {n} A => CFC.sqrt (Matrix.conjTranspose A * A)
def NLA.MI03.operatorNorm : {n : ℕ} → NLA.MI03.Mat n → ℝ :=
fun {n} A => ‖Matrix.toEuclideanCLM A‖
def NLA.MI03.AdmissibleConstant : ℕ → ℝ → Prop :=
fun k c =>
  0 ≤ c ∧
    ∀ (n : ℕ),
      1 ≤ n →
        ∀ (A : Fin k → NLA.MI03.Mat n),
          (∀ (j : Fin k), NLA.MI03.operatorNorm (A j) ≤ 1) → Matrix.PosSemidef (NLA.MI03.errorGap A c)
def NLA.MI03.admissibleConstants : ℕ → Set ℝ :=
fun k => {c | NLA.MI03.AdmissibleConstant k c}
def NLA.MI03.sharpConstant : ℕ → ℝ :=
fun k => sInf (NLA.MI03.admissibleConstants k)
def NLA.MI03.OddContractionConjecture : Prop :=
∀ (k : ℕ), 3 ≤ k → Odd k → NLA.MI03.sharpConstant k = ↑k / 4
theorem NLA.MI03.lower_bound_proved : ∀ (k : ℕ), 2 ≤ k → ∀ (c : ℝ), NLA.MI03.AdmissibleConstant k c → ↑k / 4 ≤ c :=
fun k hk c hc =>
  have hPSD :=
    hc.right 2 (of_decide_eq_true (id (Eq.refl true))) (NLA.MI03.witness k) fun j =>
      Eq.le (NLA.MI03.witness_norm k hk j);
  have he :=
    Eq.mpr
      (id
        (congrArg (fun _a => NLA.MI03.errorGap (NLA.MI03.witness k) c = ↑c • 1 - _a)
          (Eq.symm (NLA.MI03.witness_difference k hk))))
      (id (NLA.MI03.lower_bound_proved._abel_1_1 k c));
  have hd := Matrix.PosSemidef.diag_nonneg (Eq.mp (congrArg (fun _a => Matrix.PosSemidef _a) he) hPSD);
  have hreal := (Complex.nonneg_iff.mp hd).left;
  le_of_not_gt fun a =>
    Mathlib.Tactic.Linarith.lt_irrefl
      (Eq.mp
