NLA.MI22.singular_values_semantics {n : ℕ} (hn : 1 ≤ n) (A : NLA.MI22.Mat n) :
  (∀ (j : ℕ), 0 ≤ NLA.MI22.singularValue A j) ∧
    Antitone (NLA.MI22.singularValue A) ∧
      (∀ (j : ℕ), n ≤ j → NLA.MI22.singularValue A j = 0) ∧
        (∀ (i : Fin n), NLA.MI22.singularValue A ↑i = √(⋯.eigenvalues ⋯ i)) ∧
          NLA.MI22.singularValue A 0 = NLA.MI22.operatorNorm A
NLA.MI22.spectral_power_semantics {n : ℕ} (A : NLA.MI22.Mat n) (hA : Matrix.PosDef A) (r : ℝ) :
  NLA.MI22.spectralPower A r =
    (↑⋯.eigenvectorUnitary * Matrix.diagonal fun i => ↑(⋯.eigenvalues i ^ r)) * (↑⋯.eigenvectorUnitary).conjTranspose
NLA.MI22.euclidean_norm_bounds {n : ℕ} (A : NLA.MI22.Mat n) :
  NLA.MI22.operatorNorm A ^ 2 ≤ NLA.MI22.frobeniusSquared A ∧
    ∀ (x : EuclideanSpace ℂ (Fin n)) (i : Fin n), ‖((Matrix.toEuclideanCLM A) x).ofLp i‖ ≤ NLA.MI22.operatorNorm A * ‖x‖
NLA.MI22.witness_rational_data :
  NLA.MI22.witnessT = NLA.MI22.witnessLDL * NLA.MI22.witnessPivots * Matrix.conjTranspose NLA.MI22.witnessLDL ∧
    NLA.MI22.witnessA = Matrix.diagonal ![256, 1 / 256, 1] ∧
      Matrix.PosDef NLA.MI22.witnessT ∧
        Matrix.PosDef NLA.MI22.witnessA ∧
          Matrix.PosDef NLA.MI22.witnessB ∧
            ‖NLA.MI22.witnessVector‖ = 1 ∧
              (Matrix.trace NLA.MI22.witnessB).re < 4 ^ 8 ∧
                44000 < NLA.MI22.witnessTestValue ∧
                  NLA.MI22.frobeniusSquared (NLA.MI22.witnessA * NLA.MI22.witnessB) < 10500 ^ 2
NLA.MI22.witness_principal_powers :
  NLA.MI22.spectralPower NLA.MI22.witnessA (1 / 2) = NLA.MI22.witnessD ∧
    NLA.MI22.spectralPower NLA.MI22.witnessA (-1 / 2) = NLA.MI22.witnessDInv ∧
      NLA.MI22.spectralPower NLA.MI22.witnessA (1 / 8) = NLA.MI22.witnessAOneEighth ∧
        NLA.MI22.spectralPower NLA.MI22.witnessA (5 / 8) = NLA.MI22.witnessAFiveEighths ∧
          NLA.MI22.spectralPower (NLA.MI22.witnessDInv * NLA.MI22.witnessB * NLA.MI22.witnessDInv) (1 / 8) =
              NLA.MI22.witnessT ∧
            NLA.MI22.weightedMean NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8) =
                NLA.MI22.witnessD * NLA.MI22.witnessT * NLA.MI22.witnessD ∧
              Matrix.PosDef NLA.MI22.witnessRoot ∧
                NLA.MI22.witnessRoot ^ 8 = NLA.MI22.witnessB ∧
                  NLA.MI22.spectralPower NLA.MI22.witnessB (7 / 8) * NLA.MI22.witnessRoot = NLA.MI22.witnessB ∧
                    NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8) * NLA.MI22.witnessRoot =
                        NLA.MI22.witnessN ∧
                      NLA.MI22.operatorNorm NLA.MI22.witnessRoot < 4
NLA.MI22.witness_operator_gap :
  NLA.MI22.operatorNorm (NLA.MI22.witnessA * NLA.MI22.witnessB) < 10500 ∧
    11000 < NLA.MI22.operatorNorm (NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8))
NLA.MI22.counterexample :
  Matrix.PosDef NLA.MI22.witnessA ∧
    Matrix.PosDef NLA.MI22.witnessB ∧
      0 ≤ 1 / 8 ∧
        1 / 8 ≤ 1 ∧
          NLA.MI22.singularValue (NLA.MI22.witnessA * NLA.MI22.witnessB) 0 <
              NLA.MI22.singularValue (NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8)) 0 ∧
            ¬NLA.MI22.SingularLogMajorized (NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8))
                (NLA.MI22.witnessA * NLA.MI22.witnessB)
NLA.MI22.not_weightedLogMajorizationConjecture : ¬NLA.MI22.WeightedLogMajorizationConjecture
def NLA.MI22.WeightedLogMajorizationConjecture : Prop :=
∀ (n : ℕ),
  1 ≤ n →
    ∀ (A B : NLA.MI22.Mat n),
      Matrix.PosDef A →
        Matrix.PosDef B → ∀ (t : ℝ), 0 ≤ t → t ≤ 1 → NLA.MI22.SingularLogMajorized (NLA.MI22.leftProduct A B t) (A * B)
def NLA.MI22.SingularLogMajorized : {n : ℕ} → NLA.MI22.Mat n → NLA.MI22.Mat n → Prop :=
fun {n} X Y =>
  (∀ (k : ℕ), 1 ≤ k → k < n → NLA.MI22.singularPrefix X k ≤ NLA.MI22.singularPrefix Y k) ∧
    NLA.MI22.singularPrefix X n = NLA.MI22.singularPrefix Y n
def NLA.MI22.singularValue : {n : ℕ} → NLA.MI22.Mat n → ℕ → ℝ :=
fun {n} A j => (Matrix.toEuclideanLin A).singularValues j
def NLA.MI22.operatorNorm : {n : ℕ} → NLA.MI22.Mat n → ℝ :=
fun {n} A => ‖Matrix.toEuclideanCLM A‖
def NLA.MI22.spectralPower : {n : ℕ} → NLA.MI22.Mat n → ℝ → NLA.MI22.Mat n :=
fun {n} A t => CFC.rpow A t
theorem NLA.MI22.numerical_separation : 10500 < 11000 :=
have h0 :=
  LeanCert.Validity.verify_strict_upper_bound_dyadic_checked (LeanCert.Core.Expr.const (Rat.divInt 10500 1))
    (Rat.divInt 0 1) (Rat.divInt 0 1) (le_refl (Rat.divInt 0 1)) (Rat.divInt 11000 1) (-53) 10
    (of_decide_eq_true (id (Eq.refl true))) NLA.MI22.numerical_separation._proof_1_7 ↑(Rat.divInt 0 1)
    ⟨le_refl ↑(Rat.divInt 0 1), le_refl ↑(Rat.divInt 0 1)⟩;
h0
