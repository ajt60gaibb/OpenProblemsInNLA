    [inst_1 : Ring A] →
      [inst_2 :
          @StarRing A
            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring A
              (@NonAssocRing.toNonUnitalNonAssocRing A (@Ring.toNonAssocRing A inst_1)))] →
        [inst_3 : TopologicalSpace A] →
          [@StarOrderedRing A (@Semiring.toNonUnitalSemiring A (@Ring.toSemiring A inst_1)) inst inst_2] →
            [inst_5 : @Algebra Real A Real.instCommSemiring (@Ring.toSemiring A inst_1)] →
              [@ContinuousFunctionalCalculus Real A
                    (@IsSelfAdjoint A
                      (@InvolutiveStar.toStar A
                        (@StarAddMonoid.toInvolutiveStar A
                          (@AddCommMonoid.toAddMonoid A
                            (@NonUnitalNonAssocSemiring.toAddCommMonoid A
                              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring A
                                (@NonAssocRing.toNonUnitalNonAssocRing A (@Ring.toNonAssocRing A inst_1)))))
                          (@StarRing.toStarAddMonoid A
                            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring A
                              (@NonAssocRing.toNonUnitalNonAssocRing A (@Ring.toNonAssocRing A inst_1)))
                            inst_2))))
                    Real.instCommSemiring instStarRingReal Real.metricSpace ⋯ instContinuousStarReal inst_1 inst_2
                    inst_3 inst_5] →
                [@NonnegSpectrumClass Real A Real.instCommSemiring Real.partialOrder (@Ring.toNonUnitalRing A inst_1)
                      inst (@Algebra.toModule Real A Real.instCommSemiring (@Ring.toSemiring A inst_1) inst_5)] →
                  A → Real → A :=
fun {A} [inst : PartialOrder A] [inst_1 : Ring A]
    [inst_2 :
      @StarRing A
        (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring A
          (@NonAssocRing.toNonUnitalNonAssocRing A (@Ring.toNonAssocRing A inst_1)))]
    [inst_3 : TopologicalSpace A]
    [@StarOrderedRing A (@Semiring.toNonUnitalSemiring A (@Ring.toSemiring A inst_1)) inst inst_2]
    [inst_5 : @Algebra Real A Real.instCommSemiring (@Ring.toSemiring A inst_1)]
    [@ContinuousFunctionalCalculus Real A
        (@IsSelfAdjoint A
          (@InvolutiveStar.toStar A
            (@StarAddMonoid.toInvolutiveStar A
              (@AddCommMonoid.toAddMonoid A
                (@NonUnitalNonAssocSemiring.toAddCommMonoid A
                  (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring A
                    (@NonAssocRing.toNonUnitalNonAssocRing A (@Ring.toNonAssocRing A inst_1)))))
              (@StarRing.toStarAddMonoid A
                (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring A
                  (@NonAssocRing.toNonUnitalNonAssocRing A (@Ring.toNonAssocRing A inst_1)))
                inst_2))))
        Real.instCommSemiring instStarRingReal Real.metricSpace CFC.nnrpow._proof_1 instContinuousStarReal inst_1 inst_2
        inst_3 inst_5]
    [@NonnegSpectrumClass Real A Real.instCommSemiring Real.partialOrder (@Ring.toNonUnitalRing A inst_1) inst
        (@Algebra.toModule Real A Real.instCommSemiring (@Ring.toSemiring A inst_1) inst_5)]
    a y =>
  @cfc NNReal A
    (fun x =>
      @LE.le A (@Preorder.toLE A (@PartialOrder.toPreorder A inst))
        (@OfNat.ofNat A (nat_lit 0)
          (@Zero.toOfNat0 A (@MulZeroClass.toZero A (@instMulZeroClassOfSemiring A (@Ring.toSemiring A inst_1)))))
        x)
    NNReal.instCommSemiring instStarRingNNReal instMetricSpaceNNReal NNReal.instIsTopologicalSemiring
    NNReal.instContinuousStar inst_3 inst_1 inst_2 (@NNReal.instAlgebraOfReal A (@Ring.toSemiring A inst_1) inst_5) ⋯
    (fun x => @HPow.hPow NNReal Real NNReal (@instHPow NNReal Real NNReal.instPowReal) x y) a
NLA.MI22.singular_values_semantics {n : ℕ} (hn : 1 ≤ n) (A : NLA.MI22.Mat n) :
  (∀ (j : ℕ), 0 ≤ NLA.MI22.singularValue A j) ∧
    Antitone (NLA.MI22.singularValue A) ∧
      (∀ (j : ℕ), n ≤ j → NLA.MI22.singularValue A j = 0) ∧
        (∀ (i : Fin n), NLA.MI22.singularValue A ↑i = √(⋯.eigenvalues ⋯ i)) ∧
          NLA.MI22.singularValue A 0 = NLA.MI22.operatorNorm A
NLA.MI22.spectral_power_semantics {n : ℕ} (A : NLA.MI22.Mat n) (hA : Matrix.PosDef A) (r : ℝ) :
  NLA.MI22.spectralPower A r =
    (↑⋯.eigenvectorUnitary * Matrix.diagonal fun i => ↑(⋯.eigenvalues i ^ r)) * (↑⋯.eigenvectorUnitary).conjTranspose
NLA.MI22.euclidean_norm_bounds {n : ℕ} (A : NLA.MI22.Mat n) :
  NLA.MI22.operatorNorm A ^ 2 ≤ NLA.MI22.frobeniusSquared A ∧
    ∀ (x : EuclideanSpace ℂ (Fin n)) (i : Fin n), ‖((Matrix.toEuclideanCLM A) x).ofLp i‖ ≤ NLA.MI22.operatorNorm A * ‖x‖
NLA.MI22.witness_rational_data :
  NLA.MI22.witnessT = NLA.MI22.witnessLDL * NLA.MI22.witnessPivots * Matrix.conjTranspose NLA.MI22.witnessLDL ∧
    NLA.MI22.witnessA = Matrix.diagonal ![256, 1 / 256, 1] ∧
      Matrix.PosDef NLA.MI22.witnessT ∧
        Matrix.PosDef NLA.MI22.witnessA ∧
          Matrix.PosDef NLA.MI22.witnessB ∧
            ‖NLA.MI22.witnessVector‖ = 1 ∧
              (Matrix.trace NLA.MI22.witnessB).re < 4 ^ 8 ∧
                44000 < NLA.MI22.witnessTestValue ∧
                  NLA.MI22.frobeniusSquared (NLA.MI22.witnessA * NLA.MI22.witnessB) < 10500 ^ 2
NLA.MI22.witness_principal_powers :
  NLA.MI22.spectralPower NLA.MI22.witnessA (1 / 2) = NLA.MI22.witnessD ∧
    NLA.MI22.spectralPower NLA.MI22.witnessA (-1 / 2) = NLA.MI22.witnessDInv ∧
      NLA.MI22.spectralPower NLA.MI22.witnessA (1 / 8) = NLA.MI22.witnessAOneEighth ∧
        NLA.MI22.spectralPower NLA.MI22.witnessA (5 / 8) = NLA.MI22.witnessAFiveEighths ∧
          NLA.MI22.spectralPower (NLA.MI22.witnessDInv * NLA.MI22.witnessB * NLA.MI22.witnessDInv) (1 / 8) =
              NLA.MI22.witnessT ∧
            NLA.MI22.weightedMean NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8) =
                NLA.MI22.witnessD * NLA.MI22.witnessT * NLA.MI22.witnessD ∧
              Matrix.PosDef NLA.MI22.witnessRoot ∧
                NLA.MI22.witnessRoot ^ 8 = NLA.MI22.witnessB ∧
                  NLA.MI22.spectralPower NLA.MI22.witnessB (7 / 8) * NLA.MI22.witnessRoot = NLA.MI22.witnessB ∧
                    NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8) * NLA.MI22.witnessRoot =
                        NLA.MI22.witnessN ∧
                      NLA.MI22.operatorNorm NLA.MI22.witnessRoot < 4
NLA.MI22.witness_operator_gap :
  NLA.MI22.operatorNorm (NLA.MI22.witnessA * NLA.MI22.witnessB) < 10500 ∧
    11000 < NLA.MI22.operatorNorm (NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8))
NLA.MI22.counterexample :
  Matrix.PosDef NLA.MI22.witnessA ∧
    Matrix.PosDef NLA.MI22.witnessB ∧
      0 ≤ 1 / 8 ∧
        1 / 8 ≤ 1 ∧
          NLA.MI22.singularValue (NLA.MI22.witnessA * NLA.MI22.witnessB) 0 <
              NLA.MI22.singularValue (NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8)) 0 ∧
            ¬NLA.MI22.SingularLogMajorized (NLA.MI22.leftProduct NLA.MI22.witnessA NLA.MI22.witnessB (1 / 8))
                (NLA.MI22.witnessA * NLA.MI22.witnessB)
NLA.MI22.not_weightedLogMajorizationConjecture : ¬NLA.MI22.WeightedLogMajorizationConjecture
LinearMap.singularValues_fin.{u_1, u_2, u_3} {𝕜 : Type u_1} [RCLike 𝕜] {E : Type u_2} [NormedAddCommGroup E]
  [InnerProductSpace 𝕜 E] [FiniteDimensional 𝕜 E] {F : Type u_3} [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
  [FiniteDimensional 𝕜 F] (T : E →ₗ[𝕜] F) {n : ℕ} (hn : Module.finrank 𝕜 E = n) (i : Fin n) :
  T.singularValues ↑i = √(⋯.eigenvalues hn i)
LinearMap.singularValues_antitone.{u_1, u_2, u_3} {𝕜 : Type u_1} [RCLike 𝕜] {E : Type u_2} [NormedAddCommGroup E]
  [InnerProductSpace 𝕜 E] [FiniteDimensional 𝕜 E] {F : Type u_3} [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
  [FiniteDimensional 𝕜 F] (T : E →ₗ[𝕜] F) : Antitone ⇑T.singularValues
LinearMap.singularValues_of_finrank_le.{u_1, u_2, u_3} {𝕜 : Type u_1} [RCLike 𝕜] {E : Type u_2} [NormedAddCommGroup E]
  [InnerProductSpace 𝕜 E] [FiniteDimensional 𝕜 E] {F : Type u_3} [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
  [FiniteDimensional 𝕜 F] (T : E →ₗ[𝕜] F) {i : ℕ} (hi : Module.finrank 𝕜 E ≤ i) : T.singularValues i = 0
CFC.rpow_rpow.{u_1} {A : Type u_1} [PartialOrder A] [Ring A] [StarRing A] [TopologicalSpace A] [StarOrderedRing A]
  [Algebra ℝ A] [ContinuousFunctionalCalculus ℝ A IsSelfAdjoint] [NonnegSpectrumClass ℝ A] [IsSemitopologicalRing A]
  [T2Space A] (a : A) (x y : ℝ) (hx : x ≠ 0) (ha : IsStrictlyPositive a := by cfc_tac) : (a ^ x) ^ y = a ^ (x * y)
CFC.rpow_natCast.{u_1} {A : Type u_1} [PartialOrder A] [Ring A] [StarRing A] [TopologicalSpace A] [StarOrderedRing A]
  [Algebra ℝ A] [ContinuousFunctionalCalculus ℝ A IsSelfAdjoint] [NonnegSpectrumClass ℝ A] (a : A) (n : ℕ)
  (ha : 0 ≤ a := by cfc_tac) : a ^ ↑n = a ^ n
CFC.rpow_add.{u_1} {A : Type u_1} [PartialOrder A] [Ring A] [StarRing A] [TopologicalSpace A] [StarOrderedRing A]
  [Algebra ℝ A] [ContinuousFunctionalCalculus ℝ A IsSelfAdjoint] [NonnegSpectrumClass ℝ A] {a : A} {x y : ℝ}
  (ha : IsUnit a) : a ^ (x + y) = a ^ x * a ^ y
Matrix.l2_opNorm_toEuclideanCLM.{u_1, u_3} {𝕜 : Type u_1} {n : Type u_3} [RCLike 𝕜] [Fintype n] [DecidableEq n]
  (A : Matrix n n 𝕜) : ‖Matrix.toEuclideanCLM A‖ = ‖A‖
Matrix.l2_opNorm_conjTranspose_mul_self.{u_1, u_2, u_3} {𝕜 : Type u_1} {m : Type u_2} {n : Type u_3} [RCLike 𝕜]
  [Fintype m] [Fintype n] [DecidableEq n] (A : Matrix m n 𝕜) : ‖A.conjTranspose * A‖ = ‖A‖ * ‖A‖
