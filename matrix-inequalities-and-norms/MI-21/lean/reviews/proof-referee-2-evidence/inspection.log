theorem NLA.MI21.geometricMean_eq_of_riccati : ∀ {n : ℕ} (A B K X : NLA.MI21.Mat n),
  Matrix.PosDef A → Matrix.PosSemidef X → A * K = 1 → X * K * X = B → NLA.MI21.geometricMean A B (1 / 2) = X :=
fun {n} A B K X hA hX hAK hXX =>
  let H := CFC.rpow A (1 / 2);
  let J := CFC.rpow A (-1 / 2);
  have hHJ :=
    have ht := CFC.rpow_mul_rpow_neg (1 / 2) (Matrix.PosDef.isStrictlyPositive hA);
    Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (congrArg (HMul.hMul (CFC.rpow A (1 / 2)))
              (CFC.rpow.congr_simp A A (Eq.refl A) (-1 / 2) (-(1 / 2)) (neg_div 2 1))))
          1))
      ht;
  have hJH :=
    have ht := CFC.rpow_neg_mul_rpow (1 / 2) (Matrix.PosDef.isStrictlyPositive hA);
    Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (congrFun' (congrArg HMul.hMul (CFC.rpow.congr_simp A A (Eq.refl A) (-1 / 2) (-(1 / 2)) (neg_div 2 1)))
              (CFC.rpow A (1 / 2))))
          1))
      ht;
  have hIA :=
    id
      (Eq.mp
        (congrFun'
          (congrArg Eq
            (congrArg (HMul.hMul (A ^ (-1))) (CFC.rpow_one A (Matrix.PosSemidef.nonneg (Matrix.PosDef.posSemidef hA)))))
          1)
        (CFC.rpow_neg_mul_rpow 1 (Matrix.PosDef.isStrictlyPositive hA)));
  have hK :=
    Trans.trans
      (Eq.mpr (id (congrArg (fun _a => CFC.rpow A (-1) = CFC.rpow A (-1) * _a) hAK))
        (Eq.mpr (id (congrArg (fun _a => CFC.rpow A (-1) = _a) (mul_one (CFC.rpow A (-1)))))
          (Eq.refl (CFC.rpow A (-1)))))
      (Eq.mpr (id (congrArg (fun _a => _a = K) (Eq.symm (mul_assoc (CFC.rpow A (-1)) A K))))
        (Eq.mpr (id (congrArg (fun _a => _a * K = K) hIA))
          (Eq.mpr (id (congrArg (fun _a => _a = K) (one_mul K))) (Eq.refl K))));
  have hJJ :=
    id
      (Eq.mpr (id (congrArg (fun _a => _a = K) (Eq.symm (CFC.rpow_add (Matrix.PosDef.isUnit hA)))))
        (Eq.mpr
          (id
            (congrFun'
              (congrArg Eq
                (congrArg (HPow.hPow A)
                  (Mathlib.Meta.NormNum.IsInt.neg_to_eq
                    (Mathlib.Meta.NormNum.IsRat.to_isInt
                      (Mathlib.Meta.NormNum.isRat_add (Eq.refl HAdd.hAdd)
                        (Mathlib.Meta.NormNum.isRat_div
                          (Mathlib.Meta.NormNum.isRat_mul (Eq.refl HMul.hMul)
                            (Mathlib.Meta.NormNum.IsInt.to_isRat
                              (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                                (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one))
                                (Eq.refl (Int.negOfNat 1))))
                            (Mathlib.Meta.NormNum.IsNNRat.to_isRat
                              (Mathlib.Meta.NormNum.isNNRat_inv_pos
                                (Mathlib.Meta.NormNum.IsNat.to_isNNRat
                                  (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)))))
                            (Eq.refl ((Int.negOfNat 1).mul (Int.ofNat 1))) (Eq.refl 2)))
                        (Mathlib.Meta.NormNum.isRat_div
                          (Mathlib.Meta.NormNum.isRat_mul (Eq.refl HMul.hMul)
                            (Mathlib.Meta.NormNum.IsInt.to_isRat
                              (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                                (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one))
                                (Eq.refl (Int.negOfNat 1))))
                            (Mathlib.Meta.NormNum.IsNNRat.to_isRat
                              (Mathlib.Meta.NormNum.isNNRat_inv_pos
                                (Mathlib.Meta.NormNum.IsNat.to_isNNRat
                                  (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)))))
                            (Eq.refl ((Int.negOfNat 1).mul (Int.ofNat 1))) (Eq.refl 2)))
                        (Eq.refl (Int.negOfNat 4)) (Eq.refl 4)))
                    Nat.cast_one)))
              K))
          hK));
  have hZ := Matrix.nonneg_iff_posSemidef.mp (conjugate_nonneg_of_nonneg (Matrix.PosSemidef.nonneg hX) CFC.rpow_nonneg);
  have hZsq :=
    Trans.trans
      (of_eq_true
        (Eq.trans
          (congr
            (congrArg Eq
