            (congrArg (HSMul.hSMul (1 / ↑h)) (pow_two N)))
          (eq_self ((1 / ↑h) • (N * N))))))
theorem NLA.MI21.real_eigenvalue_le_operatorNorm : ∀ {n : ℕ} (A : NLA.MI21.Mat n) (v : Fin n → ℂ) (lam : ℝ),
  0 ≤ lam → v ≠ 0 → Matrix.mulVec A v = ↑lam • v → lam ≤ NLA.MI21.operatorNorm A :=
fun {n} A v lam hlam hv he =>
  let x := WithLp.toLp 2 v;
  have hx := fun h => hv (congrArg WithLp.ofLp h);
  have hTx :=
    of_eq_true
      (Eq.trans (congrFun' (congrArg Eq (congrArg (WithLp.toLp 2) he)) (↑lam • WithLp.toLp 2 v))
        (eq_self (↑lam • WithLp.toLp 2 v)));
  have hb := ContinuousLinearMap.le_opNorm (Matrix.toEuclideanCLM A) x;
  (mul_le_mul_iff_left₀ (norm_pos_iff.mpr hx)).mp
    (Eq.mp (congrArg (fun _a => _a * ‖x‖ ≤ ‖Matrix.toEuclideanCLM A‖ * ‖x‖) (Complex.norm_of_nonneg hlam))
      (Eq.mp (congrArg (fun _a => _a ≤ ‖Matrix.toEuclideanCLM A‖ * ‖x‖) (norm_smul (↑lam) x))
        (Eq.mp (congrArg (fun _a => ‖_a‖ ≤ ‖Matrix.toEuclideanCLM A‖ * ‖x‖) hTx) hb)))
