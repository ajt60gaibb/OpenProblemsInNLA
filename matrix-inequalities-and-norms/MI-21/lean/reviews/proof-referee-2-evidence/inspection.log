  have hX := Matrix.PosSemidef.smul hN hc;
  have hric :=
    Trans.trans
      (Trans.trans
        (of_eq_true
          (Eq.trans
            (congrFun'
              (congrArg Eq
                (Eq.trans
                  (Eq.trans (congrFun' (congrArg HMul.hMul (smul_mul_assoc c N K)) (c • N))
