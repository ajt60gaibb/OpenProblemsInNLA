                (mul_assoc J (X * (J * (J * X))) J))
              (congrArg (HMul.hMul J)
                (Eq.trans (mul_assoc X (J * (J * X)) J)
                  (congrArg (HMul.hMul X)
                    (Eq.trans (mul_assoc J (J * X) J) (congrArg (HMul.hMul J) (mul_assoc J X J))))))))
          (eq_self (J * (X * (J * (J * (X * J))))))))
      (Eq.mpr (id (congrArg (fun _a => J * (X * _a * X) * J = J * B * J) hJJ))
        (Eq.mpr (id (congrArg (fun _a => J * _a * J = J * B * J) hXX)) (Eq.refl (J * B * J))));
  have hsqrt := CFC.sqrt_unique hZsq (Matrix.PosSemidef.nonneg hZ);
  id
    (Eq.mpr (id (congrArg (fun _a => H * _a * H = X) (NLA.MI21.rpow_half_eq_sqrt (J * B * J))))
      (Eq.mpr (id (congrArg (fun _a => H * _a * H = X) hsqrt))
        (Trans.trans
          (of_eq_true
            (Eq.trans
              (congr
                (congrArg Eq
                  (Eq.trans
                    (Eq.trans (congrFun' (congrArg HMul.hMul (congrArg (HMul.hMul H) (mul_assoc J X J))) H)
                      (mul_assoc H (J * (X * J)) H))
                    (congrArg (HMul.hMul H)
                      (Eq.trans (mul_assoc J (X * J) H) (congrArg (HMul.hMul J) (mul_assoc X J H))))))
                (Eq.trans
                  (Eq.trans (congrFun' (congrArg HMul.hMul (mul_assoc H J X)) (J * H)) (mul_assoc H (J * X) (J * H)))
                  (congrArg (HMul.hMul H) (mul_assoc J X (J * H)))))
              (eq_self (H * (J * (X * (J * H)))))))
          (Eq.mpr (id (congrArg (fun _a => _a * X * (J * H) = X) hHJ))
            (Eq.mpr (id (congrArg (fun _a => 1 * X * _a = X) hJH))
              (Eq.mpr (id (congrArg (fun _a => _a * 1 = X) (one_mul X)))
                (Eq.mpr (id (congrArg (fun _a => _a = X) (mul_one X))) (Eq.refl X))))))))
theorem NLA.MI21.mean_squared_of_scaled_riccati : ∀ {n : ℕ} (A B K N : NLA.MI21.Mat n) (h : ℝ),
  Matrix.PosDef A →
    Matrix.PosSemidef N →
      0 < h →
        A * K = 1 →
          N * K * N = ↑h • B → NLA.MI21.spectralPower (NLA.MI21.geometricMean A B (1 / 2)) 2 = (1 / ↑h) • N ^ 2 :=
fun {n} A B K N h hA hN hh hAK hNN =>
  let c := ↑(1 / √h);
  have hc :=
    id
      (cast
        (Eq.trans
          (Eq.trans
            (congr (congrArg LE.le (Eq.symm Nat.cast_zero)) (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) √h))
            (congr (congrArg LE.le Nat.cast_zero) (congrFun' (congrArg HDiv.hDiv Nat.cast_one) √h)))
          (Eq.symm
            (Eq.trans
              (Eq.trans
                (congr (congrArg LE.le (Eq.symm Nat.cast_zero))
                  (congrArg Complex.ofReal (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) √h)))
                (Eq.trans
                  (congrArg (fun x => x ≤ ↑(↑1 / √h))
                    (Eq.trans Nat.cast_zero (Eq.symm (congrArg Complex.ofReal Nat.cast_zero))))
                  Complex.real_le_real._simp_1))
              (congr (congrArg LE.le Nat.cast_zero) (congrFun' (congrArg HDiv.hDiv Nat.cast_one) √h)))))
        (div_nonneg
          (Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)
            (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one) (Eq.refl true))
          (Real.sqrt_nonneg h)));
  have hc2 :=
    have hr :=
      Eq.mpr (id (congrArg (fun _a => _a = 1 / h) (one_div_pow (√h) 2)))
        (Eq.mpr (id (congrArg (fun _a => 1 / _a = 1 / h) (Real.sq_sqrt (LT.lt.le hh)))) (Eq.refl (1 / h)));
    id
      (cast
        (Eq.trans
          (Eq.trans
            (congr
              (congrArg Eq
                (congr (congrArg HMul.hMul (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) √h))
                  (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) √h)))
              (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) h))
            (congr
              (congrArg Eq
                (congr (congrArg HMul.hMul (congrFun' (congrArg HDiv.hDiv Nat.cast_one) √h))
                  (congrFun' (congrArg HDiv.hDiv Nat.cast_one) √h)))
              (congrFun' (congrArg HDiv.hDiv Nat.cast_one) h)))
          (Eq.symm
            (Eq.trans
              (Eq.trans
                (congr
                  (congrArg Eq
                    (congr
                      (congrArg HMul.hMul
                        (congrArg Complex.ofReal (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) √h)))
                      (congrArg Complex.ofReal (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) √h))))
                  (congrFun' (congrArg HDiv.hDiv (Eq.symm Nat.cast_one)) ↑h))
                (Eq.trans
                  (congr (congrArg Eq (Complex.ofReal_mul._simp_1 (↑1 / √h) (↑1 / √h)))
                    (Eq.trans
                      (congrArg (fun x => x / ↑h)
                        (Eq.trans Nat.cast_one (Eq.symm (congrArg Complex.ofReal Nat.cast_one))))
                      (Complex.ofReal_div._simp_1 (↑1) h)))
                  Complex.ofReal_inj._simp_1))
              (congr
                (congrArg Eq
                  (congr (congrArg HMul.hMul (congrFun' (congrArg HDiv.hDiv Nat.cast_one) √h))
                    (congrFun' (congrArg HDiv.hDiv Nat.cast_one) √h)))
                (congrFun' (congrArg HDiv.hDiv Nat.cast_one) h)))))
        (have this := Eq.mp (congrFun' (congrArg Eq (pow_two (1 / √h))) (1 / h)) hr;
