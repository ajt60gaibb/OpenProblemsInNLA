                    B)
                  (one_smul ℂ B)))
              B)
            (eq_self B))));
  have hp := NLA.MI21.spectralPower_nat (c • N) hX 2;
  Eq.mpr
    (id
      (congrArg (fun _a => NLA.MI21.spectralPower _a 2 = (1 / ↑h) • N ^ 2)
        (NLA.MI21.geometricMean_eq_of_riccati A B K (c • N) hA hX hAK hric)))
    (Eq.mpr (id (congrArg (fun _a => _a = (1 / ↑h) • N ^ 2) hp))
      (of_eq_true
