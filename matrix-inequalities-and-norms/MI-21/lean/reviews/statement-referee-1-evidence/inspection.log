def NLA.MI21.GeometricMeanNormConjecture : Prop :=
∀ (m n : Nat),
  @LE.le.{0} Nat instLENat (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) m →
    @LE.le.{0} Nat instLENat (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) n →
      ∀ (A B : Fin m → NLA.MI21.Mat n),
        (∀ (i : Fin m),
            @Matrix.PosDef.{0, 0} (Fin n) Complex Complex.instRing Complex.partialOrder Complex.instStarRing (A i)) →
          (∀ (i : Fin m),
              @Matrix.PosDef.{0, 0} (Fin n) Complex Complex.instRing Complex.partialOrder Complex.instStarRing (B i)) →
            ∀ (t s r p : Real),
              @LE.le.{0} Real Real.instLE (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero))
                  t →
                @LE.le.{0} Real Real.instLE t
                    (@OfNat.ofNat.{0} Real (nat_lit 1) (@One.toOfNat1.{0} Real Real.instOne)) →
                  @LT.lt.{0} Real Real.instLT
                      (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero)) s →
                    @LT.lt.{0} Real Real.instLT
                        (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero)) r →
                      @LT.lt.{0} Real Real.instLT
                          (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero)) p →
                        @LE.le.{0} Real Real.instLE
                            (@OfNat.ofNat.{0} Real (nat_lit 1) (@One.toOfNat1.{0} Real Real.instOne))
                            (@HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul) s r) →
                          ∀ (ν : NLA.MI21.Mat n → Real),
                            @NLA.MI21.IsUnitaryInvariantNorm n ν →
                              @LE.le.{0} Real Real.instLE (ν (@NLA.MI21.leftMatrix m n A B s t r))
                                (ν (@NLA.MI21.rightMatrix m n A B s t r p))
NLA.MI21.operatorNorm_isUnitaryInvariant (n : ℕ) : NLA.MI21.IsUnitaryInvariantNorm NLA.MI21.operatorNorm
NLA.MI21.counterexample (p : ℝ) (hp : 0 < p) :
  (∀ (i : Fin 2), Matrix.PosDef (NLA.MI21.witnessA i) ∧ Matrix.PosDef (NLA.MI21.witnessB i)) ∧
    ∑ i, NLA.MI21.witnessA i = 1 ∧
      ∑ i, NLA.MI21.witnessB i = 1 ∧
        NLA.MI21.leftMatrix NLA.MI21.witnessA NLA.MI21.witnessB (1 / 2) (1 / 2) 2 = NLA.MI21.witnessL ∧
          NLA.MI21.rightMatrix NLA.MI21.witnessA NLA.MI21.witnessB (1 / 2) (1 / 2) 2 p = 1 ∧
            NLA.MI21.witnessVector ≠ 0 ∧
              Matrix.mulVec NLA.MI21.witnessL NLA.MI21.witnessVector =
                  ↑NLA.MI21.witnessEigenvalue • NLA.MI21.witnessVector ∧
                1 < NLA.MI21.witnessEigenvalue ∧
                  NLA.MI21.witnessEigenvalue ≤
                      NLA.MI21.operatorNorm
                        (NLA.MI21.leftMatrix NLA.MI21.witnessA NLA.MI21.witnessB (1 / 2) (1 / 2) 2) ∧
                    NLA.MI21.operatorNorm
                          (NLA.MI21.rightMatrix NLA.MI21.witnessA NLA.MI21.witnessB (1 / 2) (1 / 2) 2 p) =
                        1 ∧
                      NLA.MI21.operatorNorm
                          (NLA.MI21.rightMatrix NLA.MI21.witnessA NLA.MI21.witnessB (1 / 2) (1 / 2) 2 p) <
                        NLA.MI21.operatorNorm
                          (NLA.MI21.leftMatrix NLA.MI21.witnessA NLA.MI21.witnessB (1 / 2) (1 / 2) 2)
NLA.MI21.not_geometricMeanNormConjecture : ¬NLA.MI21.GeometricMeanNormConjecture
