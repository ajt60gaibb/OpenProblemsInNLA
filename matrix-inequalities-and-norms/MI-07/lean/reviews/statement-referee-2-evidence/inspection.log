NLA.MI07.modulus_eq_sqrt {n : ℕ} (X : Matrix (Fin n) (Fin n) ℂ) :
  NLA.MI07.matrixModulus X = CFC.sqrt (X.conjTranspose * X) ∧ (NLA.MI07.matrixModulus X).PosSemidef
NLA.MI07.maximalModulus_eq_of_tendsto {n : ℕ} (X L : Matrix (Fin n) (Fin n) ℂ)
  (h : Filter.Tendsto (NLA.MI07.rootSequence X) Filter.atTop (nhds L)) : NLA.MI07.maximalModulus X = L
NLA.MI07.root_limit_iff_spectralNorm {n : ℕ} (X L : Matrix (Fin n) (Fin n) ℂ) :
  Filter.Tendsto (NLA.MI07.rootSequence X) Filter.atTop (nhds L) ↔
    Filter.Tendsto (fun r => NLA.MI07.spectralNorm (NLA.MI07.rootSequence X r - L)) Filter.atTop (nhds 0)
NLA.MI07.witness_moduli :
  NLA.MI07.witnessA.PosSemidef ∧
    NLA.MI07.directionProjector.PosSemidef ∧
      NLA.MI07.spanningSum.PosDef ∧
        NLA.MI07.witnessA ^ 2 = NLA.MI07.witnessA ∧
          NLA.MI07.directionProjector ^ 2 = NLA.MI07.directionProjector ∧
            NLA.MI07.matrixModulus NLA.MI07.witnessA = NLA.MI07.witnessA ∧
              NLA.MI07.matrixModulus NLA.MI07.witnessA.conjTranspose = NLA.MI07.witnessA ∧
                NLA.MI07.matrixModulus NLA.MI07.witnessB = (5 / 12) • (1 - NLA.MI07.witnessA) ∧
                  NLA.MI07.matrixModulus NLA.MI07.witnessB.conjTranspose = (5 / 12) • NLA.MI07.witnessA ∧
                    NLA.MI07.matrixModulus (NLA.MI07.witnessA + NLA.MI07.witnessB) =
                        (13 / 12) • NLA.MI07.directionProjector ∧
                      NLA.MI07.matrixModulus (NLA.MI07.witnessA + NLA.MI07.witnessB).conjTranspose =
                        (13 / 12) • NLA.MI07.witnessA
NLA.MI07.witness_root_limits :
  Filter.Tendsto (NLA.MI07.rootSequence NLA.MI07.witnessA) Filter.atTop (nhds NLA.MI07.witnessA) ∧
    Filter.Tendsto (NLA.MI07.rootSequence NLA.MI07.witnessB) Filter.atTop (nhds ((5 / 12) • 1)) ∧
      Filter.Tendsto (NLA.MI07.rootSequence (NLA.MI07.witnessA + NLA.MI07.witnessB)) Filter.atTop (nhds ((13 / 12) • 1))
NLA.MI07.counterexample :
  NLA.MI07.maximalModulus NLA.MI07.witnessA = NLA.MI07.witnessA ∧
    NLA.MI07.maximalModulus NLA.MI07.witnessB = (5 / 12) • 1 ∧
      NLA.MI07.maximalModulus (NLA.MI07.witnessA + NLA.MI07.witnessB) = (13 / 12) • 1 ∧
        (NLA.MI07.maximalModulus (NLA.MI07.witnessA + NLA.MI07.witnessB)).trace = 13 / 6 ∧
          ∀ (U V : ↥(Matrix.unitaryGroup (Fin 2) ℂ)),
            (NLA.MI07.unitaryConjugate U (NLA.MI07.maximalModulus NLA.MI07.witnessA) +
                    NLA.MI07.unitaryConjugate V (NLA.MI07.maximalModulus NLA.MI07.witnessB)).trace =
                11 / 6 ∧
              (NLA.MI07.unitaryConjugate U (NLA.MI07.maximalModulus NLA.MI07.witnessA) +
                        NLA.MI07.unitaryConjugate V (NLA.MI07.maximalModulus NLA.MI07.witnessB) -
                      NLA.MI07.maximalModulus (NLA.MI07.witnessA + NLA.MI07.witnessB)).trace =
                  -1 / 3 ∧
                ¬NLA.MI07.maximalModulus (NLA.MI07.witnessA + NLA.MI07.witnessB) ≤
                    NLA.MI07.unitaryConjugate U (NLA.MI07.maximalModulus NLA.MI07.witnessA) +
                      NLA.MI07.unitaryConjugate V (NLA.MI07.maximalModulus NLA.MI07.witnessB)
NLA.MI07.not_triangleConjecture : ¬NLA.MI07.TriangleConjecture
