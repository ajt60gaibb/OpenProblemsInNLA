theorem NLA.MI29.not_modulusDeterminantConjecture_proved : ¬NLA.MI29.ModulusDeterminantConjecture :=
fun h =>
  have hle :=
    h 3
      (Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 1))
        (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 3)) (Eq.refl true))
      NLA.MI29.witnessA NLA.MI29.witnessB NLA.MI29.witnessA_posDef NLA.MI29.witnessB_hermitian NLA.MI29.witnessB_isUnit
      6 8
      (Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)
        (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 6)) (Eq.refl true))
      (Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)
        (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 8)) (Eq.refl true));
  not_le_of_gt NLA.MI29.witness_strict_violation hle
theorem NLA.MI29.spectralPower_natCast : ∀ {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ),
  A.PosSemidef → ∀ (r : ℕ), NLA.MI29.spectralPower A ↑r = A ^ r :=
fun {n} A hA r => NLA.MI29.spectralPower_natCast_proved A hA r
theorem NLA.MI29.modulus_power_eight : ∀ {n : ℕ} (X : Matrix (Fin n) (Fin n) ℂ),
  NLA.MI29.matrixModulus X = CFC.sqrt (X.conjTranspose * X) ∧
    (NLA.MI29.matrixModulus X).PosSemidef ∧
      NLA.MI29.spectralPower (NLA.MI29.matrixModulus X) 8 = (X.conjTranspose * X) ^ 4 :=
fun {n} X => NLA.MI29.modulus_power_eight_proved X
theorem NLA.MI29.comparison_positive_real : ∀ {n : ℕ},
  1 ≤ n →
    ∀ (A B : Matrix (Fin n) (Fin n) ℂ),
      A.PosDef →
        B.IsHermitian →
          IsUnit B →
            ∀ (k p : ℝ),
              0 ≤ k →
                0 ≤ p →
                  (NLA.MI29.leftDet A B k p).im = 0 ∧
                    0 < (NLA.MI29.leftDet A B k p).re ∧
                      (NLA.MI29.rightDet A B k p).im = 0 ∧ 0 < (NLA.MI29.rightDet A B k p).re :=
fun {n} hn A B hA hB hBinv k p hk hp => NLA.MI29.comparison_positive_real_proved hn A B hA hB hBinv k p hk hp
