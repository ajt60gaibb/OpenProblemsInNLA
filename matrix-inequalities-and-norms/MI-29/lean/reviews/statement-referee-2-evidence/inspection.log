theorem NLA.MI29.modulus_power_eight : ∀ {n : ℕ} (X : Matrix (Fin n) (Fin n) ℂ),
  NLA.MI29.matrixModulus X = CFC.sqrt (X.conjTranspose * X) ∧
    (NLA.MI29.matrixModulus X).PosSemidef ∧
      NLA.MI29.spectralPower (NLA.MI29.matrixModulus X) 8 = (X.conjTranspose * X) ^ 4 :=
fun {n} X => sorry
theorem NLA.MI29.comparison_positive_real : ∀ {n : ℕ},
  1 ≤ n →
    ∀ (A B : Matrix (Fin n) (Fin n) ℂ),
      A.PosDef →
        B.IsHermitian →
          IsUnit B →
            ∀ (k p : ℝ),
              0 ≤ k →
                0 ≤ p →
                  (NLA.MI29.leftDet A B k p).im = 0 ∧
                    0 < (NLA.MI29.leftDet A B k p).re ∧
                      (NLA.MI29.rightDet A B k p).im = 0 ∧ 0 < (NLA.MI29.rightDet A B k p).re :=
fun {n} hn A B hA hB hBinv k p hk hp => sorry
theorem NLA.MI29.counterexample : NLA.MI29.witnessA.PosDef ∧
  NLA.MI29.witnessB.IsHermitian ∧
    IsUnit NLA.MI29.witnessB ∧
      NLA.MI29.witnessB.det = -1 / 125 ∧
        ¬NLA.MI29.witnessB.PosSemidef ∧
          ¬(-NLA.MI29.witnessB).PosSemidef ∧
            NLA.MI29.spectralPower NLA.MI29.witnessA 6 = NLA.MI29.witnessA ^ 6 ∧
              NLA.MI29.spectralPower (NLA.MI29.matrixModulus (NLA.MI29.witnessA * NLA.MI29.witnessB)) 8 =
                  (NLA.MI29.witnessB * NLA.MI29.witnessA ^ 2 * NLA.MI29.witnessB) ^ 4 ∧
                NLA.MI29.spectralPower (NLA.MI29.matrixModulus (NLA.MI29.witnessB * NLA.MI29.witnessA)) 8 =
                    (NLA.MI29.witnessA * NLA.MI29.witnessB ^ 2 * NLA.MI29.witnessA) ^ 4 ∧
                  NLA.MI29.leftDet NLA.MI29.witnessA NLA.MI29.witnessB 6 8 =
                      136990346414301954149 / 61035156250000000000 ∧
                    NLA.MI29.rightDet NLA.MI29.witnessA NLA.MI29.witnessB 6 8 =
                        4537743716162890657 / 1907348632812500000 ∧
                      NLA.MI29.rightDet NLA.MI29.witnessA NLA.MI29.witnessB 6 8 -
                            NLA.MI29.leftDet NLA.MI29.witnessA NLA.MI29.witnessB 6 8 =
                          21036678407451 / 156250000000000 ∧
                        NLA.MI29.leftDet NLA.MI29.witnessA NLA.MI29.witnessB 6 8 <
                          NLA.MI29.rightDet NLA.MI29.witnessA NLA.MI29.witnessB 6 8 :=
sorry
