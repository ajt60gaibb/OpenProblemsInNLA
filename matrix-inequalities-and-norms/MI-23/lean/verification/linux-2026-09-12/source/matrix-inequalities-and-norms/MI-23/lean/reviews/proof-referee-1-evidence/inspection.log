@NLA.MI23.positive_powers_and_means : ∀ {n : ℕ} (A B : NLA.MI23.Mat n),
  Matrix.PosDef A →
    Matrix.PosDef B →
      ∀ (r t : ℝ), Matrix.PosDef (NLA.MI23.spectralPower A r) ∧ Matrix.PosDef (NLA.MI23.generalizedMean A B r t)
'NLA.MI23.positive_powers_and_means' depends on axioms: [propext, Classical.choice, Quot.sound]
@NLA.MI23.product_eigenvalue_semantics : ∀ {n : ℕ} (X Y : NLA.MI23.Mat n),
  Matrix.PosDef X →
    Matrix.PosDef Y →
      have R := NLA.MI23.spectralPower Y (1 / 2);
      have Rinv := NLA.MI23.spectralPower Y (-1 / 2);
      have S := R * X * R;
      S.PosDef ∧
        R * Rinv = 1 ∧
          Rinv * R = 1 ∧
            R * (X * Y) * Rinv = S ∧ (X * Y).charpoly = S.charpoly ∧ NLA.MI23.HasOrderedPositiveEigenvalues (X * Y)
'NLA.MI23.product_eigenvalue_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
@NLA.MI23.squared_product_largest : ∀ {n : ℕ},
  1 ≤ n →
    ∀ (X Y : NLA.MI23.Mat n),
      Matrix.PosDef X → Matrix.PosDef Y → NLA.MI23.largestEigenvalue (X ^ 2 * Y ^ 2) = NLA.MI23.operatorNorm (X * Y) ^ 2
'NLA.MI23.squared_product_largest' depends on axioms: [propext, Classical.choice, Quot.sound]
@NLA.MI23.operator_norm_bounds : ∀ {n : ℕ} (X : NLA.MI23.Mat n) (i j : Fin n),
  Complex.normSq (X i j) ≤ NLA.MI23.operatorNorm X ^ 2 ∧ NLA.MI23.operatorNorm X ^ 2 ≤ NLA.MI23.frobeniusSquared X
