def NLA.MI23.spectralPower : {n : ℕ} → NLA.MI23.Mat n → ℝ → NLA.MI23.Mat n :=
fun {n} A r => CFC.rpow A r
def NLA.MI23.generalizedMean : {n : ℕ} → NLA.MI23.Mat n → NLA.MI23.Mat n → ℝ → ℝ → NLA.MI23.Mat n :=
fun {n} A B r t =>
  NLA.MI23.spectralPower A (r / 2) *
      NLA.MI23.spectralPower (NLA.MI23.spectralPower A (-1 / 2) * B * NLA.MI23.spectralPower A (-1 / 2)) t *
    NLA.MI23.spectralPower A (r / 2)
def NLA.MI23.orderedEigenvalues : {n : ℕ} → NLA.MI23.Mat n → List ℝ :=
fun {n} A => (Multiset.map Complex.re (Matrix.charpoly A).roots).sort fun x1 x2 => x1 ≥ x2
def NLA.MI23.HasOrderedPositiveEigenvalues : {n : ℕ} → NLA.MI23.Mat n → Prop :=
fun {n} A =>
  (NLA.MI23.orderedEigenvalues A).length = n ∧
    List.Pairwise (fun x1 x2 => x1 ≥ x2) (NLA.MI23.orderedEigenvalues A) ∧
      (∀ a ∈ NLA.MI23.orderedEigenvalues A, 0 < a) ∧
        (Matrix.charpoly A).roots = ↑(List.map (fun a => ↑a) (NLA.MI23.orderedEigenvalues A)) ∧
          ↑(NLA.MI23.orderedEigenvalues A).prod = Matrix.det A
def NLA.MI23.LogMajorized : List ℝ → List ℝ → Prop :=
fun a b =>
  a.length = b.length ∧
    (∀ (k : ℕ), 1 ≤ k → k < a.length → (List.take k a).prod ≤ (List.take k b).prod) ∧ a.prod = b.prod
def NLA.MI23.largestEigenvalue : {n : ℕ} → NLA.MI23.Mat n → ℝ :=
fun {n} A => (NLA.MI23.orderedEigenvalues A).getD 0 0
def NLA.MI23.GeneralizedGeometricMeanConjecture : Prop :=
∀ (n : ℕ),
  1 ≤ n →
    ∀ (A B : NLA.MI23.Mat n),
      Matrix.PosDef A →
        Matrix.PosDef B →
          ∀ (r s p t : ℝ),
            1 ≤ p →
              0 ≤ t →
                t ≤ 1 →
                  1 ≤ r ∧ 1 ≤ s ∨ r ≤ 0 ∧ s ≤ 0 →
                    NLA.MI23.LogMajorized (NLA.MI23.orderedEigenvalues (NLA.MI23.leftProduct A B r s p t))
                      (NLA.MI23.orderedEigenvalues (NLA.MI23.rightProduct A B r s p))
def NLA.MI23.leftProduct : {n : ℕ} → NLA.MI23.Mat n → NLA.MI23.Mat n → ℝ → ℝ → ℝ → ℝ → NLA.MI23.Mat n :=
fun {n} A B r s p t =>
  NLA.MI23.spectralPower (NLA.MI23.generalizedMean A B r t) p *
    NLA.MI23.spectralPower (NLA.MI23.generalizedMean A B s (1 - t)) p
def NLA.MI23.rightProduct : {n : ℕ} → NLA.MI23.Mat n → NLA.MI23.Mat n → ℝ → ℝ → ℝ → NLA.MI23.Mat n :=
fun {n} A B r s p => NLA.MI23.spectralPower A (p * (r + s - 1)) * NLA.MI23.spectralPower B p
def NLA.MI23.operatorNorm : {n : ℕ} → NLA.MI23.Mat n → ℝ :=
fun {n} A => ‖Matrix.toEuclideanCLM A‖
def NLA.MI23.frobeniusSquared : {n : ℕ} → NLA.MI23.Mat n → ℝ :=
fun {n} A => ∑ i, ∑ j, Complex.normSq (A i j)
theorem NLA.MI23.positive_powers_and_means : ∀ {n : ℕ} (A B : NLA.MI23.Mat n),
  Matrix.PosDef A →
    Matrix.PosDef B →
      ∀ (r t : ℝ), Matrix.PosDef (NLA.MI23.spectralPower A r) ∧ Matrix.PosDef (NLA.MI23.generalizedMean A B r t) :=
⋯
theorem NLA.MI23.product_eigenvalue_semantics : ∀ {n : ℕ} (X Y : NLA.MI23.Mat n),
  Matrix.PosDef X →
    Matrix.PosDef Y →
      have R := NLA.MI23.spectralPower Y (1 / 2);
      have Rinv := NLA.MI23.spectralPower Y (-1 / 2);
      have S := R * X * R;
      S.PosDef ∧
        R * Rinv = 1 ∧
          Rinv * R = 1 ∧
            R * (X * Y) * Rinv = S ∧ (X * Y).charpoly = S.charpoly ∧ NLA.MI23.HasOrderedPositiveEigenvalues (X * Y) :=
⋯
theorem NLA.MI23.squared_product_largest : ∀ {n : ℕ},
  1 ≤ n →
    ∀ (X Y : NLA.MI23.Mat n),
      Matrix.PosDef X →
        Matrix.PosDef Y → NLA.MI23.largestEigenvalue (X ^ 2 * Y ^ 2) = NLA.MI23.operatorNorm (X * Y) ^ 2 :=
⋯
theorem NLA.MI23.operator_norm_bounds : ∀ {n : ℕ} (X : NLA.MI23.Mat n) (i j : Fin n),
  Complex.normSq (X i j) ≤ NLA.MI23.operatorNorm X ^ 2 ∧ NLA.MI23.operatorNorm X ^ 2 ≤ NLA.MI23.frobeniusSquared X :=
⋯
theorem NLA.MI23.witness_data : Matrix.PosDef NLA.MI23.witnessD ∧
  Matrix.PosDef NLA.MI23.witnessT ∧
    Matrix.PosDef NLA.MI23.witnessA ∧
      Matrix.PosDef NLA.MI23.witnessB ∧
        Matrix.PosDef NLA.MI23.witnessG ∧
          Matrix.PosDef NLA.MI23.witnessH ∧
            NLA.MI23.witnessT = NLA.MI23.witnessL * NLA.MI23.witnessPivots * Matrix.conjTranspose NLA.MI23.witnessL ∧
              NLA.MI23.spectralPower NLA.MI23.witnessA (1 / 2) = NLA.MI23.witnessD ∧
                NLA.MI23.spectralPower NLA.MI23.witnessA (-1 / 2) = NLA.MI23.witnessDInv ∧
                  NLA.MI23.spectralPower NLA.MI23.witnessA (-1 / 2) * NLA.MI23.witnessB *
                        NLA.MI23.spectralPower NLA.MI23.witnessA (-1 / 2) =
                      NLA.MI23.witnessT ^ 8 ∧
                    NLA.MI23.generalizedMean NLA.MI23.witnessA NLA.MI23.witnessB 1 (1 / 8) = NLA.MI23.witnessG ∧
                      NLA.MI23.generalizedMean NLA.MI23.witnessA NLA.MI23.witnessB 1 (7 / 8) = NLA.MI23.witnessH ∧
                        NLA.MI23.leftProduct NLA.MI23.witnessA NLA.MI23.witnessB 1 1 2 (1 / 8) =
                            NLA.MI23.witnessG ^ 2 * NLA.MI23.witnessH ^ 2 ∧
                          NLA.MI23.rightProduct NLA.MI23.witnessA NLA.MI23.witnessB 1 1 2 =
                            NLA.MI23.witnessA ^ 2 * NLA.MI23.witnessB ^ 2 :=
⋯
theorem NLA.MI23.witness_squared_gap : (NLA.MI23.witnessG * NLA.MI23.witnessH) 0 2 = 1260589125202 / 9 ∧
  NLA.MI23.frobeniusSquared (NLA.MI23.witnessA * NLA.MI23.witnessB) = 2009446159144992718181231562721 / 107495424 ∧
    Complex.normSq ((NLA.MI23.witnessG * NLA.MI23.witnessH) 0 2) -
          NLA.MI23.frobeniusSquared (NLA.MI23.witnessA * NLA.MI23.witnessB) =
        NLA.MI23.squaredGap ∧
      0 < NLA.MI23.squaredGap ∧
        NLA.MI23.operatorNorm (NLA.MI23.witnessA * NLA.MI23.witnessB) ^ 2 <
          NLA.MI23.operatorNorm (NLA.MI23.witnessG * NLA.MI23.witnessH) ^ 2 :=
⋯
theorem NLA.MI23.counterexample : Matrix.PosDef NLA.MI23.witnessA ∧
  Matrix.PosDef NLA.MI23.witnessB ∧
    NLA.MI23.largestEigenvalue (NLA.MI23.rightProduct NLA.MI23.witnessA NLA.MI23.witnessB 1 1 2) <
        NLA.MI23.largestEigenvalue (NLA.MI23.leftProduct NLA.MI23.witnessA NLA.MI23.witnessB 1 1 2 (1 / 8)) ∧
      ¬NLA.MI23.LogMajorized
          (NLA.MI23.orderedEigenvalues (NLA.MI23.leftProduct NLA.MI23.witnessA NLA.MI23.witnessB 1 1 2 (1 / 8)))
          (NLA.MI23.orderedEigenvalues (NLA.MI23.rightProduct NLA.MI23.witnessA NLA.MI23.witnessB 1 1 2)) :=
⋯
theorem NLA.MI23.not_generalizedGeometricMeanConjecture : ¬NLA.MI23.GeneralizedGeometricMeanConjecture :=
⋯
'NLA.MI23.GeneralizedGeometricMeanConjecture' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.MI23.orderedEigenvalues' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.MI23.not_generalizedGeometricMeanConjecture' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
