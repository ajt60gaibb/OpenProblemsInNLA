def Matrix.toEuclideanCLM.{u_1, u_3} : {𝕜 : Type u_1} →
  {n : Type u_3} →
    [inst : RCLike.{u_1} 𝕜] →
      [inst_1 : Fintype.{u_3} n] →
        [DecidableEq.{u_3 + 1} n] →
          StarAlgEquiv.{u_1, max u_1 u_3, max u_3 u_1} 𝕜 (Matrix.{u_3, u_3, u_1} n n 𝕜)
            (ContinuousLinearMap.{u_1, u_1, max u_3 u_1, max u_3 u_1} (RingHom.id.{u_1} 𝕜)
              (EuclideanSpace.{u_1, u_3} 𝕜 n) (EuclideanSpace.{u_1, u_3} 𝕜 n)) :=
fun {𝕜} {n} [RCLike.{u_1} 𝕜] [Fintype.{u_3} n] [DecidableEq.{u_3 + 1} n] =>
  StarAlgEquiv.trans.{u_1, max u_1 u_3, max u_1 u_3, max u_1 u_3}
    (StarAlgEquiv.symm.{u_1, max u_1 u_3, max u_1 u_3}
      (LinearMap.toMatrixOrthonormal.{u_1, max u_1 u_3, u_3} (EuclideanSpace.basisFun.{u_3, u_1} n 𝕜)))
    (let __src := LinearMap.toContinuousLinearMap.{u_1, max u_1 u_3, max u_1 u_3};
    StarAlgEquiv.mk.{u_1, max u_1 u_3, max u_1 u_3}
      (StarRingEquiv.mk.{max u_1 u_3, max u_1 u_3}
        (RingEquiv.mk.{max u_1 u_3, max u_1 u_3}
          (Equiv.mk.{(max u_1 u_3) + 1, (max u_1 u_3) + 1}
            (AddHom.toFun.{max u_1 u_3, max u_1 u_3} (LinearMap.toAddHom.{u_1, u_1, max u_1 u_3, max u_1 u_3} ↑__src))
            (LinearEquiv.invFun.{u_1, u_1, max u_1 u_3, max u_1 u_3} __src) ⋯ ⋯)
          ⋯ ⋯)
        ⋯)
      ⋯)
def Matrix.PosSemidef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} →
    [inst : Ring.{u_3} R] → [PartialOrder.{u_3} R] → [StarRing.{u_3} R] → Matrix.{u_2, u_2, u_3} n n R → Prop :=
fun {n} {R} [Ring.{u_3} R] [PartialOrder.{u_3} R] [StarRing.{u_3} R] M =>
  Matrix.IsHermitian.{u_3, u_2} M ∧
    ∀ (x : Finsupp.{u_2, u_3} n R),
      LE.le.{u_3} 0
        (Finsupp.sum.{u_2, u_3, u_3} x fun i xi =>
          Finsupp.sum.{u_2, u_3, u_3} x fun j xj =>
            HMul.hMul.{u_3, u_3, u_3} (HMul.hMul.{u_3, u_3, u_3} (star.{u_3} xi) (M i j)) xj)
