def ConcaveOn.{u_1, u_2, u_5} : (𝕜 : Type u_1) →
  {E : Type u_2} →
    {β : Type u_5} →
      [Semiring.{u_1} 𝕜] →
        [PartialOrder.{u_1} 𝕜] →
          [AddCommMonoid.{u_2} E] →
            [AddCommMonoid.{u_5} β] →
              [PartialOrder.{u_5} β] → [SMul.{u_1, u_2} 𝕜 E] → [SMul.{u_1, u_5} 𝕜 β] → Set.{u_2} E → (E → β) → Prop :=
fun 𝕜 {E} {β} [Semiring.{u_1} 𝕜] [PartialOrder.{u_1} 𝕜] [AddCommMonoid.{u_2} E] [AddCommMonoid.{u_5} β]
    [PartialOrder.{u_5} β] [SMul.{u_1, u_2} 𝕜 E] [SMul.{u_1, u_5} 𝕜 β] s f =>
  Convex.{u_1, u_2} 𝕜 s ∧
    ∀ ⦃x : E⦄,
      Membership.mem.{u_2, u_2} s x →
        ∀ ⦃y : E⦄,
          Membership.mem.{u_2, u_2} s y →
            ∀ ⦃a b : 𝕜⦄,
              LE.le.{u_1} 0 a →
                LE.le.{u_1} 0 b →
                  Eq.{u_1 + 1} (HAdd.hAdd.{u_1, u_1, u_1} a b) 1 →
                    LE.le.{u_5}
                      (HAdd.hAdd.{u_5, u_5, u_5} (HSMul.hSMul.{u_1, u_5, u_5} a (f x))
                        (HSMul.hSMul.{u_1, u_5, u_5} b (f y)))
                      (f
                        (HAdd.hAdd.{u_2, u_2, u_2} (HSMul.hSMul.{u_1, u_2, u_2} a x) (HSMul.hSMul.{u_1, u_2, u_2} b y)))
def MonotoneOn.{u, v} : {α : Type u} →
  {β : Type v} → [Preorder.{u} α] → [Preorder.{v} β] → (α → β) → Set.{u} α → Prop :=
fun {α} {β} [Preorder.{u} α] [Preorder.{v} β] f s =>
  ∀ ⦃a : α⦄, Membership.mem.{u, u} s a → ∀ ⦃b : α⦄, Membership.mem.{u, u} s b → LE.le.{u} a b → LE.le.{v} (f a) (f b)
