    (nonnegative : ∀ (i : Fin n), LE.le.{0} 0 (eigenvalues i))
    (reconstruct :
      Eq.{1} A
        (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (↑orthogonal) (Matrix.diagonal.{0, 0} eigenvalues))
