  {A : NLA.RA08.RealMatrix n} → NLA.RA08.OrderedSpectralData A → (ℝ → ℝ) → ℕ → NLA.RA08.RealMatrix n :=
fun {n} {A} d f k => NLA.RA08.spectralCombination d fun i => ite.{1} (LT.lt.{0} (↑i) k) (f (d.eigenvalues i)) 0
def NLA.RA08.functionalCalculus : {n : ℕ} → (ℝ → ℝ) → NLA.RA08.RealMatrix n → NLA.RA08.RealMatrix n :=
fun {n} f A => cfc.{0, 0} f A
def NLA.RA08.ConcaveSpectralTransferConjecture : Prop :=
∀ (n : ℕ),
  LE.le.{0} 2 n →
    ∀ (k : ℕ),
      LE.le.{0} 1 k →
        LT.lt.{0} k n →
          ∀ (A Ahat : NLA.RA08.RealMatrix n),
            Matrix.PosSemidef.{0, 0} A →
              Matrix.PosSemidef.{0, 0} Ahat →
                LE.le.{0} Ahat A →
                  ∀ (f : ℝ → ℝ),
                    NLA.RA08.AdmissibleFunction f →
                      ∀ (dA : NLA.RA08.OrderedSpectralData A) (dAhat : NLA.RA08.OrderedSpectralData Ahat) (ε : ℝ),
                        LE.le.{0} 0 ε →
                          LE.le.{0} (NLA.RA08.spectralNorm (HSub.hSub.{0, 0, 0} A (NLA.RA08.truncation dAhat k)))
                              (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 ε)
                                (NLA.RA08.spectralNorm (HSub.hSub.{0, 0, 0} A (NLA.RA08.truncation dA k)))) →
                            LE.le.{0}
                              (NLA.RA08.spectralNorm
                                (HSub.hSub.{0, 0, 0} (NLA.RA08.functionalCalculus f A)
                                  (NLA.RA08.functionTruncation dAhat f k)))
                              (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 ε)
                                (NLA.RA08.spectralNorm
                                  (HSub.hSub.{0, 0, 0} (NLA.RA08.functionalCalculus f A)
                                    (NLA.RA08.functionTruncation dA f k))))
