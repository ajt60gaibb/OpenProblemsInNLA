def NLA.RA08.spectralNorm : {n : Nat} → (A : NLA.RA08.RealMatrix n) → Real :=
fun {n : ⋯} (A : ⋯) =>
  @Norm.norm.{0}
    (@ContinuousLinearMap.{0, 0, 0, 0} Real Real
