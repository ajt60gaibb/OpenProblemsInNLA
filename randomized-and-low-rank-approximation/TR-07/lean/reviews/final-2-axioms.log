def NLA.TR07.SolvesTR07 : Prop :=
∀ (s : ℕ),
  2 ≤ s →
    ∀ (C : ℝ),
      1 ≤ C →
        ∀ (r n : ℕ → ℕ),
          (∀ (k : ℕ), r k ≤ k) →
            (∀ (k : ℕ), r k ≤ n k) →
              Filter.Tendsto (fun k => ↑k / ↑(r k)) Filter.atTop (nhds C) →
                Filter.Tendsto (fun k => ↑(n k) / ↑(r k)) Filter.atTop Filter.atTop →
                  ∀ (M : (k : ℕ) → NLA.TR07.Mat k (n k)),
                    (∀ᶠ (k : ℕ) in Filter.atTop, NLA.TR07.SignedSparse s (M k)) →
                      ∀ (η : ℝ),
                        0 < η → Filter.Tendsto (fun k => NLA.TR07.subsetTail (M k) (r k) η) Filter.atTop (nhds 0)
NLA.TR07.random_column_subsets : NLA.TR07.SolvesTR07
'NLA.TR07.random_column_subsets' depends on axioms: [propext, Classical.choice, Quot.sound]
