def NLA.RA09.ConcaveFrobeniusTransferConjecture : Prop :=
∀ (n : Nat),
  @LE.le.{0} Nat instLENat (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) n →
    ∀ (k : Nat),
      @LE.le.{0} Nat instLENat (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) k →
        @LT.lt.{0} Nat instLTNat k n →
          ∀ (A Ahat : NLA.RA09.RealMatrix n),
            @Matrix.PosSemidef.{0, 0} (Fin n) Real Real.instRing Real.partialOrder instStarRingReal A →
              @Matrix.PosSemidef.{0, 0} (Fin n) Real Real.instRing Real.partialOrder instStarRingReal Ahat →
                @LE.le.{0} (NLA.RA09.RealMatrix n)
                    (@Preorder.toLE.{0} (NLA.RA09.RealMatrix n)
                      (@Matrix.instPreOrder.{0, 0} Real (Fin n) Real.instRCLike))
                    Ahat A →
                  ∀ (f : Real → Real),
                    NLA.RA09.AdmissibleFunction f →
                      ∀ (dA : @NLA.RA09.OrderedSpectralData n A) (dHat : @NLA.RA09.OrderedSpectralData n Ahat)
                        (ε : Real),
                        @LE.le.{0} Real Real.instLE
                            (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero)) ε →
                          @LE.le.{0} Real Real.instLE
                              (@HSub.hSub.{0, 0, 0} Real Real Real (@instHSub.{0} Real Real.instSub)
                                (@NLA.RA09.frobeniusSquared n n A)
                                (@NLA.RA09.frobeniusSquared n n (@NLA.RA09.truncation n Ahat dHat k)))
                              (@HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul)
                                (@HAdd.hAdd.{0, 0, 0} Real Real Real (@instHAdd.{0} Real Real.instAdd)
                                  (@OfNat.ofNat.{0} Real (nat_lit 1) (@One.toOfNat1.{0} Real Real.instOne)) ε)
                                (@NLA.RA09.frobeniusSquared n n
                                  (@HSub.hSub.{0, 0, 0} (NLA.RA09.RealMatrix n) (NLA.RA09.RealMatrix n)
                                    (NLA.RA09.RealMatrix n)
                                    (@instHSub.{0} (NLA.RA09.RealMatrix n)
                                      (@Matrix.sub.{0, 0, 0} (Fin n) (Fin n) Real Real.instSub))
                                    A (@NLA.RA09.truncation n A dA k)))) →
                            @LE.le.{0} Real Real.instLE
                              (@NLA.RA09.frobeniusSquared n n
                                (@HSub.hSub.{0, 0, 0} (NLA.RA09.RealMatrix n) (NLA.RA09.RealMatrix n)
                                  (NLA.RA09.RealMatrix n)
                                  (@instHSub.{0} (NLA.RA09.RealMatrix n)
                                    (@Matrix.sub.{0, 0, 0} (Fin n) (Fin n) Real Real.instSub))
                                  (@NLA.RA09.functionalCalculus n f A) (@NLA.RA09.functionTruncation n Ahat dHat f k)))
                              (@HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul)
                                (@HAdd.hAdd.{0, 0, 0} Real Real Real (@instHAdd.{0} Real Real.instAdd)
                                  (@OfNat.ofNat.{0} Real (nat_lit 1) (@One.toOfNat1.{0} Real Real.instOne)) ε)
                                (@NLA.RA09.frobeniusSquared n n
                                  (@HSub.hSub.{0, 0, 0} (NLA.RA09.RealMatrix n) (NLA.RA09.RealMatrix n)
                                    (NLA.RA09.RealMatrix n)
                                    (@instHSub.{0} (NLA.RA09.RealMatrix n)
                                      (@Matrix.sub.{0, 0, 0} (Fin n) (Fin n) Real Real.instSub))
                                    (@NLA.RA09.functionalCalculus n f A) (@NLA.RA09.functionTruncation n A dA f k))))
def NLA.RA09.AdmissibleFunction : (f : Real → Real) → Prop :=
fun (f : Real → Real) =>
  And
    (@ContinuousOn.{0, 0} Real Real
      (@UniformSpace.toTopologicalSpace.{0} Real (@PseudoMetricSpace.toUniformSpace.{0} Real Real.pseudoMetricSpace))
      (@UniformSpace.toTopologicalSpace.{0} Real (@PseudoMetricSpace.toUniformSpace.{0} Real Real.pseudoMetricSpace)) f
      (@Set.Ici.{0} Real Real.instPreorder (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero))))
    (And
      (@ConcaveOn.{0, 0, 0} Real Real Real Real.semiring Real.partialOrder Real.instAddCommMonoid Real.instAddCommMonoid
        Real.partialOrder (@instSMulOfMul.{0} Real Real.instMul) (@instSMulOfMul.{0} Real Real.instMul)
        (@Set.Ici.{0} Real Real.instPreorder
          (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero)))
        f)
      (And
        (@MonotoneOn.{0, 0} Real Real Real.instPreorder Real.instPreorder f
          (@Set.Ici.{0} Real Real.instPreorder
            (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero))))
        (∀ (x : Real),
          @LE.le.{0} Real Real.instLE (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero)) x →
            @LE.le.{0} Real Real.instLE (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero))
              (f x))))
structure NLA.RA09.OrderedSpectralData {n : Nat} (A : NLA.RA09.RealMatrix n) : Type
number of parameters: 2
fields:
  NLA.RA09.OrderedSpectralData.eigenvalues : Fin n → Real
  NLA.RA09.OrderedSpectralData.orthogonal : @Subtype.{1} (Matrix.{0, 0, 0} (Fin n) (Fin n) Real)
      fun (x : Matrix.{0, 0, 0} (Fin n) (Fin n) Real) =>
      @Membership.mem.{0, 0} (Matrix.{0, 0, 0} (Fin n) (Fin n) Real)
        (@Submonoid.{0} (Matrix.{0, 0, 0} (Fin n) (Fin n) Real)
          (@MulZeroOneClass.toMulOneClass.{0} (Matrix.{0, 0, 0} (Fin n) (Fin n) Real)
            (@instMulZeroOneClassOfSemiring.{0} (Matrix.{0, 0, 0} (Fin n) (Fin n) Real)
              (@Matrix.semiring.{0, 0} (Fin n) Real
                (@CommSemiring.toSemiring.{0} Real (@CommRing.toCommSemiring.{0} Real Real.commRing)) (Fin.fintype n)
                (instDecidableEqFin n)))))
