EXACT_ELABORATED_SIGNATURE NLA.RA09.frobenius_semantics = NLA.RA09.FinalReferee1Reference.frobenius_semantics
EXPORTED_TYPE NLA.RA09.frobenius_semantics: ∀ {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℝ),
  NLA.RA09.frobeniusSquared M = NLA.RA09.frobeniusNorm M ^ 2 ∧
    NLA.RA09.frobeniusSquared M = ∑ i, ∑ j, |M i j| ^ 2 ∧
      NLA.RA09.frobeniusSquared M = (M.transpose * M).trace ∧
        0 ≤ NLA.RA09.frobeniusSquared M ∧ (NLA.RA09.frobeniusSquared M = 0 ↔ M = 0)
EXACT_ELABORATED_SIGNATURE NLA.RA09.frobenius_orthogonal_invariance = NLA.RA09.FinalReferee1Reference.frobenius_orthogonal_invariance
EXPORTED_TYPE NLA.RA09.frobenius_orthogonal_invariance: ∀ {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℝ)
  (U : ↥(Matrix.unitaryGroup (Fin m) ℝ)) (V : ↥(Matrix.unitaryGroup (Fin n) ℝ)),
  NLA.RA09.frobeniusSquared (↑U * M * ↑V) = NLA.RA09.frobeniusSquared M
EXACT_ELABORATED_SIGNATURE NLA.RA09.orderedSpectral_exists = NLA.RA09.FinalReferee1Reference.orderedSpectral_exists
EXPORTED_TYPE NLA.RA09.orderedSpectral_exists: ∀ {n : ℕ} (A : NLA.RA09.RealMatrix n),
  Matrix.PosSemidef A → Nonempty (NLA.RA09.OrderedSpectralData A)
EXACT_ELABORATED_SIGNATURE NLA.RA09.orderedSpectral_semantics = NLA.RA09.FinalReferee1Reference.orderedSpectral_semantics
EXPORTED_TYPE NLA.RA09.orderedSpectral_semantics: ∀ {n : ℕ} {A : NLA.RA09.RealMatrix n}
  (d : NLA.RA09.OrderedSpectralData A),
  Matrix.PosSemidef A ∧
    NLA.RA09.spectralCombination d d.eigenvalues = A ∧
      (∀ (i j : Fin n), ((fun r => ↑d.orthogonal r i) ⬝ᵥ fun r => ↑d.orthogonal r j) = if i = j then 1 else 0) ∧
        ∀ (i : Fin n), (Matrix.mulVec A fun r => ↑d.orthogonal r i) = d.eigenvalues i • fun r => ↑d.orthogonal r i
EXACT_ELABORATED_SIGNATURE NLA.RA09.functionalCalculus_spectral = NLA.RA09.FinalReferee1Reference.functionalCalculus_spectral
EXPORTED_TYPE NLA.RA09.functionalCalculus_spectral: ∀ {n : ℕ} {A : NLA.RA09.RealMatrix n}
  (d : NLA.RA09.OrderedSpectralData A) (f : ℝ → ℝ),
  (NLA.RA09.functionalCalculus f A = NLA.RA09.spectralCombination d fun i => f (d.eigenvalues i)) ∧
    ∀ (g : ℝ → ℝ), Set.EqOn f g (Set.Ici 0) → NLA.RA09.functionalCalculus f A = NLA.RA09.functionalCalculus g A
EXACT_ELABORATED_SIGNATURE NLA.RA09.truncation_semantics = NLA.RA09.FinalReferee1Reference.truncation_semantics
EXPORTED_TYPE NLA.RA09.truncation_semantics: ∀ {n : ℕ} {A : NLA.RA09.RealMatrix n} (d : NLA.RA09.OrderedSpectralData A),
  ∀ k ≤ n,
    ∀ (f : ℝ → ℝ),
      Matrix.PosSemidef (NLA.RA09.truncation d k) ∧
        NLA.RA09.truncation d k ≤ A ∧
          NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation d k) = NLA.RA09.spectralTail d k ∧
            NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation d f k) =
                NLA.RA09.functionTail d f k ∧
              (NLA.RA09.truncation d k = A ↔ ∀ (i : Fin n), k ≤ ↑i → d.eigenvalues i = 0)
EXACT_ELABORATED_SIGNATURE NLA.RA09.trace_deficit_reduction = NLA.RA09.FinalReferee1Reference.trace_deficit_reduction
EXPORTED_TYPE NLA.RA09.trace_deficit_reduction: ∀ {n : ℕ} (A B : NLA.RA09.RealMatrix n),
  Matrix.PosSemidef A →
    Matrix.PosSemidef B →
      B ≤ A →
        NLA.RA09.frobeniusSquared (A - B) =
            NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared B - 2 * (B * (A - B)).trace ∧
          0 ≤ (B * (A - B)).trace ∧
            NLA.RA09.frobeniusSquared (A - B) ≤ NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared B
EXACT_ELABORATED_SIGNATURE NLA.RA09.admissible_scalar_consequences = NLA.RA09.FinalReferee1Reference.admissible_scalar_consequences
EXPORTED_TYPE NLA.RA09.admissible_scalar_consequences: ∀ (f : ℝ → ℝ),
  NLA.RA09.AdmissibleFunction f →
    ∀ (τ : ℝ),
      0 < τ →
        (∀ (x y : ℝ), 0 < x → x ≤ y → f y / y ≤ f x / x) ∧
          0 ≤ NLA.RA09.transferScale f τ ∧
            (∀ (x : ℝ), 0 ≤ x → x ≤ τ → NLA.RA09.transferScale f τ * x ≤ f x) ∧
              (∀ (x : ℝ), τ ≤ x → f x ≤ NLA.RA09.transferScale f τ * x) ∧
                (∀ (x y : ℝ),
                    0 ≤ x → x ≤ y → τ ≤ y → 0 ≤ f y - f x ∧ f y - f x ≤ NLA.RA09.transferScale f τ * (y - x)) ∧
                  (f τ = 0 → ∀ (x : ℝ), 0 ≤ x → f x = 0)
EXACT_ELABORATED_SIGNATURE NLA.RA09.scalar_branch_certificates = NLA.RA09.FinalReferee1Reference.scalar_branch_certificates
EXPORTED_TYPE NLA.RA09.scalar_branch_certificates: ∀ (d z : ℝ),
  1 ≤ d →
    0 < z →
      NLA.RA09.branchQuadratic d z = 2 * (d - 1) * (z - 1 / 2) ^ 2 + (d - 1) / 2 + 4 * (z - 3 / 8) ^ 2 + 7 / 16 ∧
        0 < NLA.RA09.branchQuadratic d z ∧
          (z ≤ 1 →
              2 * d ^ 2 * z - 2 * z - d ^ 2 + 1 - d * (d - 1) * (1 - 1 / z) =
                  (d - 1) / z * NLA.RA09.branchQuadratic d z ∧
                0 ≤ (d - 1) / z * NLA.RA09.branchQuadratic d z) ∧
            (1 ≤ z →
                z ≤ d →
                  2 * d ^ 2 - 2 * z - d ^ 2 + 1 - d * (d - 1) * (1 - 1 / z) = (d - z) * (2 * z + d - 1) / z ∧
                    0 ≤ (d - z) * (2 * z + d - 1) / z) ∧
              (d ≤ z →
                2 * d * z - 2 * z - d ^ 2 + 1 - d * (d - 1) * (1 - 1 / z) = (d - 1) * (z - d) * (2 * z - 1) / z ∧
                  0 ≤ (d - 1) * (z - d) * (2 * z - 1) / z)
EXACT_ELABORATED_SIGNATURE NLA.RA09.ordered_scalar_certificate = NLA.RA09.FinalReferee1Reference.ordered_scalar_certificate
EXPORTED_TYPE NLA.RA09.ordered_scalar_certificate: ∀ (f : ℝ → ℝ),
  NLA.RA09.AdmissibleFunction f →
    ∀ (τ a b : ℝ),
      0 < τ →
        0 < f τ →
          0 < a →
            0 < b →
              f b * max (f b - NLA.RA09.transferScale f τ * b) 0 * (1 - b / a) ≤
                NLA.RA09.scalarAuxiliary f τ a + 2 * f b * f a - 2 * NLA.RA09.transferScale f τ ^ 2 * b * a - f b ^ 2 +
                  NLA.RA09.transferScale f τ ^ 2 * b ^ 2
EXACT_ELABORATED_SIGNATURE NLA.RA09.harmonic_constraint = NLA.RA09.FinalReferee1Reference.harmonic_constraint
EXPORTED_TYPE NLA.RA09.harmonic_constraint: ∀ {n : ℕ} (a v : Fin n → ℝ) (b : ℝ),
  (∀ (i : Fin n), 0 ≤ a i) →
    ∑ i, v i ^ 2 = 1 →
      0 < b →
        (Matrix.diagonal a - b • NLA.RA09.outerSquare v).PosSemidef →
          (∀ (i : Fin n), a i = 0 → v i = 0) ∧ b * ∑ i, v i ^ 2 / a i ≤ 1
EXACT_ELABORATED_SIGNATURE NLA.RA09.overlap_semantics = NLA.RA09.FinalReferee1Reference.overlap_semantics
EXPORTED_TYPE NLA.RA09.overlap_semantics: ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat),
  Ahat ≤ A →
    ∀ k ≤ n,
      (∀ (i j : Fin n), 0 ≤ NLA.RA09.overlapWeights dA dHat i j) ∧
        (∀ (j : Fin n), ∑ i, NLA.RA09.overlapWeights dA dHat i j = 1) ∧
          (∀ (i : Fin n), ∑ j with ↑j < k, NLA.RA09.overlapWeights dA dHat i j ≤ 1) ∧
            ∀ (j : Fin n),
              0 < dHat.eigenvalues j →
                (∀ (i : Fin n), dA.eigenvalues i = 0 → NLA.RA09.overlapWeights dA dHat i j = 0) ∧
                  dHat.eigenvalues j * ∑ i, NLA.RA09.overlapWeights dA dHat i j / dA.eigenvalues i ≤ 1
EXACT_ELABORATED_SIGNATURE NLA.RA09.overlap_error_expansions = NLA.RA09.FinalReferee1Reference.overlap_error_expansions
EXPORTED_TYPE NLA.RA09.overlap_error_expansions: ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat) (f : ℝ → ℝ),
  ∀ k ≤ n,
    NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dHat k) =
        ∑ i, dA.eigenvalues i ^ 2 + ∑ j with ↑j < k, dHat.eigenvalues j ^ 2 -
          2 * ∑ j with ↑j < k, dHat.eigenvalues j * ∑ i, NLA.RA09.overlapWeights dA dHat i j * dA.eigenvalues i ∧
      NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) =
        ∑ i, f (dA.eigenvalues i) ^ 2 + ∑ j with ↑j < k, f (dHat.eigenvalues j) ^ 2 -
          2 * ∑ j with ↑j < k, f (dHat.eigenvalues j) * ∑ i, NLA.RA09.overlapWeights dA dHat i j * f (dA.eigenvalues i)
EXACT_ELABORATED_SIGNATURE NLA.RA09.zero_column_average = NLA.RA09.FinalReferee1Reference.zero_column_average
EXPORTED_TYPE NLA.RA09.zero_column_average: ∀ {n : ℕ} (a p : Fin n → ℝ),
  (∀ (i : Fin n), 0 ≤ a i) →
    (∀ (i : Fin n), 0 ≤ p i) →
      ∑ i, p i = 1 →
        ∀ (f : ℝ → ℝ),
          NLA.RA09.AdmissibleFunction f →
            ∀ (τ : ℝ), f 0 ^ 2 - 2 * f 0 * ∑ i, p i * f (a i) ≤ ∑ i, p i * NLA.RA09.scalarAuxiliary f τ (a i)
EXACT_ELABORATED_SIGNATURE NLA.RA09.positive_tail_transfer = NLA.RA09.FinalReferee1Reference.positive_tail_transfer
EXPORTED_TYPE NLA.RA09.positive_tail_transfer: ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat),
  Ahat ≤ A →
    ∀ (f : ℝ → ℝ),
      NLA.RA09.AdmissibleFunction f →
        ∀ (k : ℕ) (hk : k < n),
          0 < dA.eigenvalues ⟨k, hk⟩ →
            NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) -
                  NLA.RA09.functionTail dA f k ≤
                NLA.RA09.transferScale f (dA.eigenvalues ⟨k, hk⟩) ^ 2 *
                  (NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dHat k) - NLA.RA09.spectralTail dA k) ∧
              NLA.RA09.transferScale f (dA.eigenvalues ⟨k, hk⟩) ^ 2 * NLA.RA09.spectralTail dA k ≤
                NLA.RA09.functionTail dA f k
EXACT_ELABORATED_SIGNATURE NLA.RA09.zero_tail_closure = NLA.RA09.FinalReferee1Reference.zero_tail_closure
EXPORTED_TYPE NLA.RA09.zero_tail_closure: ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat),
  Ahat ≤ A →
    ∀ (f : ℝ → ℝ),
      NLA.RA09.AdmissibleFunction f →
        ∀ (k : ℕ) (hk : k < n),
          dA.eigenvalues ⟨k, hk⟩ = 0 →
            ∀ (ε : ℝ),
              0 ≤ ε →
                NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared (NLA.RA09.truncation dHat k) ≤
                    (1 + ε) * NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dA k) →
                  A = NLA.RA09.truncation dHat k ∧
                    Ahat = A ∧
                      NLA.RA09.frobeniusSquared
                            (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) =
                          ↑(n - k) * f 0 ^ 2 ∧
                        NLA.RA09.frobeniusSquared
                            (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dA f k) =
                          ↑(n - k) * f 0 ^ 2
