def NLA.RA09.frobeniusNorm : {m n : Nat} → (A : Matrix.{0, 0, 0} (Fin m) (Fin n) Real) → Real :=
fun {m n : Nat} (A : Matrix.{0, 0, 0} (Fin m) (Fin n) Real) =>
  @Norm.norm.{0} (Matrix.{0, 0, 0} (Fin m) (Fin n) Real)
    (@NormedAddCommGroup.toNorm.{0} (Matrix.{0, 0, 0} (Fin m) (Fin n) Real)
      (@Matrix.frobeniusNormedAddCommGroup.{0, 0, 0} (Fin m) (Fin n) Real (Fin.fintype m) (Fin.fintype n)
        Real.normedAddCommGroup))
    A
def NLA.RA09.functionalCalculus : {n : Nat} → (f : Real → Real) → (A : NLA.RA09.RealMatrix n) → NLA.RA09.RealMatrix n :=
fun {n : Nat} (f : Real → Real) (A : NLA.RA09.RealMatrix n) =>
  @cfc.{0, 0} Real (NLA.RA09.RealMatrix n)
    (@IsSelfAdjoint.{0} (Matrix.{0, 0, 0} (Fin n) (Fin n) Real)
      (@Matrix.instStar.{0, 0} (Fin n) Real
        (@InvolutiveStar.toStar.{0} Real
          (@StarAddMonoid.toInvolutiveStar.{0} Real
            (@AddCommMonoid.toAddMonoid.{0} Real
              (@NonUnitalNonAssocSemiring.toAddCommMonoid.{0} Real
                (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                  (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                    (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                      (@CommRing.toNonUnitalCommRing.{0} Real
                        (@Field.toCommRing.{0} Real
                          (@NormedField.toField.{0} Real
                            (@DenselyNormedField.toNormedField.{0} Real
                              (@RCLike.toDenselyNormedField.{0} Real Real.instRCLike))))))))))
            (@StarRing.toStarAddMonoid.{0} Real
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                    (@CommRing.toNonUnitalCommRing.{0} Real
                      (@Field.toCommRing.{0} Real
                        (@NormedField.toField.{0} Real
                          (@DenselyNormedField.toNormedField.{0} Real
                            (@RCLike.toDenselyNormedField.{0} Real Real.instRCLike))))))))
              (@RCLike.toStarRing.{0} Real Real.instRCLike))))))
    Real.instCommSemiring instStarRingReal Real.metricSpace NLA.RA09.functionalCalculus._proof_1 instContinuousStarReal
    (@instTopologicalSpaceMatrix.{0, 0, 0} (Fin n) (Fin n) Real
      (@UniformSpace.toTopologicalSpace.{0} Real (@PseudoMetricSpace.toUniformSpace.{0} Real Real.pseudoMetricSpace)))
    (@Matrix.instRing.{0, 0} (Fin n) Real (Fin.fintype n) (instDecidableEqFin n) Real.instRing)
    (@Matrix.instStarRing.{0, 0} (Fin n) Real (Fin.fintype n)
      (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
        (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
          (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
            (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))
      instStarRingReal)
    (@Matrix.instAlgebra.{0, 0, 0} (Fin n) Real Real (Fin.fintype n) (instDecidableEqFin n) Real.instCommSemiring
      (@Ring.toSemiring.{0} Real Real.instRing) (@Algebra.id.{0} Real Real.instCommSemiring))
    (@NLA.RA09.functionalCalculus._proof_2 n) f A
def NLA.RA09.ConcaveFrobeniusTransferConjecture : Prop :=
∀ (n : ℕ),
  2 ≤ n →
    ∀ (k : ℕ),
      1 ≤ k →
        k < n →
          ∀ (A Ahat : RealMatrix n),
            PosSemidef A →
              PosSemidef Ahat →
                Ahat ≤ A →
                  ∀ (f : ℝ → ℝ),
                    AdmissibleFunction f →
                      ∀ (dA : OrderedSpectralData A) (dHat : OrderedSpectralData Ahat) (ε : ℝ),
                        0 ≤ ε →
                          frobeniusSquared A - frobeniusSquared (truncation dHat k) ≤
                              (1 + ε) * frobeniusSquared (A - truncation dA k) →
                            frobeniusSquared (functionalCalculus f A - functionTruncation dHat f k) ≤
                              (1 + ε) * frobeniusSquared (functionalCalculus f A - functionTruncation dA f k)
def NLA.RA09.AdmissibleFunction : (ℝ → ℝ) → Prop :=
fun f => ContinuousOn f (Set.Ici 0) ∧ ConcaveOn ℝ (Set.Ici 0) f ∧ MonotoneOn f (Set.Ici 0) ∧ ∀ (x : ℝ), 0 ≤ x → 0 ≤ f x
structure NLA.RA09.OrderedSpectralData {n : ℕ} (A : RealMatrix n) : Type
number of parameters: 2
fields:
  NLA.RA09.OrderedSpectralData.eigenvalues : Fin n → ℝ
  NLA.RA09.OrderedSpectralData.orthogonal : ↥(unitaryGroup (Fin n) ℝ)
  NLA.RA09.OrderedSpectralData.decreasing : Antitone self.eigenvalues
  NLA.RA09.OrderedSpectralData.nonnegative : ∀ (i : Fin n), 0 ≤ self.eigenvalues i
  NLA.RA09.OrderedSpectralData.reconstruct : A = ↑self.orthogonal * diagonal self.eigenvalues * (↑self.orthogonal)ᵀ
constructor:
  NLA.RA09.OrderedSpectralData.mk {n : ℕ} {A : RealMatrix n} (eigenvalues : Fin n → ℝ)
    (orthogonal : ↥(unitaryGroup (Fin n) ℝ)) (decreasing : Antitone eigenvalues)
    (nonnegative : ∀ (i : Fin n), 0 ≤ eigenvalues i)
    (reconstruct : A = ↑orthogonal * diagonal eigenvalues * (↑orthogonal)ᵀ) : OrderedSpectralData A
def NLA.RA09.frobeniusSquared : {m n : ℕ} → Matrix (Fin m) (Fin n) ℝ → ℝ :=
fun {m n} A => ∑ i, ∑ j, A i j ^ 2
def NLA.RA09.truncation : {n : ℕ} → {A : RealMatrix n} → OrderedSpectralData A → ℕ → RealMatrix n :=
fun {n} {A} d k => spectralCombination d fun i => if ↑i < k then d.eigenvalues i else 0
def NLA.RA09.functionTruncation : {n : ℕ} → {A : RealMatrix n} → OrderedSpectralData A → (ℝ → ℝ) → ℕ → RealMatrix n :=
fun {n} {A} d f k => spectralCombination d fun i => if ↑i < k then f (d.eigenvalues i) else 0
def NLA.RA09.spectralTail : {n : ℕ} → {A : RealMatrix n} → OrderedSpectralData A → ℕ → ℝ :=
fun {n} {A} d k => ∑ i with k ≤ ↑i, d.eigenvalues i ^ 2
def NLA.RA09.functionTail : {n : ℕ} → {A : RealMatrix n} → OrderedSpectralData A → (ℝ → ℝ) → ℕ → ℝ :=
fun {n} {A} d f k => ∑ i with k ≤ ↑i, f (d.eigenvalues i) ^ 2
def NLA.RA09.overlapWeights : {n : ℕ} →
  {A Ahat : RealMatrix n} → OrderedSpectralData A → OrderedSpectralData Ahat → RealMatrix n :=
fun {n} {A Ahat} dA dHat i j => overlapMatrix dA dHat i j ^ 2
def NLA.RA09.scalarAuxiliary : (ℝ → ℝ) → ℝ → ℝ → ℝ :=
fun f τ a => max (transferScale f τ ^ 2 * a ^ 2 - f a ^ 2) 0
def Matrix.PosSemidef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} → [inst : Ring R] → [PartialOrder R] → [StarRing R] → Matrix n n R → Prop :=
fun {n} {R} [Ring R] [PartialOrder R] [StarRing R] M =>
  M.IsHermitian ∧ ∀ (x : n →₀ R), 0 ≤ x.sum fun i xi => x.sum fun j xj => star xi * M i j * xj
theorem Matrix.le_iff.{u_1, u_2} : ∀ {𝕜 : Type u_1} {n : Type u_2} [inst : RCLike 𝕜] {A B : Matrix n n 𝕜},
  A ≤ B ↔ (B - A).PosSemidef :=
fun {𝕜} {n} [RCLike 𝕜] {A B} => Iff.rfl
Matrix.frobenius_norm_def.{u_3, u_4, u_5} {m : Type u_3} {n : Type u_4} {α : Type u_5} [Fintype m] [Fintype n]
  [SeminormedAddCommGroup α] (A : Matrix m n α) : ‖A‖ = (∑ i, ∑ j, ‖A i j‖ ^ 2) ^ (1 / 2)
Matrix.PosSemidef.dotProduct_mulVec_nonneg.{u_2, u_3} {n : Type u_2} {R : Type u_3} [Ring R] [PartialOrder R]
  [StarRing R] [Fintype n] {M : Matrix n n R} (hM : M.PosSemidef) (x : n → R) : 0 ≤ star x ⬝ᵥ M *ᵥ x
Matrix.PosSemidef.mul_mul_conjTranspose_same.{u_1, u_2, u_3} {m : Type u_1} {n : Type u_2} {R : Type u_3} [Ring R]
  [PartialOrder R] [StarRing R] [Fintype n] [Finite m] {A : Matrix n n R} (hA : A.PosSemidef) (B : Matrix m n R) :
  (B * A * Bᴴ).PosSemidef
Matrix.PosSemidef.diag_nonneg.{u_2, u_3} {n : Type u_2} {R : Type u_3} [Ring R] [PartialOrder R] [StarRing R]
  {A : Matrix n n R} (hA : A.PosSemidef) {i : n} : 0 ≤ A i i
Matrix.trace_mul_cycle.{u_2, u_3, u_4, u_6} {m : Type u_2} {n : Type u_3} {p : Type u_4} {R : Type u_6} [Fintype m]
  [Fintype n] [Fintype p] [NonUnitalCommSemiring R] (A : Matrix m n R) (B : Matrix n p R) (C : Matrix p m R) :
  (A * B * C).trace = (C * A * B).trace
Matrix.IsHermitian.eigenvalues₀_antitone.{u_1, u_2} {𝕜 : Type u_1} [RCLike 𝕜] {n : Type u_2} [Fintype n]
  {A : Matrix n n 𝕜} [DecidableEq n] (hA : A.IsHermitian) : Antitone hA.eigenvalues₀
Matrix.IsHermitian.spectral_theorem.{u_1, u_2} {𝕜 : Type u_1} [RCLike 𝕜] {n : Type u_2} [Fintype n] {A : Matrix n n 𝕜}
  [DecidableEq n] (hA : A.IsHermitian) :
  A = ((Unitary.conjStarAlgAut 𝕜 (Matrix n n 𝕜)) hA.eigenvectorUnitary) (diagonal (RCLike.ofReal ∘ hA.eigenvalues))
Matrix.PosSemidef.eigenvalues_nonneg.{u_2, u_3} {n : Type u_2} {𝕜 : Type u_3} [Fintype n] [RCLike 𝕜] {A : Matrix n n 𝕜}
  [DecidableEq n] (hA : A.PosSemidef) (i : n) : 0 ≤ ⋯.eigenvalues i
Matrix.IsHermitian.cfc_eq.{u_1, u_2} {n : Type u_1} {𝕜 : Type u_2} [RCLike 𝕜] [Fintype n] [DecidableEq n]
  {A : Matrix n n 𝕜} (hA : A.IsHermitian) (f : ℝ → ℝ) : cfc f A = hA.cfc f
cfcHom_eq_of_continuous_of_map_id.{u_1, u_2} {R : Type u_1} {A : Type u_2} {p : A → Prop} [CommSemiring R] [StarRing R]
  [MetricSpace R] [IsTopologicalSemiring R] [ContinuousStar R] [TopologicalSpace A] [Ring A] [StarRing A] [Algebra R A]
  [instCFC : ContinuousFunctionalCalculus R A p] {a : A} (ha : p a) [ContinuousMap.UniqueHom R A]
  (φ : C(↑(spectrum R a), R) →⋆ₐ[R] A) (hφ₁ : Continuous ⇑φ)
  (hφ₂ : φ (ContinuousMap.restrict (spectrum R a) (ContinuousMap.id R)) = a) : cfcHom ha = φ
concaveOn_iff_div.{u_1, u_2, u_5} {𝕜 : Type u_1} {E : Type u_2} {β : Type u_5} [Field 𝕜] [LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] [AddCommMonoid E] [AddCommMonoid β] [PartialOrder β] [SMul 𝕜 E] [SMul 𝕜 β] {s : Set E}
  {f : E → β} :
  ConcaveOn 𝕜 s f ↔
    Convex 𝕜 s ∧
      ∀ ⦃x : E⦄,
        x ∈ s →
          ∀ ⦃y : E⦄,
            y ∈ s →
              ∀ ⦃a b : 𝕜⦄,
                0 ≤ a →
                  0 ≤ b →
                    0 < a + b → (a / (a + b)) • f x + (b / (a + b)) • f y ≤ f ((a / (a + b)) • x + (b / (a + b)) • y)
