                  ∀ (f : Real → Real),
                    NLA.RA09.AdmissibleFunction f →
                      ∀ (dA : @NLA.RA09.OrderedSpectralData n A) (dHat : @NLA.RA09.OrderedSpectralData n Ahat)
                        (ε : Real),
                        @LE.le.{0} Real Real.instLE
                            (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero)) ε →
                          @LE.le.{0} Real Real.instLE
                              (@HSub.hSub.{0, 0, 0} Real Real Real (@instHSub.{0} Real Real.instSub)
                                (@NLA.RA09.frobeniusSquared n n A)
