NLA.RA09.orderedSpectral_semantics {n : ℕ} {A : NLA.RA09.RealMatrix n} (d : NLA.RA09.OrderedSpectralData A) :
  Matrix.PosSemidef A ∧
    NLA.RA09.spectralCombination d d.eigenvalues = A ∧
      (∀ (i j : Fin n), ((fun r => ↑d.orthogonal r i) ⬝ᵥ fun r => ↑d.orthogonal r j) = if i = j then 1 else 0) ∧
        ∀ (i : Fin n), (Matrix.mulVec A fun r => ↑d.orthogonal r i) = d.eigenvalues i • fun r => ↑d.orthogonal r i
NLA.RA09.functionalCalculus_spectral {n : ℕ} {A : NLA.RA09.RealMatrix n} (d : NLA.RA09.OrderedSpectralData A)
  (f : ℝ → ℝ) :
  (NLA.RA09.functionalCalculus f A = NLA.RA09.spectralCombination d fun i => f (d.eigenvalues i)) ∧
    ∀ (g : ℝ → ℝ), Set.EqOn f g (Set.Ici 0) → NLA.RA09.functionalCalculus f A = NLA.RA09.functionalCalculus g A
NLA.RA09.truncation_semantics {n : ℕ} {A : NLA.RA09.RealMatrix n} (d : NLA.RA09.OrderedSpectralData A) (k : ℕ)
  (hk : k ≤ n) (f : ℝ → ℝ) :
  Matrix.PosSemidef (NLA.RA09.truncation d k) ∧
    NLA.RA09.truncation d k ≤ A ∧
      NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation d k) = NLA.RA09.spectralTail d k ∧
        NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation d f k) =
            NLA.RA09.functionTail d f k ∧
          (NLA.RA09.truncation d k = A ↔ ∀ (i : Fin n), k ≤ ↑i → d.eigenvalues i = 0)
NLA.RA09.trace_deficit_reduction {n : ℕ} (A B : NLA.RA09.RealMatrix n) (hA : Matrix.PosSemidef A)
  (hB : Matrix.PosSemidef B) (hBA : B ≤ A) :
  NLA.RA09.frobeniusSquared (A - B) =
      NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared B - 2 * (B * (A - B)).trace ∧
    0 ≤ (B * (A - B)).trace ∧
      NLA.RA09.frobeniusSquared (A - B) ≤ NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared B
NLA.RA09.admissible_scalar_consequences (f : ℝ → ℝ) (hf : NLA.RA09.AdmissibleFunction f) (τ : ℝ) (hτ : 0 < τ) :
  (∀ (x y : ℝ), 0 < x → x ≤ y → f y / y ≤ f x / x) ∧
    0 ≤ NLA.RA09.transferScale f τ ∧
      (∀ (x : ℝ), 0 ≤ x → x ≤ τ → NLA.RA09.transferScale f τ * x ≤ f x) ∧
        (∀ (x : ℝ), τ ≤ x → f x ≤ NLA.RA09.transferScale f τ * x) ∧
          (∀ (x y : ℝ), 0 ≤ x → x ≤ y → τ ≤ y → 0 ≤ f y - f x ∧ f y - f x ≤ NLA.RA09.transferScale f τ * (y - x)) ∧
            (f τ = 0 → ∀ (x : ℝ), 0 ≤ x → f x = 0)
NLA.RA09.scalar_branch_certificates (d z : ℝ) (hd : 1 ≤ d) (hz : 0 < z) :
  NLA.RA09.branchQuadratic d z = 2 * (d - 1) * (z - 1 / 2) ^ 2 + (d - 1) / 2 + 4 * (z - 3 / 8) ^ 2 + 7 / 16 ∧
    0 < NLA.RA09.branchQuadratic d z ∧
      (z ≤ 1 →
          2 * d ^ 2 * z - 2 * z - d ^ 2 + 1 - d * (d - 1) * (1 - 1 / z) = (d - 1) / z * NLA.RA09.branchQuadratic d z ∧
            0 ≤ (d - 1) / z * NLA.RA09.branchQuadratic d z) ∧
        (1 ≤ z →
            z ≤ d →
              2 * d ^ 2 - 2 * z - d ^ 2 + 1 - d * (d - 1) * (1 - 1 / z) = (d - z) * (2 * z + d - 1) / z ∧
                0 ≤ (d - z) * (2 * z + d - 1) / z) ∧
          (d ≤ z →
            2 * d * z - 2 * z - d ^ 2 + 1 - d * (d - 1) * (1 - 1 / z) = (d - 1) * (z - d) * (2 * z - 1) / z ∧
              0 ≤ (d - 1) * (z - d) * (2 * z - 1) / z)
NLA.RA09.ordered_scalar_certificate (f : ℝ → ℝ) (hf : NLA.RA09.AdmissibleFunction f) (τ a b : ℝ) (hτ : 0 < τ)
  (hfτ : 0 < f τ) (ha : 0 < a) (hb : 0 < b) :
  f b * max (f b - NLA.RA09.transferScale f τ * b) 0 * (1 - b / a) ≤
    NLA.RA09.scalarAuxiliary f τ a + 2 * f b * f a - 2 * NLA.RA09.transferScale f τ ^ 2 * b * a - f b ^ 2 +
      NLA.RA09.transferScale f τ ^ 2 * b ^ 2
NLA.RA09.harmonic_constraint {n : ℕ} (a v : Fin n → ℝ) (b : ℝ) (ha : ∀ (i : Fin n), 0 ≤ a i) (hv : ∑ i, v i ^ 2 = 1)
  (hb : 0 < b) (horder : (Matrix.diagonal a - b • NLA.RA09.outerSquare v).PosSemidef) :
  (∀ (i : Fin n), a i = 0 → v i = 0) ∧ b * ∑ i, v i ^ 2 / a i ≤ 1
NLA.RA09.overlap_semantics {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n} (dA : NLA.RA09.OrderedSpectralData A)
  (dHat : NLA.RA09.OrderedSpectralData Ahat) (horder : Ahat ≤ A) (k : ℕ) (hk : k ≤ n) :
  (∀ (i j : Fin n), 0 ≤ NLA.RA09.overlapWeights dA dHat i j) ∧
    (∀ (j : Fin n), ∑ i, NLA.RA09.overlapWeights dA dHat i j = 1) ∧
      (∀ (i : Fin n), ∑ j with ↑j < k, NLA.RA09.overlapWeights dA dHat i j ≤ 1) ∧
        ∀ (j : Fin n),
          0 < dHat.eigenvalues j →
            (∀ (i : Fin n), dA.eigenvalues i = 0 → NLA.RA09.overlapWeights dA dHat i j = 0) ∧
              dHat.eigenvalues j * ∑ i, NLA.RA09.overlapWeights dA dHat i j / dA.eigenvalues i ≤ 1
NLA.RA09.overlap_error_expansions {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n} (dA : NLA.RA09.OrderedSpectralData A)
  (dHat : NLA.RA09.OrderedSpectralData Ahat) (f : ℝ → ℝ) (k : ℕ) (hk : k ≤ n) :
  NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dHat k) =
      ∑ i, dA.eigenvalues i ^ 2 + ∑ j with ↑j < k, dHat.eigenvalues j ^ 2 -
        2 * ∑ j with ↑j < k, dHat.eigenvalues j * ∑ i, NLA.RA09.overlapWeights dA dHat i j * dA.eigenvalues i ∧
    NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) =
      ∑ i, f (dA.eigenvalues i) ^ 2 + ∑ j with ↑j < k, f (dHat.eigenvalues j) ^ 2 -
        2 * ∑ j with ↑j < k, f (dHat.eigenvalues j) * ∑ i, NLA.RA09.overlapWeights dA dHat i j * f (dA.eigenvalues i)
NLA.RA09.zero_column_average {n : ℕ} (a p : Fin n → ℝ) (ha : ∀ (i : Fin n), 0 ≤ a i) (hp : ∀ (i : Fin n), 0 ≤ p i)
  (hsum : ∑ i, p i = 1) (f : ℝ → ℝ) (hf : NLA.RA09.AdmissibleFunction f) (τ : ℝ) :
  f 0 ^ 2 - 2 * f 0 * ∑ i, p i * f (a i) ≤ ∑ i, p i * NLA.RA09.scalarAuxiliary f τ (a i)
NLA.RA09.positive_tail_transfer {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n} (dA : NLA.RA09.OrderedSpectralData A)
  (dHat : NLA.RA09.OrderedSpectralData Ahat) (horder : Ahat ≤ A) (f : ℝ → ℝ) (hf : NLA.RA09.AdmissibleFunction f)
  (k : ℕ) (hk : k < n) (hτ : 0 < dA.eigenvalues ⟨k, hk⟩) :
  NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) -
        NLA.RA09.functionTail dA f k ≤
      NLA.RA09.transferScale f (dA.eigenvalues ⟨k, hk⟩) ^ 2 *
        (NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dHat k) - NLA.RA09.spectralTail dA k) ∧
    NLA.RA09.transferScale f (dA.eigenvalues ⟨k, hk⟩) ^ 2 * NLA.RA09.spectralTail dA k ≤ NLA.RA09.functionTail dA f k
NLA.RA09.zero_tail_closure {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n} (dA : NLA.RA09.OrderedSpectralData A)
  (dHat : NLA.RA09.OrderedSpectralData Ahat) (horder : Ahat ≤ A) (f : ℝ → ℝ) (hf : NLA.RA09.AdmissibleFunction f)
  (k : ℕ) (hk : k < n) (hτ : dA.eigenvalues ⟨k, hk⟩ = 0) (ε : ℝ) (hε : 0 ≤ ε)
  (hpremise :
    NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared (NLA.RA09.truncation dHat k) ≤
      (1 + ε) * NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dA k)) :
  A = NLA.RA09.truncation dHat k ∧
    Ahat = A ∧
      NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) =
          ↑(n - k) * f 0 ^ 2 ∧
        NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dA f k) =
          ↑(n - k) * f 0 ^ 2
NLA.RA09.concaveFrobeniusTransferConjecture : NLA.RA09.ConcaveFrobeniusTransferConjecture
def NLA.RA09.ConcaveFrobeniusTransferConjecture : Prop :=
∀ (n : Nat),
  @LE.le.{0} Nat instLENat (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) n →
