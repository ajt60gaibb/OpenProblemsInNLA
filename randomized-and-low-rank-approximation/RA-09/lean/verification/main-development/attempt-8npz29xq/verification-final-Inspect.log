                                      (@Matrix.sub.{0, 0, 0} (Fin n) (Fin n) Real Real.instSub))
                                    A (@NLA.RA09.truncation n A dA k)))) →
                            @LE.le.{0} Real Real.instLE
                              (@NLA.RA09.frobeniusSquared n n
                                (@HSub.hSub.{0, 0, 0} (NLA.RA09.RealMatrix n) (NLA.RA09.RealMatrix n)
                                  (NLA.RA09.RealMatrix n)
                                  (@instHSub.{0} (NLA.RA09.RealMatrix n)
                                    (@Matrix.sub.{0, 0, 0} (Fin n) (Fin n) Real Real.instSub))
                                  (@NLA.RA09.functionalCalculus n f A) (@NLA.RA09.functionTruncation n Ahat dHat f k)))
                              (@HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul)
                                (@HAdd.hAdd.{0, 0, 0} Real Real Real (@instHAdd.{0} Real Real.instAdd)
                                  (@OfNat.ofNat.{0} Real (nat_lit 1) (@One.toOfNat1.{0} Real Real.instOne)) ε)
                                (@NLA.RA09.frobeniusSquared n n
                                  (@HSub.hSub.{0, 0, 0} (NLA.RA09.RealMatrix n) (NLA.RA09.RealMatrix n)
                                    (NLA.RA09.RealMatrix n)
                                    (@instHSub.{0} (NLA.RA09.RealMatrix n)
                                      (@Matrix.sub.{0, 0, 0} (Fin n) (Fin n) Real Real.instSub))
                                    (@NLA.RA09.functionalCalculus n f A) (@NLA.RA09.functionTruncation n A dA f k))))
