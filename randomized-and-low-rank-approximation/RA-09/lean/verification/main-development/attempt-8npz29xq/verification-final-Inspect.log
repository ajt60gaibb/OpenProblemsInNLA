theorem NLA.RA09.zero_tail_closure_proved : ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat),
  Ahat ≤ A →
    ∀ (f : ℝ → ℝ),
      NLA.RA09.AdmissibleFunction f →
        ∀ (k : ℕ) (hk : k < n),
          dA.eigenvalues ⟨k, hk⟩ = 0 →
            ∀ (ε : ℝ),
              0 ≤ ε →
                NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared (NLA.RA09.truncation dHat k) ≤
                    (1 + ε) * NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dA k) →
                  A = NLA.RA09.truncation dHat k ∧
                    Ahat = A ∧
                      NLA.RA09.frobeniusSquared
                            (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) =
                          ↑(n - k) * f 0 ^ 2 ∧
                        NLA.RA09.frobeniusSquared
                            (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dA f k) =
                          ↑(n - k) * f 0 ^ 2 :=
fun {n} {A Ahat} dA dHat horder f _hf k hk hτ ε _hε hpremise =>
  have hzA := fun i hi =>
    le_antisymm
      (Eq.mp (congrArg (LE.le (dA.eigenvalues i)) hτ)
        (dA.decreasing
          (have this := hi;
          this)))
      (dA.nonnegative i);
  have htA := NLA.RA09.truncation_semantics_proved dA k (LT.lt.le hk) f;
  have htHat := NLA.RA09.truncation_semantics_proved dHat k (LT.lt.le hk) f;
  have heqA := htA.right.right.right.right.mpr hzA;
  have hzero :=
    of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq
            (Eq.trans
              (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                Eq.trans
                  (congrArg Finset.univ.sum
                    (funext fun j =>
                      zero_pow
                        (of_eq_true (Eq.trans (congrArg Not (OfNat.ofNat_ne_zero._simp_1 2)) not_false_eq_true))))
                  Finset.sum_const_zero)
              Finset.sum_const_zero))
          0)
        (eq_self 0));
  have hdef :=
    NLA.RA09.trace_deficit_reduction_proved A (NLA.RA09.truncation dHat k)
      (NLA.RA09.orderedSpectral_semantics_proved dA).left htHat.left (LE.le.trans htHat.right.left horder);
  have hle :=
    LE.le.trans hdef.right.right
      (Eq.mp
        (congrArg (LE.le (NLA.RA09.frobeniusSquared A - NLA.RA09.frobeniusSquared (NLA.RA09.truncation dHat k)))
          (Eq.trans
            (congrArg (HMul.hMul (1 + ε))
              (Eq.trans (congrArg NLA.RA09.frobeniusSquared (Eq.trans (congrArg (HSub.hSub A) heqA) (sub_self A)))
                hzero))
            (mul_zero (1 + ε))))
        hpremise);
  have heq :=
    sub_eq_zero.mp
      ((NLA.RA09.frobeniusSquared_eq_zero (A - NLA.RA09.truncation dHat k)).mp
        (le_antisymm hle (NLA.RA09.frobeniusSquared_nonneg (A - NLA.RA09.truncation dHat k))));
  have hHat := le_antisymm horder (Eq.mpr (id (congrArg (fun _a => _a ≤ Ahat) heq)) htHat.right.left);
  have hzHat := htHat.right.right.right.right.mp (Eq.trans (Eq.symm heq) (Eq.symm hHat));
  ⟨heq,
    ⟨hHat,
      ⟨Eq.mpr
          (id
            (congrArg
              (fun _a =>
                NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f _a - NLA.RA09.functionTruncation dHat f k) =
                  ↑(n - k) * f 0 ^ 2)
              (Eq.symm hHat)))
          (NLA.RA09.function_error_of_vanishing_tail dHat f k hk hzHat),
        NLA.RA09.function_error_of_vanishing_tail dA f k hk hzA⟩⟩⟩
theorem NLA.RA09.concaveFrobeniusTransferConjecture_proved : NLA.RA09.ConcaveFrobeniusTransferConjecture :=
fun n _hn k _hkone hk A Ahat hA _hAhat horder f hf dA dHat ε hε hpremise =>
  if hτ : dA.eigenvalues ⟨k, hk⟩ = 0 then
    And.casesOn (NLA.RA09.zero_tail_closure_proved dA dHat horder f hf k hk hτ ε hε hpremise) fun left right =>
      And.casesOn right fun left right =>
        And.casesOn right fun hHat hOptimal =>
          have hnonneg :=
            NLA.RA09.frobeniusSquared_nonneg (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dA f k);
          Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  _a ≤
                    (1 + ε) *
