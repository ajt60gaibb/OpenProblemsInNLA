theorem NLA.RA09.selected_column_average : ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat),
  Ahat ≤ A →
    ∀ (f : ℝ → ℝ),
      NLA.RA09.AdmissibleFunction f →
        ∀ (τ : ℝ),
          0 < τ →
            0 < f τ →
              ∀ (j : Fin n),
                f (dHat.eigenvalues j) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dHat.eigenvalues j ^ 2 -
                      2 * f (dHat.eigenvalues j) * ∑ i, NLA.RA09.overlapWeights dA dHat i j * f (dA.eigenvalues i) +
                    2 * NLA.RA09.transferScale f τ ^ 2 * dHat.eigenvalues j *
                      ∑ i, NLA.RA09.overlapWeights dA dHat i j * dA.eigenvalues i ≤
                  ∑ i, NLA.RA09.overlapWeights dA dHat i j * NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues i) :=
fun {n} {A Ahat} dA dHat horder f hf τ hτ hfτ j =>
  have hs := NLA.RA09.overlap_semantics_proved dA dHat horder 0 (Nat.zero_le n);
  if hb : dHat.eigenvalues j = 0 then
    Eq.mpr
      (id
        (congrFun'
          (congrArg LE.le
            (Eq.trans
              (congr
                (congrArg HAdd.hAdd
                  (congr
                    (congrArg HSub.hSub
                      (Eq.trans
                        (congr (congrArg HSub.hSub (congrFun' (congrArg HPow.hPow (congrArg f hb)) 2))
                          (Eq.trans
                            (congrArg (HMul.hMul (NLA.RA09.transferScale f τ ^ 2))
                              (Eq.trans (congrFun' (congrArg HPow.hPow hb) 2)
                                ((fun x_0 x_1 =>
                                    (fun x_0 x_1 => zero_pow (of_decide_eq_true (id (Eq.refl true)))) x_0 x_1)
                                  ℝ Real.instMonoidWithZero)))
                            (mul_zero (NLA.RA09.transferScale f τ ^ 2))))
                        (sub_zero (f 0 ^ 2))))
                    (congrFun' (congrArg HMul.hMul (congrArg (HMul.hMul 2) (congrArg f hb)))
                      (∑ i, NLA.RA09.overlapWeights dA dHat i j * f (dA.eigenvalues i)))))
                (Eq.trans
                  (congrFun'
                    (congrArg HMul.hMul
                      (Eq.trans (congrArg (HMul.hMul (2 * NLA.RA09.transferScale f τ ^ 2)) hb)
                        (mul_zero (2 * NLA.RA09.transferScale f τ ^ 2))))
                    (∑ i, NLA.RA09.overlapWeights dA dHat i j * dA.eigenvalues i))
                  (zero_mul (∑ i, NLA.RA09.overlapWeights dA dHat i j * dA.eigenvalues i))))
              (add_zero (f 0 ^ 2 - 2 * f 0 * ∑ i, NLA.RA09.overlapWeights dA dHat i j * f (dA.eigenvalues i)))))
          (∑ i, NLA.RA09.overlapWeights dA dHat i j * NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues i))))
      (NLA.RA09.zero_column_average_proved dA.eigenvalues (fun i => NLA.RA09.overlapWeights dA dHat i j) dA.nonnegative
        (fun i => hs.left i j) (hs.right.left j) f hf τ)
  else
    have hbpos := lt_of_le_of_ne (dHat.nonnegative j) (Ne.symm hb);
    NLA.RA09.positive_column_average dA.eigenvalues (fun i => NLA.RA09.overlapWeights dA dHat i j) dA.nonnegative
      (fun i => hs.left i j) (hs.right.left j) f hf τ (dHat.eigenvalues j) hτ hfτ hbpos
      (hs.right.right.right j hbpos).left (hs.right.right.right j hbpos).right
theorem NLA.RA09.function_residual_scale_bound : ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat),
  Ahat ≤ A →
    ∀ (f : ℝ → ℝ),
      NLA.RA09.AdmissibleFunction f →
        ∀ (τ : ℝ),
          0 < τ →
            0 < f τ →
              ∀ k ≤ n,
                NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) -
                    NLA.RA09.transferScale f τ ^ 2 * NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dHat k) ≤
                  ∑ i,
                    (f (dA.eigenvalues i) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues i ^ 2 +
                      NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues i)) :=
fun {n} {A Ahat} dA dHat horder f hf τ hτ hfτ k hk =>
  And.casesOn (NLA.RA09.overlap_error_expansions_proved dA dHat f k hk) fun hA hF =>
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) -
                NLA.RA09.transferScale f τ ^ 2 * _a ≤
              ∑ i,
                (f (dA.eigenvalues i) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues i ^ 2 +
                  NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues i)))
          hA))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              _a -
                  NLA.RA09.transferScale f τ ^ 2 *
                    (∑ i, dA.eigenvalues i ^ 2 + ∑ j with ↑j < k, dHat.eigenvalues j ^ 2 -
                      2 *
                        ∑ j with ↑j < k,
                          dHat.eigenvalues j * ∑ i, NLA.RA09.overlapWeights dA dHat i j * dA.eigenvalues i) ≤
                ∑ i,
                  (f (dA.eigenvalues i) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues i ^ 2 +
                    NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues i)))
            hF))
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                _a ≤
                  ∑ i,
                    (f (dA.eigenvalues i) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues i ^ 2 +
                      NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues i)))
              (NLA.RA09.scaled_overlap_identity dA.eigenvalues dHat.eigenvalues (fun i => f (dA.eigenvalues i))
                (fun j => f (dHat.eigenvalues j)) (fun i j => NLA.RA09.overlapWeights dA dHat i j)
                (NLA.RA09.transferScale f τ) {j | ↑j < k})))
          (Eq.mpr
            (id
              ((fun a a_1 e_a =>
                  e_a ▸
                    Eq.refl
                      (∑ i, (f (dA.eigenvalues i) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues i ^ 2) +
                          ∑ j with ↑j < k,
                            (f (dHat.eigenvalues j) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dHat.eigenvalues j ^ 2 -
                                2 * f (dHat.eigenvalues j) *
                                  ∑ i, NLA.RA09.overlapWeights dA dHat i j * f (dA.eigenvalues i) +
                              2 * NLA.RA09.transferScale f τ ^ 2 * dHat.eigenvalues j *
                                ∑ i, NLA.RA09.overlapWeights dA dHat i j * dA.eigenvalues i) ≤
                        a))
                (∑ i,
                  (f (dA.eigenvalues i) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues i ^ 2 +
                    NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues i)))
                (∑ x, (f (dA.eigenvalues x) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues x ^ 2) +
                  ∑ x, NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues x))
                (Eq.trans (congrArg (fun _a => _a) Finset.sum_add_distrib)
                  (Eq.refl
                    (∑ x, (f (dA.eigenvalues x) ^ 2 - NLA.RA09.transferScale f τ ^ 2 * dA.eigenvalues x ^ 2) +
                      ∑ x, NLA.RA09.scalarAuxiliary f τ (dA.eigenvalues x))))))
            (add_le_add le_rfl
              (Trans.trans
                (Finset.sum_le_sum fun j x => NLA.RA09.selected_column_average dA dHat horder f hf τ hτ hfτ j)
                (NLA.RA09.restricted_auxiliary_average dA dHat horder f τ k hk))))))
theorem NLA.RA09.positive_tail_transfer_proved : ∀ {n : ℕ} {A Ahat : NLA.RA09.RealMatrix n}
  (dA : NLA.RA09.OrderedSpectralData A) (dHat : NLA.RA09.OrderedSpectralData Ahat),
  Ahat ≤ A →
    ∀ (f : ℝ → ℝ),
      NLA.RA09.AdmissibleFunction f →
        ∀ (k : ℕ) (hk : k < n),
          0 < dA.eigenvalues ⟨k, hk⟩ →
            NLA.RA09.frobeniusSquared (NLA.RA09.functionalCalculus f A - NLA.RA09.functionTruncation dHat f k) -
                  NLA.RA09.functionTail dA f k ≤
                NLA.RA09.transferScale f (dA.eigenvalues ⟨k, hk⟩) ^ 2 *
                  (NLA.RA09.frobeniusSquared (A - NLA.RA09.truncation dHat k) - NLA.RA09.spectralTail dA k) ∧
              NLA.RA09.transferScale f (dA.eigenvalues ⟨k, hk⟩) ^ 2 * NLA.RA09.spectralTail dA k ≤
