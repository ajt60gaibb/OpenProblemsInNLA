theorem NLA.RA03.process_isProbability : ∀ {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℂ) (k : ℕ),
  (∀ (p : NLA.RA03.Pivot m n), 0 ≤ NLA.RA03.pivotMass A p) ∧
    ∑ p, NLA.RA03.pivotMass A p = 1 ∧
      (∀ (h : Fin k → NLA.RA03.Pivot m n), 0 ≤ NLA.RA03.historyMass A h) ∧ ∑ h, NLA.RA03.historyMass A h = 1 :=
fun {m n} A k => sorry
def NLA.RA03.SquaredErrorConjecture : Prop :=
∀ (m n : ℕ),
  1 ≤ m →
    1 ≤ n →
      ∀ (A : Matrix (Fin m) (Fin n) ℂ) (k : ℕ),
        1 ≤ k → k ≤ min m n → NLA.RA03.expectedError A k ≤ 2 ^ k * NLA.RA03.singularTailSq A k
def NLA.RA03.singularValue : {m n : ℕ} → Matrix (Fin m) (Fin n) ℂ → ℕ → ℝ :=
fun {m n} A j => (Matrix.toEuclideanLin A).singularValues j
def NLA.RA03.singularTailSq : {m n : ℕ} → Matrix (Fin m) (Fin n) ℂ → ℕ → ℝ :=
fun {m n} A k => ∑ j ∈ Finset.Ico k (min m n), NLA.RA03.singularValue A j ^ 2
