def NLA.RA07.elementarySymmetric : {n : Nat} → (Fin n → Real) → Nat → Real :=
fun {n} lam j =>
  ∑ S ∈ @Finset.powersetCard (Fin n) j (@Finset.univ (Fin n) (Fin.fintype n)),
    @Finset.prod (Fin n) Real Real.instCommMonoid S lam
def NLA.RA07.errorSequence : {n : Nat} → (Fin n → Real) → Nat → Real :=
fun {n} lam j =>
  @HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
    (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
      (@Nat.cast Real Real.instNatCast
        (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) j (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
      (@NLA.RA07.elementarySymmetric n lam
        (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) j
          (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
    (@NLA.RA07.elementarySymmetric n lam j)
def NLA.RA07.generatingPolynomial : {n : Nat} → (Fin n → Real) → @Polynomial Real Real.semiring :=
fun {n} lam =>
  ∏ i,
    @HAdd.hAdd (@Polynomial Real Real.semiring) (@Polynomial Real Real.semiring) (@Polynomial Real Real.semiring)
      (@instHAdd (@Polynomial Real Real.semiring) (@Polynomial.instAdd Real Real.semiring))
      (@OfNat.ofNat (@Polynomial Real Real.semiring) (nat_lit 1)
        (@One.toOfNat1 (@Polynomial Real Real.semiring) (@Polynomial.instOne Real Real.semiring)))
      (@HMul.hMul (@Polynomial Real Real.semiring) (@Polynomial Real Real.semiring) (@Polynomial Real Real.semiring)
        (@instHMul (@Polynomial Real Real.semiring) (@Polynomial.instMul Real Real.semiring))
        (@DFunLike.coe
          (@RingHom Real (@Polynomial Real Real.semiring) (@Semiring.toNonAssocSemiring Real Real.semiring)
            (@Semiring.toNonAssocSemiring (@Polynomial Real Real.semiring) (@Polynomial.semiring Real Real.semiring)))
          Real (fun x => @Polynomial Real Real.semiring)
          (@RingHom.instFunLike Real (@Polynomial Real Real.semiring) (@Semiring.toNonAssocSemiring Real Real.semiring)
            (@Semiring.toNonAssocSemiring (@Polynomial Real Real.semiring) (@Polynomial.semiring Real Real.semiring)))
          (@Polynomial.C Real Real.semiring) (lam i))
        (@Polynomial.X Real Real.semiring))
def NLA.RA07.iteratedGeneratingDerivative : {n : Nat} → (Fin n → Real) → Nat → @Polynomial Real Real.semiring :=
fun {n} lam d =>
  @Nat.iterate (@Polynomial Real Real.semiring)
    (@DFunLike.coe
      (@LinearMap Real Real Real.semiring Real.semiring
        (@RingHom.id Real (@Semiring.toNonAssocSemiring Real Real.semiring)) (@Polynomial Real Real.semiring)
        (@Polynomial Real Real.semiring)
        (@Semiring.toAddCommMonoid (@Polynomial Real Real.semiring) (@Polynomial.semiring Real Real.semiring))
        (@Semiring.toAddCommMonoid (@Polynomial Real Real.semiring) (@Polynomial.semiring Real Real.semiring))
        (@Polynomial.module Real Real.semiring Real Real.semiring (@Semiring.toModule Real Real.semiring))
        (@Polynomial.module Real Real.semiring Real Real.semiring (@Semiring.toModule Real Real.semiring)))
      (@Polynomial Real Real.semiring) (fun x => @Polynomial Real Real.semiring)
      (@LinearMap.instFunLike Real Real (@Polynomial Real Real.semiring) (@Polynomial Real Real.semiring) Real.semiring
        Real.semiring
        (@Semiring.toAddCommMonoid (@Polynomial Real Real.semiring) (@Polynomial.semiring Real Real.semiring))
        (@Semiring.toAddCommMonoid (@Polynomial Real Real.semiring) (@Polynomial.semiring Real Real.semiring))
        (@Polynomial.module Real Real.semiring Real Real.semiring (@Semiring.toModule Real Real.semiring))
        (@Polynomial.module Real Real.semiring Real Real.semiring (@Semiring.toModule Real Real.semiring))
        (@RingHom.id Real (@Semiring.toNonAssocSemiring Real Real.semiring)))
      (@Polynomial.derivative Real Real.semiring))
    d (@NLA.RA07.generatingPolynomial n lam)
def NLA.RA07.pairGap : {m : Nat} → (Fin m → Real) → Real :=
fun {m} μ =>
  ∑ a,
    ∑ b with @LT.lt (Fin m) (@instLTFin m) a b,
      @HMul.hMul Real Real Real (@instHMul Real Real.instMul)
        (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) (μ a) (μ b))
        (@HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid)))
          (@HSub.hSub Real Real Real (@instHSub Real Real.instSub) (μ a) (μ b))
          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
def NLA.RA07.ConvexityConjecture : Prop :=
∀ (n : Nat),
  @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))) n →
    ∀ (lam : Fin n → Real),
      (∀ (i : Fin n),
          @LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) (lam i)) →
        ∀ (j : Nat),
          @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) j →
            @LE.le Nat instLENat j
                (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) n
                  (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))) →
              @LE.le Real Real.instLE (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero))
                (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd)
                  (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
                    (@NLA.RA07.errorSequence n lam
                      (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) j
                        (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
                    (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                      (@OfNat.ofNat Real (nat_lit 2)
                        (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast NLA.RA07.ConvexityConjecture._proof_1))
                      (@NLA.RA07.errorSequence n lam j)))
                  (@NLA.RA07.errorSequence n lam
                    (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) j
                      (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
NLA.RA07.elementary_values {n : ℕ} (lam : Fin n → ℝ) (hlam : ∀ (i : Fin n), 0 < lam i) :
  NLA.RA07.elementarySymmetric lam 0 = 1 ∧
    (∀ (j : ℕ), n < j → NLA.RA07.elementarySymmetric lam j = 0) ∧ ∀ j ≤ n, 0 < NLA.RA07.elementarySymmetric lam j
NLA.RA07.generating_derivative_values {n : ℕ} (lam : Fin n → ℝ) (j : ℕ) :
  (NLA.RA07.generatingPolynomial lam).coeff j = NLA.RA07.elementarySymmetric lam j ∧
    Polynomial.eval 0 (NLA.RA07.iteratedGeneratingDerivative lam j) = ↑j.factorial * NLA.RA07.elementarySymmetric lam j
NLA.RA07.positive_derivative_factorization {n : ℕ} (lam : Fin n → ℝ) (hlam : ∀ (i : Fin n), 0 < lam i) (d : ℕ)
  (hd : d ≤ n) :
  0 < Polynomial.eval 0 (NLA.RA07.iteratedGeneratingDerivative lam d) ∧
    (NLA.RA07.iteratedGeneratingDerivative lam d).natDegree = n - d ∧
      ∃ μ,
        (∀ (a : Fin (n - d)), 0 < μ a) ∧
          NLA.RA07.iteratedGeneratingDerivative lam d =
            Polynomial.C (Polynomial.eval 0 (NLA.RA07.iteratedGeneratingDerivative lam d)) *
              NLA.RA07.generatingPolynomial μ
NLA.RA07.power_sum_certificate {m : ℕ} (μ : Fin m → ℝ) (hm : 2 ≤ m) (hμ : ∀ (a : Fin m), 0 < μ a) :
  0 < NLA.RA07.certificateDenominator μ ∧
    NLA.RA07.powerSum μ 1 * NLA.RA07.powerSum μ 3 - NLA.RA07.powerSum μ 2 ^ 2 = NLA.RA07.pairGap μ ∧
      0 ≤ NLA.RA07.pairGap μ
NLA.RA07.second_difference_certificate {n : ℕ} (hn : 3 ≤ n) (lam : Fin n → ℝ) (hlam : ∀ (i : Fin n), 0 < lam i) (j : ℕ)
  (hj : 2 ≤ j) (hjn : j ≤ n - 1) :
  ∃ μ,
    (∀ (a : Fin (n - (j - 1))), 0 < μ a) ∧
      NLA.RA07.iteratedGeneratingDerivative lam (j - 1) =
          Polynomial.C (Polynomial.eval 0 (NLA.RA07.iteratedGeneratingDerivative lam (j - 1))) *
            NLA.RA07.generatingPolynomial μ ∧
        0 < NLA.RA07.certificateDenominator μ ∧
          NLA.RA07.errorSequence lam (j - 1) - 2 * NLA.RA07.errorSequence lam j + NLA.RA07.errorSequence lam (j + 1) =
            2 * NLA.RA07.pairGap μ / NLA.RA07.certificateDenominator μ
NLA.RA07.errorSequence_convex : NLA.RA07.ConvexityConjecture
