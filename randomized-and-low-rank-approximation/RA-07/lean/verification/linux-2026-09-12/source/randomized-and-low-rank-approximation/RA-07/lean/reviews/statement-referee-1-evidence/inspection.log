Finset.mem_powersetCard.{u_1} {α : Type u_1} {n : ℕ} {s t : Finset α} : s ∈ Finset.powersetCard n t ↔ s ⊆ t ∧ s.card = n
Finset.esymm_map_val.{u_1, u_2} {R : Type u_1} [CommSemiring R] {σ : Type u_2} (f : σ → R) (s : Finset σ) (n : ℕ) :
  (Multiset.map f s.val).esymm n = ∑ t ∈ Finset.powersetCard n s, t.prod f
Polynomial.coeff_iterate_derivative.{u} {R : Type u} [Semiring R] {k : ℕ} (p : Polynomial R) (m : ℕ) :
  ((⇑Polynomial.derivative)^[k] p).coeff m = (m + k).descFactorial k • p.coeff (m + k)
Polynomial.natDegree_iterate_derivative.{u} {R : Type u} [Semiring R] (p : Polynomial R) (k : ℕ) :
  ((⇑Polynomial.derivative)^[k] p).natDegree ≤ p.natDegree - k
