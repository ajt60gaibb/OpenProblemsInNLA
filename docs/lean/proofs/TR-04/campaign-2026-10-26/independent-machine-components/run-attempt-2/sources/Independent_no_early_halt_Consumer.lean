noncomputable section
open scoped BigOperators Matrix
open NLA.Computation.SVDMachine
namespace NLA.Proofs.TR04
example {P : Program} (s : State P) (n : ℕ)
    (hn : ((ordinaryStep P)^[n] s).status = .running) (k : ℕ) (hk : k ≤ n) :
    ((ordinaryStep P)^[k] s).status = .running := @NLA.Proofs.TR04.ordinary_running_prefix P s n hn k hk
end NLA.Proofs.TR04
namespace NLA.Proofs.TR04
example {P : Program} (s : State P) (n : ℕ)
    (hn : ((ordinaryStep P)^[n] s).status = .running) (k : ℕ) (hk : k < n) :
    instructionIsHalt (P.code ((ordinaryStep P)^[k] s).label) = false := @NLA.Proofs.TR04.ordinary_nohalt_prefix_of_running P s n hn k hk
end NLA.Proofs.TR04
end
