import NLA.Proofs.TR14.ProductStabilizer
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Algebra.Algebra.Prod

/-! Actual unital algebras of idempotent blocks. The quotient by `1-e`
identifies linearly with the ambient multiplication image `eB`. Its identity
maps to `e`, and multiplication agrees with ambient multiplication. -/
set_option autoImplicit false
set_option leancert.trust "kernel"

namespace NLA.Proofs.TR14

noncomputable section
variable {K B D : Type*} [Field K] [CommRing B] [CommRing D]
  [Algebra K B] [Algebra K D]

/-- The genuine unital quotient corresponding to one idempotent block. -/
abbrev IdempotentCorner (e : B) := B ⧸ Ideal.span ({1 - e} : Set B)

/-- The actual quotient homomorphism; its codomain identity represents `e`. -/
def cornerProjection (e : B) : B →ₐ[K] IdempotentCorner e :=
  Ideal.Quotient.mkₐ K (Ideal.span ({1 - e} : Set B))

/-- Multiplication by an idempotent kills the entire ideal generated by `1-e`. -/
theorem cornerIdeal_le_mulLeft_ker (e : B) (he : e * e = e) :
    (Ideal.span ({1 - e} : Set B)).restrictScalars K ≤
      LinearMap.ker (LinearMap.mulLeft K e) := by
  intro x hx
  change e * x = 0
  change x ∈ Ideal.span ({1 - e} : Set B) at hx
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
  rw [← mul_assoc, mul_sub, mul_one, he, sub_self, zero_mul]

/-- The actual ambient inclusion of the quotient block, sending `[x]` to `e*x`. -/
def cornerInclusion (e : B) (he : e * e = e) : IdempotentCorner e →ₗ[K] B :=
  ((Ideal.span ({1 - e} : Set B)).restrictScalars K).liftQ
      (LinearMap.mulLeft K e) (cornerIdeal_le_mulLeft_ker e he) |>.comp
    (Submodule.Quotient.restrictScalarsEquiv K
      (Ideal.span ({1 - e} : Set B))).symm.toLinearMap

@[simp] theorem cornerInclusion_projection (e : B) (he : e * e = e) (x : B) :
    cornerInclusion (K := K) e he (cornerProjection (K := K) e x) = e * x := rfl

/-- An element killed by the multiplier is exactly zero in the block quotient. -/
theorem cornerProjection_eq_zero_iff (e : B) (he : e * e = e) (x : B) :
    cornerProjection (K := K) e x = 0 ↔ e * x = 0 := by
  constructor
  · intro hx
    have h := congrArg (cornerInclusion (K := K) e he) hx
    simpa only [cornerInclusion_projection, map_zero] using h
  · intro hx
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply Ideal.mem_span_singleton.mpr
    refine ⟨x, ?_⟩
    rw [sub_mul, one_mul, hx, sub_zero]

/-- The ambient block inclusion loses no quotient element. -/
theorem cornerInclusion_injective (e : B) (he : e * e = e) :
    Function.Injective (cornerInclusion (K := K) e he) := by
  apply LinearMap.ker_eq_bot.mp
  apply eq_bot_iff.mpr
  intro x hx
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective K (Ideal.span ({1 - e} : Set B)) x
  exact (cornerProjection_eq_zero_iff (K := K) e he a).mpr hx

/-- The quotient block identity maps to the actual ambient idempotent. -/
@[simp] theorem cornerInclusion_one (e : B) (he : e * e = e) :
    cornerInclusion (K := K) e he 1 = e := by
  simpa only [map_one, mul_one] using cornerInclusion_projection (K := K) e he 1

/-- The ambient inclusion preserves multiplication, with its own identity `e`. -/
theorem cornerInclusion_mul (e : B) (he : e * e = e)
    (x y : IdempotentCorner e) :
    cornerInclusion (K := K) e he (x * y) =
      cornerInclusion (K := K) e he x * cornerInclusion (K := K) e he y := by
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective K (Ideal.span ({1 - e} : Set B)) x
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mkₐ_surjective K (Ideal.span ({1 - e} : Set B)) y
  change e * (a * b) = (e * a) * (e * b)
  calc
    e * (a * b) = (e * e) * (a * b) := by rw [he]
    _ = (e * a) * (e * b) := by ring

/-- Exactly the actual multiplication image is obtained. -/
theorem cornerInclusion_range (e : B) (he : e * e = e) :
    LinearMap.range (cornerInclusion (K := K) e he) =
      LinearMap.range (LinearMap.mulLeft K e) := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective K (Ideal.span ({1 - e} : Set B)) y
    exact ⟨a, rfl⟩
  · rintro ⟨a, rfl⟩
    exact ⟨cornerProjection (K := K) e a, rfl⟩

/-- A genuine linear equivalence from the unital quotient to the actual
ambient multiplication block, rather than a supplied dimension equality. -/
def cornerEquivRange (e : B) (he : e * e = e) :
    IdempotentCorner e ≃ₗ[K] LinearMap.range (LinearMap.mulLeft K e) :=
  LinearEquiv.ofBijective
    ((cornerInclusion (K := K) e he).codRestrict _ (fun x => by
      rw [← cornerInclusion_range (K := K) e he]
      exact ⟨x, rfl⟩))
    ⟨fun x y hxy => cornerInclusion_injective (K := K) e he (congrArg Subtype.val hxy), by
      rintro ⟨y, a, rfl⟩
      exact ⟨cornerProjection (K := K) e a, Subtype.ext rfl⟩⟩

@[simp] theorem cornerEquivRange_projection (e : B) (he : e * e = e) (x : B) :
    (cornerEquivRange (K := K) e he (cornerProjection (K := K) e x) : B) = e * x := rfl

/-- The intrinsic dimension equals the actual ambient multiplication-image
 dimension, including a zero idempotent and its zero ring corner. -/
theorem corner_finrank (e : B) (he : e * e = e) :
    Module.finrank K (IdempotentCorner e) =
      Module.finrank K (LinearMap.range (LinearMap.mulLeft K e)) :=
  (cornerEquivRange (K := K) e he).finrank_eq

/-- Algebra homomorphisms induce the corresponding actual quotient block map. -/
def cornerMap (e : B) (f : B →ₐ[K] D) :
    IdempotentCorner e →ₐ[K] IdempotentCorner (f e) :=
  Ideal.Quotient.liftₐ (Ideal.span ({1 - e} : Set B))
    ((cornerProjection (K := K) (f e)).comp f) (by
      change Ideal.span ({1 - e} : Set B) ≤
        RingHom.ker (((cornerProjection (K := K) (f e)).comp f).toRingHom)
      apply Ideal.span_le.mpr
      rintro x rfl
      change cornerProjection (K := K) (f e) (f (1 - e)) = 0
      simp only [map_sub, map_one]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp)))

@[simp] theorem cornerMap_projection (e : B) (f : B →ₐ[K] D) (x : B) :
    cornerMap (K := K) e f (cornerProjection (K := K) e x) = cornerProjection (K := K) (f e) (f x) := rfl

#assert_trust kernel cornerIdeal_le_mulLeft_ker
#assert_trust kernel cornerInclusion
#assert_trust kernel cornerProjection_eq_zero_iff
#assert_trust kernel cornerInclusion_injective
#assert_trust kernel cornerInclusion_mul
#assert_trust kernel cornerInclusion_range
#assert_trust kernel cornerEquivRange
#assert_trust kernel corner_finrank
#assert_trust kernel cornerMap
#print axioms cornerEquivRange

end
end NLA.Proofs.TR14
