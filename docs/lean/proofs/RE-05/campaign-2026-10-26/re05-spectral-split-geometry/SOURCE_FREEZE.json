  "main_endpoint_types": {
    "complement_eq_mulVec": "\u2200 {n} (plan : LinearFamilyQuery.Plan n) x, complement plan x = residualProjection plan *\u1d65 x",
    "makePlan_complement_idempotent": "\u2200 {n q} (P : Basis n q) \u03be \u03c9 copy x, complement (makePlan P \u03be \u03c9 copy) (complement (makePlan P \u03be \u03c9 copy) x) = complement (makePlan P \u03be \u03c9 copy) x",
    "makePlan_residualLeverage_bound": "\u2200 {n q} (P : Basis n q) \u03be \u03c9 copy, (threshold q \u03be \u2022 I - residualProjection (makePlan P \u03be \u03c9 copy) * leverage P * residualProjection (makePlan P \u03be \u03c9 copy)).PosSemidef",
    "residualBasisBlock_gram": "\u2200 {n q} (P : Basis n q) plan, (\u2211 j, residualBasisBlock P plan j * (residualBasisBlock P plan j).transpose) = residualProjection plan * leverage P * residualProjection plan",
    "makePlan_basisGram_split": "\u2200 {n q} (P : Basis n q), Independent P \u2192 \u2200 \u03be \u03c9 copy, selectedBasisGram P (makePlan P \u03be \u03c9 copy) + residualBasisGram P (makePlan P \u03be \u03c9 copy) = I",
    "makePlan_residualBasis_norm_le_one": "\u2200 {n q} (P : Basis n q), Independent P \u2192 \u2200 \u03be \u03c9 copy j, LinearFamilyQuery.norm n (residualBasisBlock P (makePlan P \u03be \u03c9 copy) j) \u2264 1"
  },
